<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-8"><%= t('dashboard.title') || 'Dashboard' %></h1>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h3 class="text-base-content/70 text-sm uppercase"><%= t('dashboard.totalTasks') || 'Total Tasks' %></h3>
        <p class="text-3xl font-bold"><%= stats.totalTasks %></p>
      </div>
    </div>
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h3 class="text-base-content/70 text-sm uppercase"><%= t('dashboard.myTasks') || 'My Tasks' %></h3>
        <p class="text-3xl font-bold"><%= stats.myTasks %></p>
      </div>
    </div>
    <div class="card bg-base-100 shadow-xl">
      <div class="card-body">
        <h3 class="text-base-content/70 text-sm uppercase"><%= t('dashboard.completed') || 'Completed' %></h3>
        <p class="text-3xl font-bold"><%= stats.completedTasks %></p>
      </div>
    </div>
  </div>

  <div class="card bg-base-100 shadow-xl overflow-hidden">
    <div class="px-6 py-4 border-b border-base-300 flex justify-between items-center">
      <h2 class="text-xl font-semibold"><%= t('dashboard.recentTasks') || 'Recent Tasks' %></h2>
      <a href="/tasks" class="btn btn-sm btn-ghost"><%= t('dashboard.viewAll') || 'View All' %></a>
    </div>
    <div class="divide-y divide-base-300">
      <% recentTasks.forEach(task => { %>
        <div class="px-6 py-4 flex items-center justify-between hover:bg-base-200 transition-colors">
          <div>
            <a href="/tasks/<%= task.id %>" class="font-medium hover:underline"><%= task.title %></a>
            <p class="text-sm text-base-content/70">
              <%= t('tasks.statuses.' + task.status) %> - <%= task.assignee ? task.assignee.name : 'Unassigned' %>
            </p>
          </div>
          <span class="badge <%= task.priority === 'HIGH' ? 'badge-error' : (task.priority === 'MEDIUM' ? 'badge-warning' : 'badge-info') %>">
            <%= task.priority %>
          </span>
        </div>
      <% }) %>
      <% if (recentTasks.length === 0) { %>
        <div class="px-6 py-4 text-center text-base-content/70">No tasks found</div>
      <% } %>
    </div>
  </div>
</div>
