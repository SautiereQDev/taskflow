<div class="space-y-8">
  <!-- Dashboard Header -->
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold">Tableau de bord</h1>
      <p class="text-base-content/70 mt-1">Bienvenue, <%= user.name %></p>
    </div>
    <a href="/tasks/new" class="btn btn-primary gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      Nouvelle tâche
    </a>
  </div>

  <!-- Stats Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <%- include('../partials/ui/stat-card', {
      title: 'Total',
      value: dashboard.stats.total,
      icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2',
      color: 'primary'
    }) %>

    <%- include('../partials/ui/stat-card', {
      title: 'En cours',
      value: dashboard.stats.inProgress,
      icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
      color: 'warning'
    }) %>

    <%- include('../partials/ui/stat-card', {
      title: 'Terminées',
      value: dashboard.stats.done,
      icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
      color: 'success',
      description: dashboard.stats.completionRate + '% de complétion'
    }) %>

    <%- include('../partials/ui/stat-card', {
      title: 'En retard',
      value: dashboard.dueDates.overdue,
      icon: 'M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
      color: 'error'
    }) %>
  </div>

  <!-- Priority Breakdown -->
  <%- include('../partials/ui/surface', { variant: 'normal' }) %>
    <h2 class="text-xl font-bold mb-4">Répartition par priorité</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="stat">
        <div class="stat-title">Urgente</div>
        <div class="stat-value text-error text-3xl"><%= dashboard.priorityBreakdown.urgent %></div>
      </div>
      <div class="stat">
        <div class="stat-title">Haute</div>
        <div class="stat-value text-warning text-3xl"><%= dashboard.priorityBreakdown.high %></div>
      </div>
      <div class="stat">
        <div class="stat-title">Moyenne</div>
        <div class="stat-value text-info text-3xl"><%= dashboard.priorityBreakdown.medium %></div>
      </div>
      <div class="stat">
        <div class="stat-title">Basse</div>
        <div class="stat-value text-3xl"><%= dashboard.priorityBreakdown.low %></div>
      </div>
    </div>
  </div>

  <!-- Recent Tasks -->
  <%- include('../partials/ui/surface', { variant: 'normal' }) %>
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-xl font-bold">Tâches récentes</h2>
      <a href="/tasks" class="link link-primary">Voir tout</a>
    </div>
    
    <% if (dashboard.recentTasks.length > 0) { %>
      <div class="space-y-3">
        <% dashboard.recentTasks.forEach(task => { %>
          <div class="flex items-center justify-between p-4 bg-base-200 rounded-lg hover:bg-base-300 transition-colors">
            <div class="flex-1">
              <a href="/tasks/<%= task.id %>" class="font-semibold hover:link">
                <%= task.title %>
              </a>
              <div class="flex gap-2 mt-1">
                <%- include('../partials/ui/badge', {
                  text: task.status.label,
                  variant: task.status.color
                }) %>
                <%- include('../partials/ui/badge', {
                  text: task.priority.label,
                  variant: task.priority.color
                }) %>
              </div>
            </div>
            <% if (task.dueDate.formatted) { %>
              <div class="text-sm <%= task.dueDate.isOverdue ? 'text-error' : 'text-base-content/70' %>">
                <%= task.dueDate.formatted %>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center py-8 text-base-content/50">
        <p>Aucune tâche récente</p>
      </div>
    <% } %>
  </div>
</div>
