<!DOCTYPE html>
<html lang="fr" data-theme="taskflowLight">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title><%= title %> - TaskFlow</title>
 <link rel="stylesheet" href="/css/output.css">
</head>
<body class="min-h-screen bg-base-100">
 <div class="container mx-auto px-4 py-8">
 <!-- Header -->
 <div class="mb-8">
 <h1 class="text-4xl font-bold mb-2">🔍 System Diagnostic</h1>
 <p class="text-base-content/70">
 Comprehensive health check of all system components
 </p>
 <div class="mt-4 flex gap-4 items-center">
 <span class="badge badge-lg">Environment: <%= environment %></span>
 <span class="badge badge-lg badge-outline"><%= timestamp %></span>
 </div>
 </div>

 <!-- Overall Status -->
 <%
 const passedCount = checks.filter(c => c.status === 'pass').length;
 const failedCount = checks.filter(c => c.status === 'fail').length;
 const warnCount = checks.filter(c => c.status === 'warn').length;
 const allPassed = failedCount === 0;
 %>

 <div class="alert <%= allPassed ? 'alert-success' : 'alert-error' %> mb-8">
 <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
 <% if (allPassed) { %>
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
 <% } else { %>
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
 <% } %>
 </svg>
 <div>
 <h3 class="font-bold">
 <%= allPassed ? '✅ All Systems Operational' : '❌ System Issues Detected' %>
 </h3>
 <div class="text-sm">
 <%= passedCount %> passed · <%= warnCount %> warnings · <%= failedCount %> failed
 </div>
 </div>
 </div>

 <!-- Checks Summary -->
 <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
 <div class="stat bg-success text-success-content rounded-lg">
 <div class="stat-title text-success-content/70">Passed</div>
 <div class="stat-value"><%= passedCount %></div>
 </div>
 <div class="stat bg-warning text-warning-content rounded-lg">
 <div class="stat-title text-warning-content/70">Warnings</div>
 <div class="stat-value"><%= warnCount %></div>
 </div>
 <div class="stat bg-error text-error-content rounded-lg">
 <div class="stat-title text-error-content/70">Failed</div>
 <div class="stat-value"><%= failedCount %></div>
 </div>
 </div>

 <!-- Detailed Checks -->
 <div class="space-y-4">
 <h2 class="text-2xl font-bold mb-4">Detailed Checks</h2>

 <% checks.forEach(check => { %>
 <div class="card bg-base-200 shadow-xl">
 <div class="card-body">
 <div class="flex items-start justify-between">
 <div class="flex-1">
 <h3 class="card-title flex items-center gap-2">
 <% if (check.status === 'pass') { %>
 <span class="badge badge-success">✓ PASS</span>
 <% } else if (check.status === 'warn') { %>
 <span class="badge badge-warning">⚠ WARN</span>
 <% } else { %>
 <span class="badge badge-error">✗ FAIL</span>
 <% } %>
 <%= check.name %>
 </h3>
 <p class="mt-2 text-base-content/70"><%= check.message %></p>

 <% if (check.details) { %>
 <div class="mt-4">
 <div class="collapse collapse-arrow bg-base-100">
 <input type="checkbox" />
 <div class="collapse-title text-sm font-medium">
 View Details
 </div>
 <div class="collapse-content">
 <pre class="text-xs overflow-x-auto p-4 bg-base-300 rounded"><%= JSON.stringify(check.details, null, 2) %></pre>
 </div>
 </div>
 </div>
 <% } %>
 </div>
 </div>
 </div>
 </div>
 <% }); %>
 </div>

 <!-- Actions -->
 <div class="mt-8 flex gap-4">
 <a href="/" class="btn btn-primary">Go to Application</a>
 <a href="/diagnostic" class="btn btn-outline">Refresh Diagnostic</a>
 <a href="/diagnostic/json" class="btn btn-ghost" target="_blank">View JSON</a>
 </div>

 <!-- Quick Fixes -->
 <% if (failedCount > 0 || warnCount > 0) { %>
 <div class="mt-8 card bg-base-200">
 <div class="card-body">
 <h3 class="card-title">🔧 Quick Fixes</h3>
 <ul class="list-disc list-inside space-y-2 text-sm">
 <% checks.forEach(check => { %>
 <% if ((check.status === 'fail' || check.status === 'warn') && check.details && check.details.fix) { %>
 <li><strong><%= check.name %>:</strong> <%= check.details.fix %></li>
 <% } %>
 <% }); %>
 </ul>
 </div>
 </div>
 <% } %>
 </div>
</body>
</html>
