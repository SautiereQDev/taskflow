<%
  const currentTask = task || null;
  const isEdit = mode === 'edit' || (currentTask && currentTask.id);
  const heading = isEdit ? 'Modifier la tâche' : 'Nouvelle tâche';
  const backHref = isEdit && currentTask ? `/tasks/${currentTask.id}` : '/tasks';
  const action = isEdit && currentTask ? `/tasks/${currentTask.id}` : '/tasks';
  const method = isEdit ? 'POST' : 'POST'; // Using POST for both, handled by controller logic or hidden field if needed, but here we use standard POST
%>

<div class="max-w-2xl mx-auto py-8">
  <div class="flex items-center justify-between mb-6">
    <a href="<%= backHref %>" class="btn btn-ghost btn-sm gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
      Retour
    </a>
  </div>

  <div class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <h2 class="card-title text-2xl mb-6"><%= heading %></h2>

      <form action="<%= action %>" method="POST" class="space-y-4">
        <!-- CSRF Token -->
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-control w-full">
          <label class="label"><span class="label-text">Titre</span></label>
          <input type="text" name="title" value="<%= currentTask?.title || '' %>" required minlength="3" maxlength="200" class="input input-bordered w-full" />
        </div>

        <div class="form-control w-full">
          <label class="label"><span class="label-text">Description</span></label>
          <textarea name="description" rows="5" maxlength="2000" class="textarea textarea-bordered h-32"><%= currentTask?.description || '' %></textarea>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="form-control w-full">
            <label class="label"><span class="label-text">Statut</span></label>
            <select name="status" class="select select-bordered w-full">
              <% ['TODO', 'IN_PROGRESS', 'DONE'].forEach(status => { %>
                <option value="<%= status %>" <%= currentTask?.status === status ? 'selected' : '' %>><%= status %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-control w-full">
            <label class="label"><span class="label-text">Priorité</span></label>
            <select name="priority" class="select select-bordered w-full">
              <% ['LOW', 'MEDIUM', 'HIGH'].forEach(priority => { %>
                <option value="<%= priority %>" <%= currentTask?.priority === priority ? 'selected' : '' %>><%= priority %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="form-control w-full">
            <label class="label"><span class="label-text">Assignée à</span></label>
            <select name="assigneeId" class="select select-bordered w-full">
              <option value="">Non assignée</option>
              <% users.forEach(u => { %>
                <option value="<%= u.id %>" <%= currentTask?.assigneeId === u.id ? 'selected' : '' %>><%= u.name %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-control w-full">
            <label class="label"><span class="label-text">Date d'échéance</span></label>
            <input type="datetime-local" name="dueDate" value="<%= currentTask?.dueDate ? new Date(currentTask.dueDate).toISOString().slice(0, 16) : '' %>" class="input input-bordered w-full" />
          </div>
        </div>

        <div class="card-actions justify-end mt-6">
          <a href="<%= backHref %>" class="btn btn-ghost">Annuler</a>
          <button type="submit" class="btn btn-primary"><%= isEdit ? 'Enregistrer' : 'Créer' %></button>
        </div>
      </form>

      <% if (isEdit) { %>
        <div class="divider">DANGER ZONE</div>
        <form action="/tasks/<%= currentTask.id %>/delete" method="POST" onsubmit="return confirm('Êtes-vous sûr ?');">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-error btn-outline w-full">Supprimer la tâche</button>
        </form>
      <% } %>
    </div>
  </div>
</div>
