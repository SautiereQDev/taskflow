<!-- Task Edit Page -->

<div class="max-w-5xl mx-auto tf-section">
 <!-- Page Header -->
 <div class="flex flex-col md:flex-row md:items-center md:justify-between tf-gap tf-group">
 <div>
 <h1 class="text-3xl md:text-4xl font-bold tf-text-primary mb-2">
 <%= __('tasks.edit.title') %>
 </h1>
 <p class="tf-text-secondary text-base md:text-lg">
 <%= __('tasks.edit.subtitle') %>
 </p>
 </div>
 <a
 href="/tasks/<%= task.id %>"
 class="btn btn-ghost btn-sm md:btn-md"
 >
 <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
 </svg>
 <%= __('common.cancel') %>
 </a>
 </div>

 <!-- Edit Form Card -->
 <div class="bg-base-200 border border-base-content/10 shadow-md tf-card-padding rounded-box"
 <form
 hx-patch="/tasks/<%= task.id %>"
 hx-target="body"
 hx-swap="outerHTML"
 hx-indicator="#submit-indicator"
 x-data="{
 isSubmitting: false,
 title: '<%= task.title.replace(/'/g, "\\'") %>',
 description: '<%= task.description ? task.description.replace(/'/g, "\\'").replace(/\n/g, '\\n') : '' %>'
 }"
 @htmx:before-request="isSubmitting = true"
 @htmx:after-request="isSubmitting = false"
 class="tf-section"
 >
 <!-- Title -->
 <%- include('../../partials/ui/forms/input', {
 label: __('tasks.form.title'),
 name: 'title',
 type: 'text',
 value: task.title,
 placeholder: __('tasks.form.titlePlaceholder'),
 helpText: __('tasks.form.titleHint'),
 required: true,
 minlength: 3,
 maxlength: 200,
 showCounter: true,
 counterModel: 'title',
 xModel: 'title'
 }) %>

 <!-- Description -->
 <div class="form-control">
 <label class="label" for="description">
 <span class="label-text font-semibold tf-text-primary">
 <%= __('tasks.form.description') %>
 </span>
 <span class="label-text-alt tf-text-muted" x-text="`${description.length}/2000`">0/2000</span>
 </label>
 <textarea
 id="description"
 name="description"
 x-model="description"
 class="textarea textarea-bordered h-32 w-full"
 placeholder="<%= __('tasks.form.descriptionPlaceholder') %>"
 maxlength="2000"
 ><%= task.description || '' %></textarea>
 <label class="label">
 <span class="label-text-alt tf-text-muted">
 <%= __('tasks.form.descriptionHint') %>
 </span>
 </label>
 </div>

 <!-- Status & Priority Row -->
 <div class="grid grid-cols-1 md:grid-cols-2 tf-gap">
 <!-- Status -->
 <div class="form-control">
 <label class="label" for="status">
 <span class="label-text font-semibold tf-text-primary">
 <%= __('tasks.form.status') %> <span class="text-error">*</span>
 </span>
 </label>
 <select
 id="status"
 name="status"
 class="select select-bordered w-full tf-input-padding"
 required
 >
 <option value="TODO" <%= task.status === 'TODO' ? 'selected' : '' %>>
 📝 <%= __('tasks.status.todo') %>
 </option>
 <option value="IN_PROGRESS" <%= task.status === 'IN_PROGRESS' ? 'selected' : '' %>>
 🚀 <%= __('tasks.status.inProgress') %>
 </option>
 <option value="DONE" <%= task.status === 'DONE' ? 'selected' : '' %>>
 ✅ <%= __('tasks.status.done') %>
 </option>
 <option value="CANCELLED" <%= task.status === 'CANCELLED' ? 'selected' : '' %>>
 ❌ <%= __('tasks.status.cancelled') %>
 </option>
 </select>
 </div>

 <!-- Priority -->
 <div class="form-control">
 <label class="label" for="priority">
 <span class="label-text font-semibold tf-text-primary">
 <%= __('tasks.form.priority') %>
 </span>
 </label>
 <select
 id="priority"
 name="priority"
 class="select select-bordered w-full tf-input-padding"
 >
 <option value="LOW" <%= task.priority === 'LOW' ? 'selected' : '' %>>
 🟢 <%= __('tasks.priority.low') %>
 </option>
 <option value="MEDIUM" <%= task.priority === 'MEDIUM' ? 'selected' : '' %>>
 🟡 <%= __('tasks.priority.medium') %>
 </option>
 <option value="HIGH" <%= task.priority === 'HIGH' ? 'selected' : '' %>>
 🟠 <%= __('tasks.priority.high') %>
 </option>
 <option value="URGENT" <%= task.priority === 'URGENT' ? 'selected' : '' %>>
 🔴 <%= __('tasks.priority.urgent') %>
 </option>
 </select>
 </div>
 </div>

 <!-- Assignee & Due Date Row -->
 <div class="grid grid-cols-1 md:grid-cols-2 tf-gap">
 <!-- Assignee -->
 <div class="form-control">
 <label class="label" for="assigneeId">
 <span class="label-text font-semibold tf-text-primary">
 <%= __('tasks.form.assignee') %>
 </span>
 </label>
 <select
 id="assigneeId"
 name="assigneeId"
 class="select select-bordered w-full tf-input-padding"
 >
 <option value="">
 <%= __('tasks.form.noAssignee') %>
 </option>
 <% users.forEach(u => { %>
 <option
 value="<%= u.id %>"
 <%= task.assigneeId === u.id ? 'selected' : '' %>
 >
 <%= u.firstName %> <%= u.lastName %> (<%= u.email %>)
 </option>
 <% }); %>
 </select>
 <label class="label">
 <span class="label-text-alt tf-text-muted">
 <%= __('tasks.form.assigneeHint') %>
 </span>
 </label>
 </div>

 <!-- Due Date -->
 <%- include('../../partials/ui/forms/input', {
 label: __('tasks.form.dueDate'),
 name: 'dueDate',
 type: 'datetime-local',
 value: task.dueDate || '',
 helpText: __('tasks.form.dueDateHint')
 }) %>
 </div>

 <!-- Form Actions -->
 <div class="btn-group tf-group border-t border-base-content/10">
 <button type="submit" class="btn btn-primary" :disabled="isSubmitting">
 <span id="submit-indicator" class="loading loading-spinner loading-sm htmx-indicator"></span>
 <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
 </svg>
 <%= __('common.save') %>
 </button>

 <a href="/tasks/<%= task.id %>" class="btn btn-ghost">
 <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
 </svg>
 <%= __('common.cancel') %>
 </a>
 </div>

 <!-- Delete Action (Separate) -->
 <div class="tf-group border-t border-base-content/10">
 <button type="button" class="btn btn-outline btn-error btn-sm"
 onclick="if(confirm('<%= __('tasks.edit.deleteConfirm') %>')) {
 htmx.ajax('DELETE', '/tasks/<%= task.id %>', {
 target: 'body',
 swap: 'outerHTML'
 });
 }"
 >
 <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
 </svg>
 <%= __('common.delete') %>
 </button>
 </div>
 </form>
 </div>

 <!-- Info Card -->
 <div class="alert alert-info bg-base-100 border border-base-content/10">
 <svg class="w-6 h-6 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
 </svg>
 <div class="flex-1">
 <h3 class="font-bold"><%= __('common.info') %></h3>
 <div class="text-sm tf-text-secondary mt-1">
 <%= __('tasks.edit.info') %>
 </div>
 </div>
 </div>
 </div>
</div>
