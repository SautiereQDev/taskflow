<div class="container mx-auto px-4 py-8 max-w-4xl">
  <!-- Header -->
  <div class="mb-8">
    <a href="/tasks" class="btn btn-ghost btn-sm gap-2 mb-4 pl-0 hover:bg-transparent hover:text-primary transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
      Retour à la liste
    </a>
    
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
      <div>
        <h1 class="text-4xl font-bold text-base-content mb-3"><%= task.title %></h1>
        <div class="flex flex-wrap gap-2 items-center">
          <div class="badge gap-1 py-3 px-3 font-medium
            <%= task.status === 'DONE' ? 'badge-success text-success-content' : (task.status === 'IN_PROGRESS' ? 'badge-warning text-warning-content' : 'badge-ghost') %>">
            <% if (task.status === 'DONE') { %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <% } else if (task.status === 'IN_PROGRESS') { %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <% } %>
            <%= task.status === 'TODO' ? 'À faire' : task.status === 'IN_PROGRESS' ? 'En cours' : 'Terminé' %>
          </div>
          
          <div class="badge badge-outline gap-1 py-3 px-3
            <%= task.priority === 'HIGH' ? 'badge-error' : (task.priority === 'MEDIUM' ? 'badge-warning' : 'badge-info') %>">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            <%= task.priority === 'LOW' ? 'Priorité Basse' : task.priority === 'MEDIUM' ? 'Priorité Moyenne' : 'Priorité Haute' %>
          </div>

          <% if (task.dueDate) { %>
            <div class="badge badge-ghost gap-1 py-3 px-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3M5 11h14M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              Échéance : <%= new Date(task.dueDate).toLocaleDateString() %>
            </div>
          <% } %>
        </div>
      </div>

      <div class="flex gap-2">
        <a href="/tasks/<%= task.id %>/edit" class="btn btn-primary gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
          Modifier
        </a>
        <% if (typeof user !== 'undefined' && user.role === 'ADMIN') { %>
          <button class="btn btn-square btn-ghost text-error" 
                  hx-post="/tasks/<%= task.id %>/delete" 
                  hx-confirm="<%= t('common.confirmDelete') || 'Êtes-vous sûr ?' %>"
                  hx-target="body">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
          </button>
        <% } %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-8">
      <div class="card bg-base-100 shadow-xl border border-base-200">
        <div class="card-body">
          <h2 class="card-title text-lg opacity-70 mb-4 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" /></svg>
            Description
          </h2>
          <div class="prose max-w-none">
            <% if (task.description) { %>
              <p class="whitespace-pre-wrap text-base leading-relaxed"><%= task.description %></p>
            <% } else { %>
              <p class="italic opacity-50 text-center py-8">Aucune description fournie pour cette tâche.</p>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Assignee Card -->
      <div class="card bg-base-100 shadow-lg border border-base-200">
        <div class="card-body p-6">
          <h3 class="text-xs font-bold uppercase opacity-50 mb-4 tracking-wider">Assignée à</h3>
          <% if (task.assignee) { %>
            <div class="flex items-center gap-4">
              <div class="avatar placeholder">
                <div class="bg-primary text-primary-content rounded-full w-12 h-12 text-lg shadow-sm">
                  <span><%= task.assignee.name.substring(0, 2).toUpperCase() %></span>
                </div>
              </div>
              <div class="overflow-hidden">
                <div class="font-bold text-lg truncate"><%= task.assignee.name %></div>
                <div class="text-xs opacity-60 truncate"><%= task.assignee.email %></div>
              </div>
            </div>
          <% } else { %>
            <div class="flex items-center gap-3 opacity-60">
              <div class="avatar placeholder">
                <div class="bg-base-300 rounded-full w-10 h-10">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 m-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                </div>
              </div>
              <span class="italic">Non assignée</span>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Creator Card -->
      <div class="card bg-base-100 shadow-lg border border-base-200">
        <div class="card-body p-6">
          <h3 class="text-xs font-bold uppercase opacity-50 mb-4 tracking-wider">Créée par</h3>
          <div class="flex items-center gap-4">
            <div class="avatar placeholder">
              <div class="bg-neutral text-neutral-content rounded-full w-10 h-10 shadow-sm">
                <span><%= task.creator.name.substring(0, 2).toUpperCase() %></span>
              </div>
            </div>
            <div class="overflow-hidden">
              <div class="font-bold truncate"><%= task.creator.name %></div>
              <div class="text-xs opacity-60 truncate">Le <%= new Date(task.createdAt).toLocaleDateString() %></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Meta Info -->
      <div class="text-xs text-center opacity-40">
        <p>Dernière modification : <%= new Date(task.updatedAt).toLocaleString() %></p>
        <p class="mt-1">ID: <%= task.id %></p>
      </div>
    </div>
  </div>
</div>
