<div class="container mx-auto px-4 py-8" id="tasks-container">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold"><%= t('tasks.title') || 'Tasks' %></h1>
    <a href="/tasks/new" class="btn btn-primary">
      <%= t('tasks.new') || 'New Task' %>
    </a>
  </div>

  <!-- Filters -->
  <div class="card bg-base-100 shadow-xl mb-6">
    <div class="card-body p-4">
      <form action="/tasks" method="GET" class="grid grid-cols-1 md:grid-cols-4 gap-4" hx-get="/tasks" hx-target="#tasks-container" hx-swap="outerHTML" hx-push-url="true" hx-trigger="submit, change, keyup delay:500ms from:input">
        <div class="form-control w-full">
          <label class="label">
            <span class="label-text"><%= t('common.search') || 'Search' %></span>
          </label>
          <input type="text" name="search" placeholder="<%= t('common.search') %>..." value="<%= filters.search || '' %>" class="input input-bordered w-full">
        </div>
        <div class="form-control w-full">
          <label class="label">
            <span class="label-text"><%= t('tasks.status') || 'Status' %></span>
          </label>
          <select name="status" class="select select-bordered w-full">
            <option value=""><%= t('tasks.allTasks') %></option>
            <option value="TODO" <%= filters.status === 'TODO' ? 'selected' : '' %>><%= t('tasks.statuses.TODO') %></option>
            <option value="IN_PROGRESS" <%= filters.status === 'IN_PROGRESS' ? 'selected' : '' %>><%= t('tasks.statuses.IN_PROGRESS') %></option>
            <option value="DONE" <%= filters.status === 'DONE' ? 'selected' : '' %>><%= t('tasks.statuses.DONE') %></option>
          </select>
        </div>
        <div class="form-control w-full">
          <label class="label">
            <span class="label-text"><%= t('tasks.assignee') || 'Assignee' %></span>
          </label>
          <select name="assigneeId" class="select select-bordered w-full">
            <option value=""><%= t('tasks.allAssignees') %></option>
            <% users.forEach(u => { %>
              <option value="<%= u.id %>" <%= filters.assigneeId === u.id ? 'selected' : '' %>><%= u.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-control w-full">
          <label class="label invisible">
            <span class="label-text"><%= t('common.reset') %></span>
          </label>
          <a href="/tasks" class="btn btn-secondary w-full" hx-get="/tasks" hx-target="#tasks-container" hx-swap="outerHTML" hx-push-url="true">
            <%= t('common.reset') || 'Reset' %>
          </a>
        </div>
      </form>
    </div>
  </div>

  <!-- List -->
  <div class="card bg-base-100 shadow-xl overflow-hidden">
    <div class="overflow-x-auto">
      <table class="table w-full">
        <thead>
          <tr>
            <th><%= t('tasks.form.title', 'Title') %></th>
            <th><%= t('tasks.form.status', 'Status') %></th>
            <th><%= t('tasks.form.priority', 'Priority') %></th>
            <th><%= t('tasks.assignee', 'Assignee') %></th>
            <th class="text-right"><%= t('common.actions', 'Actions') %></th>
          </tr>
        </thead>
        <tbody>
          <% tasks.forEach(task => { %>
            <tr class="hover">
              <td>
                <a href="/tasks/<%= task.id %>" class="link link-primary no-underline hover:underline font-bold"><%= task.title %></a>
              </td>
              <td>
                <span class="badge
                  <%= task.status === 'DONE' ? 'badge-success' : (task.status === 'IN_PROGRESS' ? 'badge-warning' : 'badge-ghost') %>">
                  <%= t('tasks.statuses.' + task.status) %>
                </span>
              </td>
              <td class="text-base-content/70"><%= task.priority %></td>
              <td class="text-base-content/70"><%= task.assignee ? task.assignee.name : '-' %></td>
              <td class="text-right">
                <a href="/tasks/<%= task.id %>/edit" class="btn btn-primary btn-xs"><%= t('common.edit') %></a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Pagination -->
  <div class="mt-6 flex justify-center">
    <div class="join">
      <% if (pagination.page > 1) { %>
        <a href="/tasks?page=<%= pagination.page - 1 %>" class="join-item btn"><%= t('common.previous') %></a>
      <% } %>
      <button class="join-item btn btn-disabled"><%= t('a11y.pageOf', { current: pagination.page, total: pagination.totalPages }) %></button>
      <% if (pagination.page < pagination.totalPages) { %>
        <a href="/tasks?page=<%= pagination.page + 1 %>" class="join-item btn"><%= t('common.next') %></a>
      <% } %>
    </div>
  </div>
</div>
