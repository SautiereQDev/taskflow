<div class="tf-container py-10">
  <div class="text-center">
    <h1 class="text-6xl font-bold text-error">403</h1>
    <p class="mt-4 text-lg tf-text-secondary">
      <%= t('errors.forbidden') || 'Forbidden' %>
    </p>
    <p class="mt-2 tf-text-muted">
      <%= error?.message || 'You do not have permission to access this resource.' %>
    </p>
    <div class="mt-8">
      <a href="/" class="btn btn-primary">
        <i class="fas fa-home mr-2"></i>
        <%= t('nav.dashboard') || 'Dashboard' %>
      </a>
    </div>
    <% if (error?.context && process.env.NODE_ENV !== 'production') { %>
      <div class="mt-6 text-left p-4 bg-base-100 rounded-lg border border-base-content/10">
        <h3 class="font-bold">Error Details:</h3>
        <pre class="text-xs whitespace-pre-wrap"><%= JSON.stringify(error.context, null, 2) %></pre>
      </div>
    <% } %>
  </div>
</div>
