<div class="container mx-auto px-4 py-12 max-w-5xl">
  <!-- Header -->
  <div class="text-center mb-12">
    <h1 class="text-4xl font-bold tf-text-primary mb-4"><%= __('changelog.title') %></h1>
    <p class="text-xl tf-text-muted"><%= __('changelog.subtitle') %></p>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-base-200 border border-base-content/10 shadow-md rounded-xl p-4 text-center">
      <div class="text-3xl font-bold text-primary"><%= totalCommits %></div>
      <div class="text-sm tf-text-muted"><%= __('changelog.stats.totalCommits') %></div>
    </div>
    <div class="bg-base-200 border border-base-content/10 shadow-md rounded-xl p-4 text-center">
      <div class="text-3xl font-bold text-success"><%= commitTypes.feat || 0 %></div>
      <div class="text-sm tf-text-muted"><%= __('changelog.stats.features') %></div>
    </div>
    <div class="bg-base-200 border border-base-content/10 shadow-md rounded-xl p-4 text-center">
      <div class="text-3xl font-bold text-error"><%= commitTypes.fix || 0 %></div>
      <div class="text-sm tf-text-muted"><%= __('changelog.stats.fixes') %></div>
    </div>
    <div class="bg-base-200 border border-base-content/10 shadow-md rounded-xl p-4 text-center">
      <div class="text-3xl font-bold text-info"><%= versions.length %></div>
      <div class="text-sm tf-text-muted">Versions</div>
    </div>
  </div>

  <!-- Versions -->
  <div class="space-y-8">
    <% for (const version of versions) { %>
    <div class="bg-base-200 border border-base-content/10 shadow-md rounded-2xl p-6">
      <!-- Version Header -->
      <div class="flex items-center justify-between mb-6 pb-4 border-b border-base-content/10">
        <div>
          <h2 class="text-3xl font-bold tf-text-primary">v<%= version.version %></h2>
          <% if (version.date) { %>
          <p class="text-sm tf-text-muted mt-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <%= version.date %>
          </p>
          <% } %>
        </div>
        <%
        let versionTotal = 0;
        for (const type in version.sections) {
          versionTotal += version.sections[type].length;
        }
        %>
        <span class="badge badge-lg badge-primary"><%= versionTotal %> commits</span>
      </div>

      <!-- Sections by Type -->
      <div class="space-y-6">
        <%
        // Sort types: feat, fix, then others
        const sortOrder = ['feat', 'fix', 'docs', 'style', 'refactor', 'perf', 'test', 'build', 'ci', 'chore', 'revert', 'other'];
        const sortedTypes = Object.keys(version.sections).sort((a, b) => {
          const indexA = sortOrder.indexOf(a);
          const indexB = sortOrder.indexOf(b);
          return (indexA === -1 ? 999 : indexA) - (indexB === -1 ? 999 : indexB);
        });

        for (const type of sortedTypes) {
          const typeCommits = version.sections[type];
          if (!typeCommits || typeCommits.length === 0) continue;
          const typeInfo = typeLabels[type];
        %>
        <div>
          <!-- Type Header -->
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl"><%= typeInfo.icon %></span>
            <h3 class="text-xl font-bold tf-text-primary"><%= typeInfo.label %></h3>
            <span class="badge <%= typeInfo.color %> badge-sm"><%= typeCommits.length %></span>
          </div>

          <!-- Commits List -->
          <ul class="space-y-2 ml-11">
            <% for (const commit of typeCommits) { %>
            <li class="flex items-start gap-2">
              <span class="text-base-content/50 select-none">•</span>
              <div class="flex-1 min-w-0">
                <% if (commit.scope) { %>
                <span class="badge badge-xs badge-outline mr-2"><%= commit.scope %></span>
                <% } %>
                <span class="tf-text-secondary"><%= commit.description %></span>
                <% if (commit.hash) { %>
                <code class="text-xs font-mono tf-text-muted ml-2">(<%= commit.hash %>)</code>
                <% } %>
              </div>
            </li>
            <% } %>
          </ul>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>
  </div>

  <!-- Empty State -->
  <% if (versions.length === 0) { %>
  <div class="bg-base-200 border border-base-content/10 shadow-md rounded-2xl p-12 text-center">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto tf-text-muted mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
    </svg>
    <h2 class="text-2xl font-bold tf-text-primary mb-2"><%= __('changelog.empty.title') %></h2>
    <p class="tf-text-muted"><%= __('changelog.empty.description') %></p>
  </div>
  <% } %>
</div>
