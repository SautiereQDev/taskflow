<div class="min-h-[calc(100vh-20rem)] flex items-center justify-center">
 <div class="w-full max-w-md">
 <div class="bg-base-300 border border-base-content/10 shadow-lg tf-card-padding rounded-xl">
 <div class="text-center tf-group">
 <h1 class="text-3xl font-bold mb-2">Connexion</h1>
 <p class="text-base-content/70">Connectez-vous à votre compte</p>
 </div>

 <form method="POST" action="/auth/login" class="tf-group">
 <!-- CSRF Token -->
 <input type="hidden" name="_csrf" value="<%= csrfToken %>">
 
 <!-- General Error Message -->
 <% if (typeof errors !== 'undefined' && errors.general) { %>
 <div class="alert alert-error mb-4" role="alert">
 <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
 </svg>
 <span><%= errors.general %></span>
 </div>
 <% } %>

 <!-- Email Field -->
 <div class="form-control w-full">
 <label class="label">
 <span class="label-text font-semibold">
 Email
 <span class="text-error">*</span>
 </span>
 </label>
 <input
 type="email"
 name="email"
 id="email"
 value="<%= typeof formData !== 'undefined' ? formData.email : '' %>"
 placeholder="nom@example.com"
 class="input input-bordered w-full tf-input-padding <%= typeof errors !== 'undefined' && errors.email ? 'input-error' : '' %>"
 required
 />
 <% if (typeof errors !== 'undefined' && errors.email) { %>
 <label class="label">
 <span class="label-text-alt text-error"><%= errors.email %></span>
 </label>
 <% } %>
 </div>

 <!-- Password Field -->
 <div class="form-control w-full">
 <label class="label">
 <span class="label-text font-semibold">
 Mot de passe
 <span class="text-error">*</span>
 </span>
 </label>
 <input
 type="password"
 name="password"
 id="password"
 placeholder="••••••••"
 class="input input-bordered w-full tf-input-padding <%= typeof errors !== 'undefined' && errors.password ? 'input-error' : '' %>"
 required
 />
 <% if (typeof errors !== 'undefined' && errors.password) { %>
 <label class="label">
 <span class="label-text-alt text-error"><%= errors.password %></span>
 </label>
 <% } %>
 </div>

 <div class="flex items-center justify-between">
 <label class="label cursor-pointer tf-gap-sm">
 <input type="checkbox" name="rememberMe" class="checkbox checkbox-primary" />
 <span class="label-text">Se souvenir de moi</span>
 </label>
 </div>

 <button type="submit" class="btn btn-primary w-full">
 Se connecter
 </button>
 </form>

 <div class="divider">OU</div>

 <div class="text-center">
 <p class="text-sm">
 Pas encore de compte ?
 <a href="/auth/register" class="link link-primary">S'inscrire</a>
 </p>
 </div>
 </div>
 </div>
</div>
