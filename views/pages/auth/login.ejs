<div class="min-h-[calc(100vh-20rem)] flex items-center justify-center">
  <div class="w-full max-w-md">
    <%- include('../../partials/ui/surface', { variant: 'heavy', padding: true }) %>
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold mb-2">Connexion</h1>
        <p class="text-base-content/70">Connectez-vous à votre compte</p>
      </div>

      <form method="POST" action="/auth/login" class="space-y-4">
        <%- include('../../partials/ui/forms/field', {
          label: 'Email',
          name: 'email',
          type: 'email',
          required: true,
          placeholder: 'nom@example.com',
          error: typeof errors !== 'undefined' ? errors.email : '',
          value: typeof formData !== 'undefined' ? formData.email : ''
        }) %>

        <%- include('../../partials/ui/forms/field', {
          label: 'Mot de passe',
          name: 'password',
          type: 'password',
          required: true,
          placeholder: '••••••••',
          error: typeof errors !== 'undefined' ? errors.password : ''
        }) %>

        <div class="flex items-center justify-between">
          <label class="label cursor-pointer gap-2">
            <input type="checkbox" name="rememberMe" class="checkbox checkbox-primary checkbox-sm" />
            <span class="label-text">Se souvenir de moi</span>
          </label>
          <a href="/auth/forgot-password" class="link link-primary text-sm">Mot de passe oublié ?</a>
        </div>

        <button type="submit" class="btn btn-primary w-full">
          Se connecter
        </button>
      </form>

      <div class="divider">OU</div>

      <div class="text-center">
        <p class="text-sm">
          Pas encore de compte ?
          <a href="/auth/register" class="link link-primary">S'inscrire</a>
        </p>
      </div>
    </div>
  </div>
</div>
