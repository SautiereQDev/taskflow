<div class="min-h-[calc(100vh-20rem)] flex items-center justify-center py-8">
 <div class="w-full max-w-md">
 <div class="bg-base-300 border border-base-content/10 shadow-lg tf-card-padding rounded-xl">
 <div class="text-center tf-group">
 <h1 class="text-3xl font-bold mb-2">Créer un compte</h1>
 <p class="text-base-content/70">Rejoignez TaskFlow aujourd'hui</p>
 </div>

 <form method="POST" action="/auth/register" class="tf-group">
 <!-- CSRF Token -->
 <input type="hidden" name="_csrf" value="<%= csrfToken %>">

 <!-- Name Field -->
 <%- include('../../partials/ui/forms/input', {
 label: 'Nom complet',
 name: 'name',
 type: 'text',
 value: typeof formData !== 'undefined' ? formData.name : '',
 placeholder: 'Jean Dupont',
 required: true,
 error: typeof errors !== 'undefined' ? errors.name : ''
 }) %>

 <!-- Email Field -->
 <%- include('../../partials/ui/forms/input', {
 label: 'Email',
 name: 'email',
 type: 'email',
 value: typeof formData !== 'undefined' ? formData.email : '',
 placeholder: 'nom@example.com',
 required: true,
 autocomplete: 'email',
 error: typeof errors !== 'undefined' ? errors.email : ''
 }) %>

 <!-- Password Field -->
 <%- include('../../partials/ui/forms/input', {
 label: 'Mot de passe',
 name: 'password',
 type: 'password',
 placeholder: '••••••••',
 required: true,
 autocomplete: 'new-password',
 helpText: typeof errors !== 'undefined' && errors.password ? '' : 'Minimum 8 caractères',
 error: typeof errors !== 'undefined' ? errors.password : ''
 }) %>

 <!-- Confirm Password Field -->
 <%- include('../../partials/ui/forms/input', {
 label: 'Confirmer le mot de passe',
 name: 'confirmPassword',
 type: 'password',
 placeholder: '••••••••',
 required: true,
 autocomplete: 'new-password',
 error: typeof errors !== 'undefined' ? errors.confirmPassword : ''
 }) %>

 <%- include('../../partials/ui/forms/checkbox', {
 label: 'J\'accepte les <a href="/terms" class="link link-primary">conditions d\'utilisation</a> et la <a href="/privacy" class="link link-primary">politique de confidentialité</a>',
 name: 'acceptTerms',
 required: true,
 size: 'sm',
 labelClass: 'text-sm'
 }) %>

 <%- include('../../partials/ui/button', {
 text: 'Créer mon compte',
 type: 'submit',
 variant: 'primary',
 block: true
 }) %>
 </form>

 <div class="divider">OU</div>

 <div class="text-center">
 <p class="text-sm">
 Déjà un compte ?
 <a href="/auth/login" class="link link-primary">Se connecter</a>
 </p>
 </div>
 </div>
 </div>
</div>
