<div class="min-h-screen flex items-center justify-center px-4">
 <div class="text-center max-w-2xl w-full">
 <div class="bg-base-200 border border-base-content/10 shadow-md p-8 md:p-12 rounded-2xl">
 <!-- Error Icon -->
 <div class="text-8xl mb-6" role="img" aria-label="<%= __('errors.404.title') %>">🔍</div>

 <!-- Error Code -->
 <h1 class="text-7xl md:text-8xl font-bold mb-4 bg-from-primary to-secondary text-transparent">
 404
 </h1>

 <!-- Error Message -->
 <h2 class="text-2xl md:text-3xl font-bold mb-4 tf-text-primary">
 <%= __('errors.404.title') %>
 </h2>

 <p class="tf-text-secondary mb-8 text-lg">
 <%= __('errors.404.message') %>
 </p>

 <!-- Search Box (Alpine.js for interactivity) -->
 <div class="mb-8" x-data="{ search: '' }">
 <div class="relative max-w-md mx-auto">
 <input
 type="search"
 x-model="search"
 class="input input-bordered w-full pl-12 bg-base-100 border border-base-content/10 tf-input-padding"
 :placeholder="'<%= __('errors.404.searchPlaceholder') %>'"
 @keyup.enter="window.location.href = search ? `/tasks?search=${encodeURIComponent(search)}` : '/dashboard'"
 >
 <svg
 xmlns="http://www.w3.org/2000/svg"
 class="h-6 w-6 flex-shrink-0 absolute left-4 top-1/2 -translate-y-1/2 tf-text-muted"
 fill="none"
 viewBox="0 0 24 24"
 stroke="currentColor"
 stroke-width="2"
 >
 <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
 </svg>
 </div>
 </div>

 <!-- Actions -->
 <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
 <a href="/" class="btn btn-primary gap-2 shadow-lg">
 <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
 <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
 </svg>
 <%= __('errors.404.homeButton') %>
 </a>

 <button onclick="history.back()" class="btn btn-ghost gap-2">
 <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
 <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
 </svg>
 <%= __('errors.404.backButton') %>
 </button>
 </div>

 <!-- Helpful Links -->
 <div class="mt-12 pt-8 border-t border-base-300/50">
 <p class="text-sm tf-text-secondary mb-4">
 <%= __('errors.404.helpfulLinks') %>
 </p>
 <div class="flex flex-wrap gap-4 justify-center text-sm">
 <a href="/dashboard" class="link link-primary hover:link-secondary transition-colors">
 <%= __('nav.dashboard') %>
 </a>
 <span class="tf-text-muted">•</span>
 <a href="/tasks" class="link link-primary hover:link-secondary transition-colors">
 <%= __('nav.tasks') %>
 </a>
 <span class="tf-text-muted">•</span>
 <a href="/users" class="link link-primary hover:link-secondary transition-colors">
 <%= __('nav.users') %>
 </a>
 <span class="tf-text-muted">•</span>
 <a href="/profile" class="link link-primary hover:link-secondary transition-colors">
 <%= __('nav.profile') %>
 </a>
 </div>
 </div>
 </div>

 <!-- Additional Help Card -->
 <div class="mt-6 bg-base-100 border border-base-content/10 p-4 rounded-xl text-sm">
 <p class="tf-text-secondary">
 💡 <strong><%= __('common.info') %>:</strong>
 <%= locale === 'fr' ? 'Essayez de rechercher ce que vous cherchiez dans la barre ci-dessus.' : 'Try searching for what you were looking for in the search bar above.' %>
 </p>
 </div>
 </div>
</div>
