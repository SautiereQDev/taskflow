<div class="container mx-auto px-4 py-12 max-w-4xl">
  <!-- Header -->
  <div class="text-center mb-12">
    <h1 class="text-4xl font-bold tf-text-primary mb-4"><%= __('licenses.title') %></h1>
    <p class="text-xl tf-text-muted"><%= __('licenses.subtitle') %></p>
  </div>

  <!-- License Overview -->
  <div class="bg-base-200 border border-base-content/10 shadow-md rounded-2xl p-8 mb-8">
    <h2 class="text-2xl font-bold tf-text-primary mb-4"><%= __('licenses.overview.title') %></h2>
    <p class="tf-text-secondary leading-relaxed mb-4">
      <%= __('licenses.overview.description') %>
    </p>
    <div class="flex items-center gap-4">
      <span class="badge badge-lg badge-primary">Apache License 2.0</span>
      <a href="https://www.apache.org/licenses/LICENSE-2.0" target="_blank" rel="noopener noreferrer" class="link link-primary">
        <%= __('licenses.overview.readFull') %>
      </a>
    </div>
  </div>

  <!-- Key Points -->
  <div class="grid md:grid-cols-2 gap-6 mb-8">
    <!-- Permissions -->
    <div class="bg-base-200 border border-base-content/10 shadow-md rounded-2xl p-6">
      <div class="flex items-center gap-3 mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="text-xl font-semibold text-success"><%= __('licenses.permissions.title') %></h3>
      </div>
      <ul class="space-y-2 tf-text-secondary">
        <li class="flex items-start gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span><%= __('licenses.permissions.commercial') %></span>
        </li>
        <li class="flex items-start gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span><%= __('licenses.permissions.modify') %></span>
        </li>
        <li class="flex items-start gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span><%= __('licenses.permissions.distribute') %></span>
        </li>
        <li class="flex items-start gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span><%= __('licenses.permissions.sublicense') %></span>
        </li>
        <li class="flex items-start gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span><%= __('licenses.permissions.private') %></span>
        </li>
      </ul>
    </div>

    <!-- Conditions -->
    <div class="bg-base-200 border border-base-content/10 shadow-md rounded-2xl p-6">
      <div class="flex items-center gap-3 mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-info" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="text-xl font-semibold text-info"><%= __('licenses.conditions.title') %></h3>
      </div>
      <ul class="space-y-2 tf-text-secondary">
        <li class="flex items-start gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-info flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span><%= __('licenses.conditions.include') %></span>
        </li>
        <li class="flex items-start gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-info flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span><%= __('licenses.conditions.stateChanges') %></span>
        </li>
      </ul>
    </div>

    <!-- Limitations -->
    <div class="bg-base-200 border border-base-content/10 shadow-md rounded-2xl p-6 md:col-span-2">
      <div class="flex items-center gap-3 mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-error" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <h3 class="text-xl font-semibold text-error"><%= __('licenses.limitations.title') %></h3>
      </div>
      <ul class="grid md:grid-cols-2 gap-2 tf-text-secondary">
        <li class="flex items-start gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-error flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
          <span><%= __('licenses.limitations.liability') %></span>
        </li>
        <li class="flex items-start gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-error flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
          <span><%= __('licenses.limitations.warranty') %></span>
        </li>
      </ul>
    </div>
  </div>

  <!-- Patent Grant -->
  <div class="bg-base-200 border border-base-content/10 shadow-md rounded-2xl p-8 mb-8">
    <h2 class="text-2xl font-bold tf-text-primary mb-4"><%= __('licenses.patent.title') %></h2>
    <p class="tf-text-secondary leading-relaxed">
      <%= __('licenses.patent.description') %>
    </p>
  </div>

  <!-- Simple Summary -->
  <div class="alert alert-info">
    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <div>
      <h3 class="font-bold"><%= __('licenses.summary.title') %></h3>
      <p class="text-sm"><%= __('licenses.summary.description') %></p>
    </div>
  </div>
</div>
