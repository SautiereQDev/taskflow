<%
 const currentLocale = typeof user !== 'undefined' && user.locale ? user.locale : 'fr';
 // Context is passed from controller (isAdminContext variable)
 // isAdminContext: true = admin editing user, false = user editing own profile
 const backUrl = isAdminContext ? `/users/${user.id}` : '/profile';
 const formAction = isAdminContext ? `/users/${user.id}` : '/profile';
 const pageTitle = isAdminContext ? `${__('profile.edit.titleAdmin')} - ${user.name}` : __('profile.edit.title');
%>

<div class="max-w-3xl mx-auto space-y-6">
 <!-- Header -->
 <div class="flex items-center justify-between mb-6">
 <a href="<%= backUrl %>" class="btn btn-ghost btn-sm">
 <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
 </svg>
 <%= __('common.back') %>
 </a>
 <h1 class="text-3xl font-bold tf-text-primary"><%= pageTitle %></h1>
 </div>

 <form method="POST"
 action="<%= formAction %>"
 hx-patch="<%= formAction %>"
 hx-target="#profile-form-feedback"
 hx-swap="outerHTML"
 class="space-y-6">
 <input type="hidden" name="_method" value="PATCH" />
 <input type="hidden" name="_csrf" value="<%= csrfToken %>">


 <div class="bg-base-200 border border-base-content/10 shadow-md p-8 rounded-2xl space-y-6">
 <!-- Full Name Field -->
 <%- include('../../partials/ui/forms/input', {
 label: __('profile.edit.fullName'),
 name: 'name',
 type: 'text',
 value: user.name,
 minlength: 2,
 maxlength: 100,
 required: true,
 helpText: __('profile.edit.fullNameHint')
 }) %>

 <!-- Language Select -->
 <%- include('../../partials/ui/forms/select', {
 label: __('profile.edit.language'),
 name: 'locale',
 value: currentLocale,
 showPlaceholder: false,
 options: [
 { value: 'fr', label: __('profile.edit.languageFr') },
 { value: 'en', label: __('profile.edit.languageEn') }
 ]
 }) %>
 </div>


 <div class="btn-group justify-end mt-6">
 <a href="<%= backUrl %>" class="btn btn-ghost">
 <%= __('common.cancel') %>
 </a>
 <button type="submit" class="btn btn-primary">
 <%= __('common.update') %>
 </button>
 </div>
 </form>

 <div id="profile-form-feedback"></div>
</div>
