<div class="tf-container py-8">
  <h1 class="text-3xl font-bold mb-6"><%= t('dashboard.welcome') || 'Welcome' %></h1>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <!-- Stats cards -->
    <div class="glass p-6 rounded-lg">
      <h2 class="text-lg font-semibold mb-2"><%= t('dashboard.stats.total_tasks') || 'Total Tasks' %></h2>
      <p class="text-4xl font-bold">0</p>
    </div>

    <div class="glass p-6 rounded-lg">
      <h2 class="text-lg font-semibold mb-2"><%= t('dashboard.stats.completed') || 'Completed' %></h2>
      <p class="text-4xl font-bold">0</p>
    </div>

    <div class="glass p-6 rounded-lg">
      <h2 class="text-lg font-semibold mb-2"><%= t('dashboard.stats.in_progress') || 'In Progress' %></h2>
      <p class="text-4xl font-bold">0</p>
    </div>
  </div>

  <div class="glass p-6 rounded-lg">
    <h2 class="text-2xl font-bold mb-4"><%= t('dashboard.recent_tasks') || 'Recent Tasks' %></h2>
    <p class="text-gray-600"><%= t('dashboard.no_tasks') || 'No tasks available' %></p>
  </div>
</div>
