<div class="container mx-auto px-4 py-12 max-w-3xl">
  <!-- Header -->
  <div class="text-center mb-12">
    <h1 class="text-4xl font-bold tf-text-primary mb-4"><%= __('contact.title') %></h1>
    <p class="text-xl tf-text-muted"><%= __('contact.subtitle') %></p>
  </div>

  <!-- Contact Information -->
  <div class="grid md:grid-cols-2 gap-6 mb-12">
    <div class="bg-base-200 border border-base-content/10 shadow-md rounded-2xl p-6 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto mb-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>
      <h3 class="font-semibold tf-text-primary mb-2"><%= __('contact.email.title') %></h3>
      <a href="mailto:sautiereq@gmail.com" class="link link-primary">sautiereq@gmail.com</a>
    </div>

    <div class="bg-base-200 border border-base-content/10 shadow-md rounded-2xl p-6 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto mb-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <h3 class="font-semibold tf-text-primary mb-2"><%= __('contact.support.title') %></h3>
      <a href="/faq" class="link link-primary"><%= __('contact.support.faq') %></a>
    </div>
  </div>

  <!-- Quick Links -->
  <div class="text-center mt-8">
    <p class="tf-text-muted mb-4"><%= __('contact.quickLinks.title') %></p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/faq" class="btn btn-outline btn-sm"><%= __('contact.quickLinks.faq') %></a>
      <a href="/about" class="btn btn-outline btn-sm"><%= __('contact.quickLinks.about') %></a>
      <a href="/changelog" class="btn btn-outline btn-sm"><%= __('contact.quickLinks.changelog') %></a>
    </div>
  </div>
</div>
