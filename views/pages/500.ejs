<div class="container mx-auto px-4 py-16 text-center">
  <h1 class="text-9xl font-bold text-error mb-4">500</h1>
  <h2 class="text-3xl font-semibold mb-6">Erreur Serveur</h2>
  <p class="text-lg text-base-content/70 mb-8 max-w-md mx-auto">
    Une erreur inattendue s'est produite. Veuillez réessayer plus tard.
  </p>
  <% if (process.env.NODE_ENV !== 'production' && typeof error !== 'undefined') { %>
    <div class="mockup-code text-left max-w-3xl mx-auto mb-8">
      <pre data-prefix=">"><code><%= error.message %></code></pre>
      <% if (error.stack) { %>
        <pre data-prefix="#" class="text-warning"><code><%= error.stack %></code></pre>
      <% } %>
    </div>
  <% } %>
  <a href="/" class="btn btn-primary btn-lg gap-2">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
    </svg>
    Retour à l'accueil
  </a>
</div>
