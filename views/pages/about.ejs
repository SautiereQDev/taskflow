<div class="container mx-auto px-4 py-12 max-w-4xl">
  <!-- Header -->
  <div class="text-center mb-12">
    <div class="flex justify-center items-center gap-3 mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
      </svg>
      <h1 class="text-4xl font-bold tf-text-primary">TaskFlow</h1>
    </div>
    <p class="text-xl tf-text-muted"><%= __('about.tagline') %></p>
  </div>

  <!-- Main Content -->
  <div class="bg-base-200 border border-base-content/10 shadow-md rounded-2xl p-8 mb-8">
    <h2 class="text-2xl font-bold tf-text-primary mb-4"><%= __('about.whatIs') %></h2>
    <p class="tf-text-secondary leading-relaxed mb-4">
      <%= __('about.description') %>
    </p>
    <p class="tf-text-secondary leading-relaxed">
      <%= __('about.mission') %>
    </p>
  </div>

  <!-- Features Grid -->
  <div class="grid md:grid-cols-2 gap-6 mb-8">
    <div class="bg-base-200 border border-base-content/10 shadow-md rounded-2xl p-6">
      <div class="flex items-center gap-3 mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <h3 class="text-xl font-semibold tf-text-primary"><%= __('about.features.simple.title') %></h3>
      </div>
      <p class="tf-text-secondary"><%= __('about.features.simple.description') %></p>
    </div>

    <div class="bg-base-200 border border-base-content/10 shadow-md rounded-2xl p-6">
      <div class="flex items-center gap-3 mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <h3 class="text-xl font-semibold tf-text-primary"><%= __('about.features.collaborative.title') %></h3>
      </div>
      <p class="tf-text-secondary"><%= __('about.features.collaborative.description') %></p>
    </div>

    <div class="bg-base-200 border border-base-content/10 shadow-md rounded-2xl p-6">
      <div class="flex items-center gap-3 mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        <h3 class="text-xl font-semibold tf-text-primary"><%= __('about.features.analytics.title') %></h3>
      </div>
      <p class="tf-text-secondary"><%= __('about.features.analytics.description') %></p>
    </div>

    <div class="bg-base-200 border border-base-content/10 shadow-md rounded-2xl p-6">
      <div class="flex items-center gap-3 mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <h3 class="text-xl font-semibold tf-text-primary"><%= __('about.features.secure.title') %></h3>
      </div>
      <p class="tf-text-secondary"><%= __('about.features.secure.description') %></p>
    </div>
  </div>

  <!-- Technology Stack -->
  <div class="bg-base-200 border border-base-content/10 shadow-md rounded-2xl p-8 mb-8">
    <h2 class="text-2xl font-bold tf-text-primary mb-4"><%= __('about.technology.title') %></h2>
    <p class="tf-text-secondary mb-4"><%= __('about.technology.description') %></p>
    <div class="flex flex-wrap gap-2">
      <span class="badge badge-lg badge-primary">TypeScript</span>
      <span class="badge badge-lg badge-primary">Node.js</span>
      <span class="badge badge-lg badge-primary">Express</span>
      <span class="badge badge-lg badge-primary">PostgreSQL</span>
      <span class="badge badge-lg badge-primary">Prisma</span>
      <span class="badge badge-lg badge-primary">HTMX</span>
      <span class="badge badge-lg badge-primary">Tailwind CSS</span>
      <span class="badge badge-lg badge-primary">DaisyUI</span>
    </div>
  </div>

  <!-- Call to Action -->
  <div class="text-center">
    <a href="/register" class="btn btn-primary btn-lg">
      <%= __('about.getStarted') %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
      </svg>
    </a>
  </div>
</div>
