<!-- Hero Section with Glassmorphism -->
<div class="relative min-h-[85vh] flex items-center justify-center overflow-hidden">
  <!-- Gradient Background -->
  <div class="absolute inset-0 bg-gradient-to-br from-primary/20 via-secondary/10 to-accent/20"></div>

  <!-- Animated Background Shapes -->
  <div class="absolute inset-0 overflow-hidden">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary/30 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-1/3 right-1/4 w-80 h-80 bg-secondary/30 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;" nonce="<%= cspNonce %>"></div>
    <div class="absolute top-1/2 right-1/3 w-72 h-72 bg-accent/30 rounded-full blur-3xl animate-pulse" style="animation-delay: 2s;" nonce="<%= cspNonce %>"></div>
  </div>

  <!-- Hero Content -->
  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="tf-section">
      <!-- Badge -->
      <div class="inline-flex items-center tf-gap-sm glass-light px-4 py-2 rounded-full mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-primary">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
        </svg>
        <span class="text-sm font-semibold tf-text-primary"><%= __('home.hero.badge') %></span>
      </div>

      <!-- Main Title -->
      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold tf-text-primary mb-6">
        <%= __('home.hero.title.prefix') %>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-secondary to-accent">
          <%= __('home.hero.title.highlight') %>
        </span>
      </h1>

      <!-- Subtitle -->
      <p class="text-xl sm:text-2xl tf-text-secondary max-w-3xl mx-auto mb-8">
        <%= __('home.hero.subtitle') %>
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row tf-gap justify-center items-center mb-12">
        <a href="/auth/register" class="btn btn-primary btn-lg tf-gap-sm w-full sm:w-auto shadow-lg hover:shadow-xl transition-shadow">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <%= __('home.hero.cta.start') %>
        </a>
        <a href="#features" class="btn btn-outline btn-lg tf-gap-sm w-full sm:w-auto glass-light">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
          </svg>
          <%= __('home.hero.cta.features') %>
        </a>
      </div>

      <!-- Stats Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 tf-gap max-w-3xl mx-auto">
        <div class="glass tf-card-padding rounded-xl text-center">
          <div class="text-3xl font-bold text-primary mb-1">100%</div>
          <div class="text-sm tf-text-secondary"><%= __('home.hero.stats.free') %></div>
        </div>
        <div class="glass tf-card-padding rounded-xl text-center">
          <div class="text-3xl font-bold text-secondary mb-1">⚡</div>
          <div class="text-sm tf-text-secondary"><%= __('home.hero.stats.fast') %></div>
        </div>
        <div class="glass tf-card-padding rounded-xl text-center">
          <div class="text-3xl font-bold text-accent mb-1">🔒</div>
          <div class="text-sm tf-text-secondary"><%= __('home.hero.stats.secure') %></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 tf-text-muted">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
    </svg>
  </div>
</div>

<!-- Features Section -->
<section id="features" class="py-20 px-4">
  <div class="max-w-7xl mx-auto">
    <div class="text-center tf-section mb-16">
      <h2 class="text-4xl sm:text-5xl font-bold tf-text-primary mb-4"><%= __('home.features.title') %></h2>
      <p class="text-xl tf-text-secondary max-w-2xl mx-auto">
        <%= __('home.features.subtitle') %>
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Feature 1 -->
      <div class="glass hover:glass-heavy transition-all duration-300 tf-card-padding rounded-2xl group">
        <div class="flex justify-center mb-6">
          <div class="p-4 bg-primary/10 rounded-2xl group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-12 h-12 text-primary">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
          </div>
        </div>
        <h3 class="text-2xl font-bold tf-text-primary mb-3 text-center"><%= __('home.features.intuitive.title') %></h3>
        <p class="tf-text-secondary text-center leading-relaxed">
          <%= __('home.features.intuitive.desc') %>
        </p>
      </div>

      <!-- Feature 2 -->
      <div class="glass hover:glass-heavy transition-all duration-300 tf-card-padding rounded-2xl group">
        <div class="flex justify-center mb-6">
          <div class="p-4 bg-secondary/10 rounded-2xl group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-12 h-12 text-secondary">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
        </div>
        <h3 class="text-2xl font-bold tf-text-primary mb-3 text-center"><%= __('home.features.collaboration.title') %></h3>
        <p class="tf-text-secondary text-center leading-relaxed">
          <%= __('home.features.collaboration.desc') %>
        </p>
      </div>

      <!-- Feature 3 -->
      <div class="glass hover:glass-heavy transition-all duration-300 tf-card-padding rounded-2xl group">
        <div class="flex justify-center mb-6">
          <div class="p-4 bg-accent/10 rounded-2xl group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-12 h-12 text-accent">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
        </div>
        <h3 class="text-2xl font-bold tf-text-primary mb-3 text-center"><%= __('home.features.analytics.title') %></h3>
        <p class="tf-text-secondary text-center leading-relaxed">
          <%= __('home.features.analytics.desc') %>
        </p>
      </div>

      <!-- Feature 4 -->
      <div class="glass hover:glass-heavy transition-all duration-300 tf-card-padding rounded-2xl group">
        <div class="flex justify-center mb-6">
          <div class="p-4 bg-primary/10 rounded-2xl group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-12 h-12 text-primary">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
        </div>
        <h3 class="text-2xl font-bold tf-text-primary mb-3 text-center"><%= __('home.features.tracking.title') %></h3>
        <p class="tf-text-secondary text-center leading-relaxed">
          <%= __('home.features.tracking.desc') %>
        </p>
      </div>

      <!-- Feature 5 -->
      <div class="glass hover:glass-heavy transition-all duration-300 tf-card-padding rounded-2xl group">
        <div class="flex justify-center mb-6">
          <div class="p-4 bg-secondary/10 rounded-2xl group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-12 h-12 text-secondary">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
            </svg>
          </div>
        </div>
        <h3 class="text-2xl font-bold tf-text-primary mb-3 text-center"><%= __('home.features.notifications.title') %></h3>
        <p class="tf-text-secondary text-center leading-relaxed">
          <%= __('home.features.notifications.desc') %>
        </p>
      </div>

      <!-- Feature 6 -->
      <div class="glass hover:glass-heavy transition-all duration-300 tf-card-padding rounded-2xl group">
        <div class="flex justify-center mb-6">
          <div class="p-4 bg-accent/10 rounded-2xl group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-12 h-12 text-accent">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
          </div>
        </div>
        <h3 class="text-2xl font-bold tf-text-primary mb-3 text-center"><%= __('home.features.security.title') %></h3>
        <p class="tf-text-secondary text-center leading-relaxed">
          <%= __('home.features.security.desc') %>
        </p>
      </div>
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-20 px-4 bg-gradient-to-br from-primary/10 via-secondary/5 to-accent/10 relative overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-0 left-0 w-full h-full" style="background-image: radial-gradient(circle, currentColor 1px, transparent 1px); background-size: 40px 40px;" nonce="<%= cspNonce %>"></div>
  </div>

  <div class="max-w-4xl mx-auto text-center relative z-10">
    <div class="tf-section">
      <h2 class="text-4xl sm:text-5xl font-bold tf-text-primary mb-6">
        <%= __('home.cta.title') %>
      </h2>
      <p class="text-xl tf-text-secondary mb-10 max-w-2xl mx-auto">
        <%= __('home.cta.subtitle') %>
      </p>

      <div class="flex flex-col sm:flex-row tf-gap justify-center items-center">
        <a href="/auth/register" class="btn btn-primary btn-lg tf-gap-sm w-full sm:w-auto shadow-2xl hover:shadow-3xl transition-shadow">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <%= __('home.cta.createAccount') %>
        </a>
        <a href="/auth/login" class="btn btn-outline btn-lg tf-gap-sm w-full sm:w-auto glass">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
          </svg>
          <%= __('home.cta.login') %>
        </a>
      </div>

      <!-- Trust Indicators -->
      <div class="mt-12 flex flex-wrap justify-center items-center tf-gap text-sm tf-text-muted">
        <div class="flex items-center tf-gap-xs">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-success">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span><%= __('home.trust.noCard') %></span>
        </div>
        <div class="flex items-center tf-gap-xs">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-success">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span><%= __('home.trust.free') %></span>
        </div>
        <div class="flex items-center tf-gap-xs">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-success">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span><%= __('home.trust.setup') %></span>
        </div>
      </div>
    </div>
  </div>
</section>
