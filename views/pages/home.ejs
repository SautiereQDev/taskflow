<!-- CTA Section -->
<section class="py-16 bg-base-200">
  <div class="container mx-auto px-4 text-center">
    <h2 class="text-3xl font-bold mb-4">Prêt à améliorer votre productivité ?</h2>
    <p class="text-lg mb-8 opacity-80">Rejoignez des milliers d'équipes qui font confiance à TaskFlow.</p>
    <a href="/auth/register" class="btn btn-primary btn-lg">
