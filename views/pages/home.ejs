<div class="hero min-h-[70vh]">
  <div class="hero-content text-center">
    <div class="max-w-3xl">
      <h1 class="text-5xl font-bold mb-6 bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
        Gestion de tâches moderne et collaborative
      </h1>
      <p class="text-xl mb-8 opacity-80">
        Organisez votre travail, collaborez avec votre équipe et atteignez vos objectifs plus rapidement avec TaskFlow.
      </p>
      <div class="flex gap-4 justify-center flex-wrap">
        <a href="/auth/register" class="btn btn-primary btn-lg gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Commencer gratuitement
        </a>
        <a href="#features" class="btn btn-outline btn-lg">En savoir plus</a>
      </div>
    </div>
  </div>
</div>

