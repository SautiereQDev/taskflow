<div class="space-y-8">
 <!-- Header -->
 <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
 <div>
 <h1 class="text-3xl font-bold">
 <%= typeof t === 'function'
 ? t('dashboard.welcome', { name: user?.name || '' })
 : `Bienvenue${user?.name ? `, ${user.name}` : ''}` %>
 </h1>
 <p class="text-base-content/70 mt-1">
 <%= typeof t === 'function'
 ? t('dashboard.subtitle', {
 total: stats.totalTasks,
 open: openTasks,
 })
 : `Vous suivez ${stats.totalTasks} tâche(s) dont ${openTasks} active(s).` %>
 </p>
 </div>
 <div class="card-actions">
 <a href="/tasks/new" class="btn btn-primary">
 <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
 <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
 </svg>
 <%= typeof t === 'function' ? t('dashboard.actions.newTask') : 'Nouvelle tâche' %>
 </a>
 <a href="/tasks" class="btn btn-outline">
 <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
 <path stroke-linecap="round" stroke-linejoin="round" d="M3 7h18M3 12h18M3 17h18" />
 </svg>
 </svg>
 <%= typeof t === 'function'
 ? t('dashboard.actions.viewTasks')
 : 'Voir les tâches' %>
 </a>
 </div>
 </div>

 <!-- Empty State -->
 <% if (!hasTasks) { %>
 <div class="bg-base-200 border border border-base-content/10 shadow-rounded-xl border-base-300 p-6">
 <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
 <div>
 <h2 class="text-xl font-semibold">
 <%= typeof t === 'function'
 ? t('dashboard.emptyState.title')
 : 'Commencez avec votre première tâche' %>
 </h2>
 <p class="text-base-content/70 mt-2 max-w-2xl">
 <%= typeof t === 'function'
 ? t('dashboard.emptyState.description')
 : 'Créez une tâche, assignez-la à un membre de votre équipe et suivez sa progression depuis ce tableau de bord.' %>
 </p>
 </div>
 <div class="flex flex-wrap gap-2">
 <a href="/tasks/new" class="btn btn-primary">
 <%= typeof t === 'function'
 ? t('dashboard.emptyState.primaryAction')
 : 'Créer une tâche' %>
 </a>
 <a href="/tasks" class="btn btn-ghost">
 <%= typeof t === 'function'
 ? t('dashboard.emptyState.secondaryAction')
 : 'Voir les exemples' %>
 </a>
 </div>
 </div>
 </div>
 <% } %>

 <!-- Key Metrics -->
 <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
 <div class="bg-base-200 border border border-base-content/10 shadow-rounded-xl p-6">
 <div class="flex items-center justify-between">
 <div>
 <div class="text-sm font-medium uppercase tracking-wide text-base-content/60">
 <%= typeof t === 'function'
 ? t('dashboard.cards.total')
 : 'Tâches totales' %>
 </div>
 <div class="mt-2 text-3xl font-bold"><%= stats.totalTasks %></div>
 <div class="mt-2 text-sm text-base-content/60">
 <%= typeof t === 'function'
 ? t('dashboard.cards.openTasks', { value: openTasks })
 : `${openTasks} tâche(s) actives` %>
 </div>
 </div>
 <div class="rounded-xl bg-primary/10 p-3 text-primary">
 <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 flex-shrink-0 overflow-visible" fill="none"
 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
 <path stroke-linecap="round" stroke-linejoin="round"
 d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
 </svg>
 </div>
 </div>
 </div>

 <div class="bg-base-200 border border border-base-content/10 shadow-rounded-xl p-6">
 <div class="flex items-center justify-between">
 <div>
 <div class="text-sm font-medium uppercase tracking-wide text-base-content/60">
 <%= typeof t === 'function'
 ? t('dashboard.cards.inProgress')
 : 'En cours' %>
 </div>
 <div class="mt-2 text-3xl font-bold"><%= stats.inProgressTasks %></div>
 <div class="mt-2 text-sm text-base-content/60">
 <%= typeof t === 'function'
 ? t('dashboard.cards.inProgressHint', { value: myAssignmentsSummary.inProgress })
 : `${myAssignmentsSummary.inProgress} tâche(s) vous sont assignées` %>
 </div>
 </div>
 <div class="rounded-xl bg-warning/10 p-3 text-warning">
 <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 flex-shrink-0 overflow-visible" fill="none"
 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
 <path stroke-linecap="round" stroke-linejoin="round"
 d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
 </svg>
 </div>
 </div>
 </div>

 <div class="bg-base-200 border border border-base-content/10 shadow-rounded-xl p-6">
 <div class="flex items-center justify-between">
 <div>
 <div class="text-sm font-medium uppercase tracking-wide text-base-content/60">
 <%= typeof t === 'function'
 ? t('dashboard.cards.completed')
 : 'Terminées' %>
 </div>
 <div class="mt-2 text-3xl font-bold"><%= stats.doneTasks %></div>
 <div class="mt-2 text-sm text-base-content/60">
 <%= typeof t === 'function'
 ? t('dashboard.cards.completedHint', { value: insights.completedThisWeek })
 : `${insights.completedThisWeek} cette semaine` %>
 </div>
 </div>
 <div class="rounded-xl bg-success/10 p-3 text-success">
 <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 flex-shrink-0 overflow-visible" fill="none"
 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
 <path stroke-linecap="round" stroke-linejoin="round"
 d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
 </svg>
 </div>
 </div>
 </div>

 <div class="bg-base-200 border border border-base-content/10 shadow-rounded-xl p-6">
 <div class="flex items-center justify-between">
 <div>
 <div class="text-sm font-medium uppercase tracking-wide text-base-content/60">
 <%= typeof t === 'function'
 ? t('dashboard.cards.overdue')
 : 'En retard' %>
 </div>
 <div class="mt-2 text-3xl font-bold text-error"><%= stats.overdueTasks %></div>
 <div class="mt-2 text-sm text-base-content/60">
 <%= typeof t === 'function'
 ? t('dashboard.cards.overdueHint')
 : 'À traiter rapidement' %>
 </div>
 </div>
 <div class="rounded-xl bg-error/10 p-3 text-error">
 <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 flex-shrink-0 overflow-visible" fill="none"
 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
 <path stroke-linecap="round" stroke-linejoin="round"
 d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0" />
 </svg>
 </div>
 </div>
 </div>
 </div>

 <!-- Progress & Insights -->
 <div class="grid grid-cols-1 gap-4 xl:grid-cols-3">
 <div class="bg-base-200 border border border-base-content/10 shadow-rounded-xl p-6 xl:col-span-2">
 <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
 <div>
 <h2 class="text-xl font-semibold">
 <%= typeof t === 'function'
 ? t('dashboard.progress.title')
 : 'Progression générale' %>
 </h2>
 <p class="text-base-content/70 text-sm">
 <%= typeof t === 'function'
 ? t('dashboard.progress.subtitle')
 : 'Taux de complétion basé sur l’ensemble des tâches' %>
 </p>
 </div>
 <div class="flex items-baseline gap-2">
 <span class="text-5xl font-bold"><%= stats.completionRate %>%</span>
 <span class="text-sm text-base-content/60 uppercase">
 <%= typeof t === 'function'
 ? t('dashboard.progress.completion')
 : 'Terminé' %>
 </span>
 </div>
 </div>
 <progress class="progress progress-primary mt-4 w-full" value="<%= stats.completionRate %>"
 max="100"></progress>
 <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
 <div>
 <div class="text-sm font-medium text-base-content/60 uppercase">
 <%= typeof t === 'function'
 ? t('dashboard.progress.createdThisWeek')
 : 'Créées (7 derniers jours)' %>
 </div>
 <div class="mt-1 text-2xl font-semibold"><%= insights.createdThisWeek %></div>
 </div>
 <div>
 <div class="text-sm font-medium text-base-content/60 uppercase">
 <%= typeof t === 'function'
 ? t('dashboard.progress.completedThisWeek')
 : 'Terminées (7 derniers jours)' %>
 </div>
 <div class="mt-1 text-2xl font-semibold text-success"><%= insights.completedThisWeek %></div>
 </div>
 <div>
 <div class="text-sm font-medium text-base-content/60 uppercase">
 <%= typeof t === 'function'
 ? t('dashboard.progress.activeUsers')
 : 'Membres actifs' %>
 </div>
 <div class="mt-1 text-2xl font-semibold"><%= insights.activeUsers %></div>
 </div>
 </div>
 </div>

 <div class="bg-base-200 border border border-base-content/10 shadow-rounded-xl p-6">
 <h2 class="text-xl font-semibold">
 <%= typeof t === 'function'
 ? t('dashboard.alerts.title')
 : 'Points d’attention' %>
 </h2>
 <div class="mt-4 space-y-4">
 <div class="flex items-start gap-3">
 <div class="rounded-full bg-error/10 p-2 text-error">
 <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0 overflow-visible" fill="none"
 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
 <path stroke-linecap="round" stroke-linejoin="round"
 d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0" />
 </svg>
 </div>
 <div>
 <div class="font-medium">
 <%= typeof t === 'function'
 ? t('dashboard.alerts.overdue', { value: insights.overdueTasks })
 : `${insights.overdueTasks} tâche(s) en retard` %>
 </div>
 <div class="text-sm text-base-content/60">
 <%= typeof t === 'function'
 ? t('dashboard.alerts.overdueHint')
 : 'Priorisez ces tâches pour maintenir le rythme.' %>
 </div>
 </div>
 </div>
 <div class="flex items-start gap-3">
 <div class="rounded-full bg-warning/10 p-2 text-warning">
 <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0 overflow-visible" fill="none"
 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
 <path stroke-linecap="round" stroke-linejoin="round"
 d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
 </svg>
 </div>
 <div>
 <div class="font-medium">
 <%= typeof t === 'function'
 ? t('dashboard.alerts.inProgress', { value: stats.inProgressTasks })
 : `${stats.inProgressTasks} tâche(s) en cours` %>
 </div>
 <div class="text-sm text-base-content/60">
 <%= typeof t === 'function'
 ? t('dashboard.alerts.inProgressHint')
 : 'Suivez les jalons pour éviter les retards.' %>
 </div>
 </div>
 </div>
 <div class="flex items-start gap-3">
 <div class="rounded-full bg-info/10 p-2 text-info">
 <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0 overflow-visible" fill="none"
 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
 <path stroke-linecap="round" stroke-linejoin="round"
 d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
 </svg>
 </div>
 <div>
 <div class="font-medium">
 <%= typeof t === 'function'
 ? t('dashboard.alerts.activeUsers', { value: insights.activeUsers })
 : `${insights.activeUsers} membre(s) actifs` %>
 </div>
 <div class="text-sm text-base-content/60">
 <%= typeof t === 'function'
 ? t('dashboard.alerts.activeUsersHint')
 : 'Surveillez la charge de travail de l’équipe.' %>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>

 <!-- Distribution -->
 <div class="grid grid-cols-1 gap-4 xl:grid-cols-2">
 <div class="bg-base-200 border border border-base-content/10 shadow-rounded-xl p-6">
 <h2 class="text-xl font-semibold">
 <%= typeof t === 'function'
 ? t('dashboard.distribution.status')
 : 'Répartition par statut' %>
 </h2>
 <div class="mt-4 space-y-4">
 <% const totalStatus = metrics.totalTasks || 1; %>
 <% statusDistribution.forEach((item) => {
 const percent = metrics.totalTasks > 0
 ? Math.round((item.count / metrics.totalTasks) * 100)
 : 0;
 %>
 <div class="flex items-center gap-3">
 <span class="badge <%= item.badge %> badge-sm"><%= item.label %></span>
 <div class="flex-1">
 <div class="h-2 rounded-full bg-base-200">
 <div class="h-2 rounded-full <%= item.bar %>"
 style="width: <%= percent %>%" nonce="<%= cspNonce %>"></div>
 </div>
 </div>
 <div class="w-20 text-right text-sm font-medium">
 <%= item.count %>
 <span class="text-base-content/60">(<%= percent %>%)</span>
 </div>
 </div>
 <% }) %>
 </div>
 </div>
 <div class="bg-base-200 border border border-base-content/10 shadow-rounded-xl p-6">
 <h2 class="text-xl font-semibold">
 <%= typeof t === 'function'
 ? t('dashboard.distribution.priority')
 : 'Répartition par priorité' %>
 </h2>
 <div class="mt-4 space-y-4">
 <% priorityDistribution.forEach((item) => {
 const percent = metrics.totalTasks > 0
 ? Math.round((item.count / metrics.totalTasks) * 100)
 : 0;
 %>
 <div class="flex items-center gap-3">
 <span class="badge <%= item.badge %> badge-sm"><%= item.label %></span>
 <div class="flex-1">
 <div class="h-2 rounded-full bg-base-200">
 <div class="h-2 rounded-full <%= item.bar %>"
 style="width: <%= percent %>%" nonce="<%= cspNonce %>"></div>
 </div>
 </div>
 <div class="w-20 text-right text-sm font-medium">
 <%= item.count %>
 <span class="text-base-content/60">(<%= percent %>%)</span>
 </div>
 </div>
 <% }) %>
 </div>
 </div>
 </div>

 <!-- Task Streams -->
 <div class="grid grid-cols-1 gap-4 xl:grid-cols-3">
 <div class="bg-base-200 border border border-base-content/10 shadow-rounded-xl p-6">
 <div class="flex items-center justify-between">
 <h2 class="text-xl font-semibold">
 <%= typeof t === 'function'
 ? t('dashboard.sections.highlighted')
 : 'Tâches prioritaires' %>
 </h2>
 <a href="/tasks" class="link link-primary text-sm">
 <%= typeof t === 'function'
 ? t('dashboard.sections.viewAll')
 : 'Voir tout' %>
 </a>
 </div>
 <% if (highlightedTasks.length > 0) { %>
 <div class="mt-4 space-y-3">
 <% highlightedTasks.forEach((task) => { %>
 <a href="/tasks/<%= task.id %>"
 class="block rounded-lg border border-base-200 bg-base-100 p-4 transition hover:-translate-y-0.5 hover:border-primary/40 hover:bg-base-200">
 <div class="flex items-start justify-between gap-3">
 <div>
 <div class="font-medium leading-tight"><%= task.title %></div>
 <div class="mt-2 flex flex-wrap gap-2">
 <%- include('../ui/badge', { text: task.status.label, variant: task.status.color }) %>
 <%- include('../ui/badge', { text: task.priority.label, variant: task.priority.color }) %>
 </div>
 </div>
 <% if (task.dueDate.formatted) { %>
 <div class="text-right text-xs text-base-content/60">
 <%= task.dueDate.formatted %>
 </div>
 <% } %>
 </div>
 </a>
 <% }) %>
 </div>
 <% } else { %>
 <div class="mt-6 rounded-lg border border-dashed border-base-300 p-6 text-center text-sm text-base-content/60">
 <%= typeof t === 'function'
 ? t('dashboard.sections.highlightedEmpty')
 : 'Aucune tâche prioritaire pour le moment.' %>
 </div>
 <% } %>
 </div>

 <div class="bg-base-200 border border border-base-content/10 shadow-rounded-xl p-6">
 <h2 class="text-xl font-semibold">
 <%= typeof t === 'function'
 ? t('dashboard.sections.upcoming')
 : 'À venir' %>
 </h2>
 <% if (upcomingTasks.length > 0) { %>
 <div class="mt-4 space-y-3">
 <% upcomingTasks.forEach((task) => { %>
 <a href="/tasks/<%= task.id %>"
 class="flex items-center justify-between gap-3 rounded-lg border border-base-200 bg-base-100 p-4 transition hover:border-warning/40 hover:bg-base-200">
 <div>
 <div class="font-medium leading-tight"><%= task.title %></div>
 <div class="mt-2 flex flex-wrap gap-2">
 <%- include('../ui/badge', { text: task.priority.label, variant: task.priority.color }) %>
 <% if (task.assignee) { %>
 <span class="badge badge-outline badge-sm">
 <%= task.assignee.initials %>
 </span>
 <% } %>
 </div>
 </div>
 <div class="text-right text-sm">
 <% if (task.dueDate.isOverdue) { %>
 <span class="font-medium text-error">
 <%= typeof t === 'function'
 ? t('dashboard.sections.overdue')
 : 'En retard' %>
 </span>
 <% } else if (task.dueDate.isToday) { %>
 <span class="font-medium text-warning">
 <%= typeof t === 'function'
 ? t('dashboard.sections.dueToday')
 : 'À faire aujourd’hui' %>
 </span>
 <% } else if (task.dueDate.isTomorrow) { %>
 <span class="font-medium text-info">
 <%= typeof t === 'function'
 ? t('dashboard.sections.dueTomorrow')
 : 'Pour demain' %>
 </span>
 <% } else if (task.dueDate.formatted) { %>
 <span class="text-base-content/70"><%= task.dueDate.formatted %></span>
 <% } else { %>
 <span class="text-base-content/60">
 <%= typeof t === 'function'
 ? t('dashboard.sections.noDueDate')
 : 'Pas d’échéance' %>
 </span>
 <% } %>
 <% if (task.dueDate.relative) { %>
 <div class="text-xs text-base-content/60"><%= task.dueDate.relative %></div>
 <% } %>
 </div>
 </a>
 <% }) %>
 </div>
 <% } else { %>
 <div class="mt-6 rounded-lg border border-dashed border-base-300 p-6 text-center text-sm text-base-content/60">
 <%= typeof t === 'function'
 ? t('dashboard.sections.upcomingEmpty')
 : 'Aucune échéance imminente.' %>
 </div>
 <% } %>
 </div>

 <div class="bg-base-200 border border border-base-content/10 shadow-rounded-xl p-6">
 <h2 class="text-xl font-semibold">
 <%= typeof t === 'function'
 ? t('dashboard.sections.myWork')
 : 'Mes tâches' %>
 </h2>
 <div class="mt-4 grid grid-cols-2 gap-2 text-sm">
 <div class="rounded-lg bg-base-200 p-3 text-center">
 <div class="text-xs uppercase text-base-content/60">
 <%= typeof t === 'function'
 ? t('dashboard.sections.summaryTotal')
 : 'Total' %>
 </div>
 <div class="mt-1 text-xl font-semibold"><%= myAssignmentsSummary.total %></div>
 </div>
 <div class="rounded-lg bg-base-200 p-3 text-center">
 <div class="text-xs uppercase text-base-content/60">
 <%= typeof t === 'function'
 ? t('dashboard.sections.summaryInProgress')
 : 'En cours' %>
 </div>
 <div class="mt-1 text-xl font-semibold text-warning">
 <%= myAssignmentsSummary.inProgress %>
 </div>
 </div>
 <div class="rounded-lg bg-base-200 p-3 text-center">
 <div class="text-xs uppercase text-base-content/60">
 <%= typeof t === 'function'
 ? t('dashboard.sections.summaryTodo')
 : 'À faire' %>
 </div>
 <div class="mt-1 text-xl font-semibold text-info"><%= myAssignmentsSummary.todo %></div>
 </div>
 <div class="rounded-lg bg-base-200 p-3 text-center">
 <div class="text-xs uppercase text-base-content/60">
 <%= typeof t === 'function'
 ? t('dashboard.sections.summaryOverdue')
 : 'En retard' %>
 </div>
 <div class="mt-1 text-xl font-semibold text-error"><%= myAssignmentsSummary.overdue %></div>
 </div>
 </div>

 <% if (myAssignments.length > 0) { %>
 <div class="mt-4 space-y-3">
 <% myAssignments.forEach((task) => { %>
 <a href="/tasks/<%= task.id %>"
 class="flex items-center justify-between gap-3 rounded-lg border border-base-200 bg-base-100 p-4 transition hover:border-primary/40 hover:bg-base-200">
 <div>
 <div class="font-medium leading-tight"><%= task.title %></div>
 <div class="mt-2 flex flex-wrap gap-2 text-xs text-base-content/60">
 <span><%= task.status.label %></span>
 <% if (task.dueDate.formatted) { %>
 <span>•</span>
 <span><%= task.dueDate.formatted %></span>
 <% } %>
 </div>
 </div>
 <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0 text-base-content/40"
 fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
 <path stroke-linecap="round" stroke-linejoin="round"
 d="M9 5l7 7-7 7" />
 </svg>
 </a>
 <% }) %>
 </div>
 <% } else { %>
 <div class="mt-6 rounded-lg border border-dashed border-base-300 p-6 text-center text-sm text-base-content/60">
 <%= typeof t === 'function'
 ? t('dashboard.sections.myWorkEmpty')
 : 'Aucune tâche ne vous est assignée.' %>
 </div>
 <% } %>
 </div>
 </div>

 <!-- Team Capacity -->
 <div class="bg-base-200 border border border-base-content/10 shadow-rounded-xl p-6">
 <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
 <div>
 <h2 class="text-xl font-semibold">
 <%= typeof t === 'function'
 ? t('dashboard.teamCapacity.title')
 : 'Capacité de l’équipe' %>
 </h2>
 <p class="text-sm text-base-content/60">
 <%= typeof t === 'function'
 ? t('dashboard.teamCapacity.subtitle')
 : 'Vue d’ensemble de la charge de travail et du taux de complétion par membre.' %>
 </p>
 </div>
 <a href="/users" class="btn btn-ghost btn-sm gap-2">
 <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0 overflow-visible" fill="none"
 viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
 <path stroke-linecap="round" stroke-linejoin="round"
 d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 10a4 4 0 10-8 0m8 0a4 4 0 11-8 0m8 0v1a4 4 0 103.356 1.857M7 20h10" />
 </svg>
 <%= typeof t === 'function'
 ? t('dashboard.teamCapacity.manage')
 : 'Gérer les membres' %>
 </a>
 </div>

 <% if (teamCapacity.length > 0) { %>
 <div class="mt-4 overflow-x-auto">
 <table class="table w-full">
 <thead>
 <tr>
 <th>
 <%= typeof t === 'function'
 ? t('dashboard.teamCapacity.columns.member')
 : 'Membre' %>
 </th>
 <th class="text-center">
 <%= typeof t === 'function'
 ? t('dashboard.teamCapacity.columns.assigned')
 : 'Assignées' %>
 </th>
 <th class="text-center">
 <%= typeof t === 'function'
 ? t('dashboard.teamCapacity.columns.completed')
 : 'Terminées' %>
 </th>
 <th class="text-center">
 <%= typeof t === 'function'
 ? t('dashboard.teamCapacity.columns.overdue')
 : 'En retard' %>
 </th>
 <th>
 <%= typeof t === 'function'
 ? t('dashboard.teamCapacity.columns.completion')
 : 'Taux de complétion' %>
 </th>
 </tr>
 </thead>
 <tbody>
 <% teamCapacity.forEach((member) => { %>
 <tr class="<%= member.isCurrentUser ? 'bg-primary/5' : '' %>">
 <td>
 <div class="flex flex-col">
 <span class="font-medium"><%= member.name %></span>
 <% if (member.email) { %>
 <span class="text-xs text-base-content/60"><%= member.email %></span>
 <% } %>
 </div>
 </td>
 <td class="text-center font-medium"><%= member.assigned %></td>
 <td class="text-center text-success font-medium"><%= member.completed %></td>
 <td class="text-center font-medium <%= member.overdue > 0 ? 'text-error' : 'text-base-content' %>">
 <%= member.overdue %>
 </td>
 <td>
 <div class="flex items-center gap-3">
 <progress class="progress progress-success w-32"
 value="<%= member.completionRate %>" max="100"></progress>
 <span class="text-sm font-semibold"><%= member.completionRate %>%</span>
 </div>
 </td>
 </tr>
 <% }) %>
 </tbody>
 </table>
 </div>
 <% } else { %>
 <div class="mt-6 rounded-lg border border-dashed border-base-300 p-6 text-center text-sm text-base-content/60">
 <%= typeof t === 'function'
 ? t('dashboard.teamCapacity.empty')
 : 'Aucun membre actif pour le moment.' %>
 </div>
 <% } %>
 </div>
</div>
