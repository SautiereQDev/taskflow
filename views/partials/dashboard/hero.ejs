<!-- Dashboard Hero - Welcome Zone Only -->
<div class="w-full max-w-none px-4 sm:px-6 lg:px-8 py-6 md:py-8">
 <div class="bg-base-300 border border border-base-content/10 shadow-rounded-2xl md:rounded-3xl overflow-hidden">
 <div class="p-6 md:p-10 text-center">

 <!-- Welcome Message -->
 <div class="mb-8">
 <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-base-content mb-3">
 <%= __('dashboard.hero.greeting').replace('{{name}}', user.name).replace('{{#if name}}', '').replace('{{/if}}', '') %>
 </h1>
 <p class="text-base md:text-lg lg:text-xl text-base-content/80 max-w-2xl mx-auto">
 <%= __('dashboard.hero.subtitle').replace('{{total}}', stats.totalTasks).replace('{{active}}', openTasks) %>
 </p>
 </div>

 <!-- Quick Actions - Prominent CTAs -->
 <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4 max-w-4xl mx-auto">
 <a href="/tasks/new"
 class="card bg-base-200 hover:bg-base-300 transition-colors p-6 rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-xl group">
 <div class="text-4xl mb-3 group-hover:scale-110 transition-transform duration-300">
 <svg class="w-12 h-12 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
 </svg>
 </div>
 <div class="text-base-content font-semibold text-sm md:text-base">
 <%= __('dashboard.hero.actions.create') %>
 </div>
 </a>

 <a href="/tasks?status=IN_PROGRESS"
 class="card bg-base-200 hover:bg-base-300 transition-colors p-6 rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-xl group">
 <div class="text-4xl mb-3 group-hover:scale-110 transition-transform duration-300">
 <svg class="w-12 h-12 text-info" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
 </svg>
 </div>
 <div class="text-base-content font-semibold text-sm md:text-base">
 <%= __('dashboard.hero.actions.viewActive') %>
 </div>
 </a>

 <a href="/tasks?priority=HIGH&priority=URGENT"
 class="card bg-base-200 hover:bg-base-300 transition-colors p-6 rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-xl group">
 <div class="text-4xl mb-3 group-hover:scale-110 transition-transform duration-300">
 <svg class="w-12 h-12 text-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
 </svg>
 </div>
 <div class="text-base-content font-semibold text-sm md:text-base">
 <%= __('dashboard.hero.actions.viewUrgent') %>
 </div>
 </a>

 <a href="/tasks"
 class="card bg-base-200 hover:bg-base-300 transition-colors p-6 rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-xl group">
 <div class="text-4xl mb-3 group-hover:scale-110 transition-transform duration-300">
 <svg class="w-12 h-12 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
 </svg>
 </div>
 <div class="text-base-content font-semibold text-sm md:text-base">
 <%= __('dashboard.hero.actions.viewReports') %>
 </div>
 </a>
 </div>

 </div>
 </div>
</div>
