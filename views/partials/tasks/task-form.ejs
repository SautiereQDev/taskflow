<%
 const isEdit = mode === 'edit';
 const formAction = typeof action !== 'undefined' ? action : isEdit && task ? `/tasks/${task.id}/edit` : '/tasks';
 const htmxConfig = typeof htmx !== 'undefined' && htmx ? htmx : {};
 const htmxMethod = htmxConfig.method || (isEdit ? 'patch' : 'post');
 const htmxAction = htmxConfig.action || (isEdit && task ? `/tasks/${task.id}` : '/tasks');
 const htmxTarget = htmxConfig.target || 'body';
 const htmxSwap = htmxConfig.swap;
 const submitLabel = typeof submitText !== 'undefined' ? submitText : isEdit ? 'Mettre à jour' : 'Créer la tâche';
 const cancelUrl = typeof backUrl !== 'undefined' ? backUrl : isEdit && task ? `/tasks/${task.id}` : '/tasks';
 const taskTitle = task?.title ?? '';
 const taskDescription = task?.description ?? '';
 const taskStatus = task?.status ?? 'TODO';
 const taskPriority = task?.priority ?? 'MEDIUM';
 const taskAssigneeId = task?.assigneeId ?? '';
 const taskDueDate = task?.dueDate ?? '';
%>
<form
 method="POST"
 action="<%= formAction %>"
 class="space-y-6"
 hx-target="<%= htmxTarget %>"
 hx-indicator="#task-submit-indicator"
 <% if (htmxSwap) { %> hx-swap="<%= htmxSwap %>" <% } %>
 hx-<%= htmxMethod %>="<%= htmxAction %>"
 @htmx:before-request="isSubmitting = true"
 @htmx:after-request="isSubmitting = false"
>
 <!-- CSRF Token -->
 <input type="hidden" name="_csrf" value="<%= csrfToken %>">

 <!-- Title -->
 <%- include('../ui/forms/input', {
 label: 'Titre',
 name: 'title',
 type: 'text',
 value: taskTitle,
 placeholder: 'Ex: Préparer la livraison de la fonctionnalité',
 minlength: 3,
 maxlength: 200,
 required: true,
 showCounter: true,
 counterModel: 'title',
 xModel: 'title'
 }) %>

 <!-- Description -->
 <%- include('../ui/forms/textarea', {
 label: 'Description',
 name: 'description',
 value: taskDescription,
 placeholder: 'Ajoutez des détails pour contextualiser la tâche...',
 rows: 8,
 maxlength: 2000,
 showCounter: true,
 counterModel: 'description',
 xModel: 'description'
 }) %>

 <div class="grid md:grid-cols-2 gap-6">
 <!-- Status -->
 <%- include('../ui/forms/select', {
 label: 'Statut',
 name: 'status',
 value: taskStatus,
 required: true,
 showPlaceholder: false,
 options: [
 { value: 'TODO', label: 'À faire' },
 { value: 'IN_PROGRESS', label: 'En cours' },
 { value: 'DONE', label: 'Terminée' },
 { value: 'CANCELLED', label: 'Annulée' }
 ]
 }) %>

 <!-- Priority -->
 <%- include('../ui/forms/select', {
 label: 'Priorité',
 name: 'priority',
 value: taskPriority,
 required: true,
 showPlaceholder: false,
 options: [
 { value: 'LOW', label: 'Basse' },
 { value: 'MEDIUM', label: 'Moyenne' },
 { value: 'HIGH', label: 'Haute' },
 { value: 'URGENT', label: 'Urgente' }
 ]
 }) %>
 </div>

 <div class="grid md:grid-cols-2 gap-6">
 <!-- Assignee -->
 <%- include('../ui/forms/select', {
 label: 'Assignée à',
 name: 'assigneeId',
 value: taskAssigneeId,
 placeholder: 'Non assignée / No assignee',
 customOptionsHtml: `
 ${(users || []).map(user => `
 <option value="${user.id}" ${taskAssigneeId === user.id ? 'selected' : ''}>
 ${user.name} (${user.email})
 </option>
 `).join('')}
 `
 }) %>

 <!-- Due Date -->
 <%- include('../ui/forms/input', {
 label: 'Date d\'échéance',
 name: 'dueDate',
 type: 'datetime-local',
 value: taskDueDate
 }) %>
 </div>

 <div class="btn-group pt-6">
 <button type="submit" class="btn btn-primary" :disabled="isSubmitting">
 <span id="task-submit-indicator" class="htmx-indicator loading loading-spinner loading-xs"></span>
 <%= submitLabel %>
 </button>
 <a href="<%= cancelUrl %>" class="btn btn-ghost">
 Annuler
 </a>
 </div>

 <% if (isEdit && task) { %>
 <div class="alert alert-info bg-base-100 border border-base-content/10 mt-6">
 <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M12 9v2m0 4h.01m-.01-10a9 9 0 11-9 9 9 9 0 019-9z" />
 </svg>
 <span>Les modifications sont enregistrées côté serveur via HTMX. Ce formulaire reste fonctionnel sans JavaScript.</span>
 </div>

 <div class="mt-6 pt-4 border-t border-base-content/10">
 <button type="button" class="btn btn-outline btn-error btn-sm"
 onclick="if(confirm('Voulez-vous vraiment supprimer cette tâche ?')) { htmx.ajax('DELETE', '/tasks/<%= task.id %>', { target: 'body', swap: 'outerHTML' }); }"
 >
 <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
 </svg>
 Supprimer la tâche
 </button>
 </div>
 <% } %>
</form>
