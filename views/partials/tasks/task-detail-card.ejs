<section id="task-detail-card" class="bg-base-200 border border-base-content/10 shadow-lg p-6 md:p-8 rounded-2xl space-y-6">
  <header class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
    <div class="space-y-4">
      <div class="space-y-2">
        <h1 class="text-3xl md:text-4xl font-bold text-base-content"><%= task.title %></h1>
        <div class="flex flex-wrap items-center gap-2 text-sm">
          <span class="badge <%= task.status.color %> px-3 py-2 font-semibold">
            <%= task.status.label %>
          </span>
          <span class="badge <%= task.priority.color %> px-3 py-2 font-semibold">
            <%= task.priority.label %>
          </span>
          <% if (task.dueDate.formatted) { %>
            <span class="badge <%= task.dueDate.isOverdue ? 'badge-error' : 'badge-ghost' %> gap-1 px-3 py-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3M5 11h14M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span><%= task.dueDate.formatted %></span>
            </span>
            <% if (task.dueDate.relative) { %>
              <span class="text-xs uppercase tracking-wide text-base-content/60">
                <%= task.dueDate.relative %>
              </span>
            <% } %>
          <% } %>
        </div>
      </div>
      <% if (task.dueDate.isOverdue) { %>
        <div class="alert alert-warning bg-base-100 border border-base-content/10 max-w-md">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M12 9v2m0 4h.01m-.01-10a9 9 0 11-9 9 9 9 0 019-9z" />
          </svg>
          <span>Cette tâche est en retard.</span>
        </div>
      <% } %>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <% if (task.canEdit) { %>
        <a href="/tasks/<%= task.id %>/edit" class="btn btn-ghost btn-sm gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          Modifier
        </a>
      <% } %>
      <% if (task.canComplete) { %>
        <button
          class="btn btn-primary btn-sm gap-2"
          hx-post="/tasks/<%= task.id %>/complete"
          hx-target="#task-detail-card"
          hx-swap="outerHTML"
          hx-indicator="#task-complete-indicator"
        >
          <span id="task-complete-indicator" class="htmx-indicator loading loading-spinner loading-xs"></span>
          <%= task.status.value === 'DONE' ? 'Reprendre' : 'Terminer' %>
        </button>
      <% } %>
    </div>
  </header>

  <article class="prose prose-sm md:prose-base max-w-none text-base-content/80">
    <% if (task.description) { %>
      <%= task.description %>
    <% } else { %>
      <p class="italic text-base-content/60">Aucune description n'a été fournie pour cette tâche.</p>
    <% } %>
  </article>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="bg-base-100 border border-base-content/10 p-4 rounded-xl space-y-2">
      <p class="text-xs uppercase tracking-wide text-base-content/60">Créée par</p>
      <div class="flex items-center gap-3">
        <div class="avatar placeholder">
          <div class="w-12 h-12 rounded-full bg-primary text-primary-content flex items-center justify-center font-semibold">
            <span><%= task.creator.initials %></span>
          </div>
        </div>
        <div>
          <p class="font-semibold"><%= task.creator.name %></p>
          <p class="text-sm text-base-content/60"><%= task.creator.email %></p>
        </div>
      </div>
    </div>

    <div class="bg-base-100 border border-base-content/10 p-4 rounded-xl space-y-2">
      <p class="text-xs uppercase tracking-wide text-base-content/60">Assignée à</p>
      <% if (task.assignee) { %>
        <div class="flex items-center gap-3">
          <div class="avatar placeholder">
            <div class="w-12 h-12 rounded-full bg-secondary text-secondary-content flex items-center justify-center font-semibold">
              <span><%= task.assignee.initials %></span>
            </div>
          </div>
          <div>
            <p class="font-semibold"><%= task.assignee.name %></p>
            <p class="text-sm text-base-content/60"><%= task.assignee.email %></p>
          </div>
        </div>
      <% } else { %>
        <p class="text-sm text-base-content/60">
          Cette tâche n'est pas encore assignée.
          <span class="sr-only">No assignee</span>
        </p>
      <% } %>
    </div>

    <div class="bg-base-100 border border-base-content/10 p-4 rounded-xl space-y-2">
      <p class="text-xs uppercase tracking-wide text-base-content/60">Créée le</p>
      <p class="font-semibold"><%= task.createdAt.formatted %></p>
      <p class="text-sm text-base-content/60"><%= task.createdAt.relative %></p>
    </div>

    <div class="bg-base-100 border border-base-content/10 p-4 rounded-xl space-y-2">
      <p class="text-xs uppercase tracking-wide text-base-content/60">Dernière mise à jour</p>
      <p class="font-semibold"><%= task.updatedAt.formatted %></p>
      <p class="text-sm text-base-content/60"><%= task.updatedAt.relative %></p>
    </div>
  </div>

  <% if (task.canDelete) { %>
    <div class="flex items-center justify-end gap-3 pt-6 border-t border-base-content/10">
      <button
        class="btn btn-outline btn-error btn-sm gap-2"
        hx-delete="/tasks/<%= task.id %>"
        hx-confirm="Êtes-vous sûr de vouloir supprimer cette tâche ?"
        hx-on::afterRequest="window.location='/tasks'"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
        Supprimer la tâche
      </button>
    </div>
  <% } %>
</section>
