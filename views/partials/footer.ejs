<footer class="bg-base-200 border border-base-content/10 shadow-md mt-auto border-t border-base-300">
  <div class="container mx-auto px-4 py-8">
    <!-- Main horizontal footer layout -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 text-base-content">
      <!-- Brand Column -->
      <div class="flex flex-col gap-2">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 flex-shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
          </svg>
          <span class="font-bold text-lg">TaskFlow</span>
        </div>
        <p class="text-sm opacity-70"><%= __('footer.tagline') %></p>
        <p class="text-xs opacity-60">
          <%= __('footer.copyright', { year: new Date().getFullYear() }) %>
        </p>
      </div>

      <!-- Product Column -->
      <nav class="flex flex-col gap-2">
        <header class="font-semibold text-base mb-2"><%= __('footer.product') %></header>
        <a href="/about" class="link link-hover text-sm opacity-80"><%= __('footer.about') %></a>
        <a href="/features" class="link link-hover text-sm opacity-80"><%= __('footer.features') %></a>
        <a href="/roadmap" class="link link-hover text-sm opacity-80"><%= __('footer.roadmap') %></a>
        <a href="/changelog" class="link link-hover text-sm opacity-80"><%= __('footer.changelog') %></a>
      </nav>

      <!-- Support Column -->
      <nav class="flex flex-col gap-2">
        <header class="font-semibold text-base mb-2"><%= __('footer.support') %></header>
        <a href="/help" class="link link-hover text-sm opacity-80"><%= __('footer.help') %></a>
        <a href="/contact" class="link link-hover text-sm opacity-80"><%= __('footer.contact') %></a>
        <a href="/faq" class="link link-hover text-sm opacity-80"><%= __('footer.faq') %></a>
        <a href="/status" class="link link-hover text-sm opacity-80"><%= __('footer.status') %></a>
      </nav>

      <!-- Legal Column -->
      <nav class="flex flex-col gap-2">
        <header class="font-semibold text-base mb-2"><%= __('footer.legal') %></header>
        <a href="/privacy" class="link link-hover text-sm opacity-80"><%= __('footer.privacy') %></a>
        <a href="/terms" class="link link-hover text-sm opacity-80"><%= __('footer.terms') %></a>
        <a href="/cookies" class="link link-hover text-sm opacity-80"><%= __('footer.cookies') %></a>
        <a href="/licenses" class="link link-hover text-sm opacity-80"><%= __('footer.licenses') %></a>
      </nav>
    </div>

    <!-- Social & Version -->
    <div class="divider"></div>
    <div class="flex flex-col sm:flex-row justify-between items-center gap-4 text-sm opacity-70">
      <div class="flex gap-4">
        <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="link link-hover flex items-center gap-1 hover:text-primary transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          <span class="hidden sm:inline">GitHub</span>
        </a>
        <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="link link-hover flex items-center gap-1 hover:text-primary transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
          </svg>
          <span class="hidden sm:inline">Twitter</span>
        </a>
      </div>
      <div class="text-xs">
        <span class="badge badge-ghost">v1.0.0</span>
      </div>
    </div>
  </div>
</footer>
