<footer class="bg-base-200 border border-base-content/10 shadow-md mt-auto border-t border-base-300">
 <div class="container mx-auto px-4 py-8">
 <!-- Main horizontal footer layout -->
 <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 text-base-content">
 <!-- Brand Column -->
 <div class="flex flex-col gap-2">
 <div class="flex items-center gap-2">
 <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 flex-shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
 <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
 </svg>
 <span class="font-bold text-lg">TaskFlow</span>
 </div>
 <p class="text-sm opacity-70"><%= __('footer.tagline') %></p>
 <p class="text-xs opacity-60">
 <%= __('footer.copyright', { year: new Date().getFullYear() }) %>
 </p>
 </div>

 <!-- Product Column -->
 <nav class="flex flex-col gap-2">
 <header class="font-semibold text-base mb-2"><%= __('footer.product') %></header>
 <a href="/about" class="link link-hover text-sm opacity-80"><%= __('footer.about') %></a>
 <a href="/changelog" class="link link-hover text-sm opacity-80"><%= __('footer.changelog') %></a>
 </nav>

 <!-- Support Column -->
 <nav class="flex flex-col gap-2">
 <header class="font-semibold text-base mb-2"><%= __('footer.support') %></header>
 <a href="/contact" class="link link-hover text-sm opacity-80"><%= __('footer.contact') %></a>
 <a href="/faq" class="link link-hover text-sm opacity-80"><%= __('footer.faq') %></a>
 </nav>

 <!-- Legal Column -->
 <nav class="flex flex-col gap-2">
 <header class="font-semibold text-base mb-2"><%= __('footer.legal') %></header>
 <a href="/licenses" class="link link-hover text-sm opacity-80"><%= __('footer.licenses') %></a>
 </nav>
 </div>
 </div>
</footer>
