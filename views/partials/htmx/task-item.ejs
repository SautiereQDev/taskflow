<div id="task-<%= task.id %>"
 class="bg-base-200 border border-base-content/10 shadow-md tf-card-padding-sm rounded-xl hover:shadow-lg transition-all duration-200">

 <div class="flex items-start justify-between tf-gap">
 <!-- Left: Task Info -->
 <div class="flex-1 min-w-0">
 <!-- Title -->
 <a href="/tasks/<%= task.id %>"
 class="text-lg font-semibold hover:link block mb-2 truncate">
 <%= task.title %>
 </a>

 <!-- Badges -->
 <div class="flex flex-wrap tf-gap-sm mb-3">
 <span class="badge badge-<%= task.status.color %>"><%= task.status.label %></span>
 <span class="badge badge-<%= task.priority.color %>"><%= task.priority.label %></span>
 <% if (task.dueDate && task.dueDate.formatted) { %>
 <span class="badge <%= task.dueDate.isOverdue ? 'badge-error' : 'badge-ghost' %> tf-gap-xs">
 <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
 <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
 </svg>
 <%= task.dueDate.formatted %>
 </span>
 <% } %>
 </div>

 <!-- Assignee -->
 <% if (task.assignee) { %>
 <div class="flex items-center tf-gap-sm text-sm text-base-content/70">
 <div class="avatar placeholder">
 <div class="bg-neutral text-neutral-content rounded-full w-6 h-6">
 <span class="text-xs"><%= task.assignee.initials %></span>
 </div>
 </div>
 <span><%= task.assignee.name %></span>
 </div>
 <% } %>
 </div>

 <!-- Right: Actions -->
 <div class="flex items-center tf-gap-sm">
 <!-- Quick Actions -->
 <% if (task.canEdit) { %>
 <div class="dropdown dropdown-end" x-data="{ open: false }" @click.outside="open = false">
 <button @click="open = !open" class="btn btn-ghost btn-sm btn-circle hover:bg-base-300 transition-colors">
 <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
 <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" />
 </svg>
 </button>
 <ul x-show="open" 
 x-cloak
 x-transition:enter="transition ease-out duration-200"
 x-transition:enter-start="opacity-0 scale-95"
 x-transition:enter-end="opacity-100 scale-100"
 x-transition:leave="transition ease-in duration-150"
 x-transition:leave-start="opacity-100 scale-100"
 x-transition:leave-end="opacity-0 scale-95"
 class="dropdown-content menu glass shadow-xl rounded-2xl w-56 border border-base-content/10 z-10 p-2">
 <!-- Consultation -->
 <li>
 <a href="/tasks/<%= task.id %>" class="gap-3 py-3 rounded-lg hover:bg-base-200/50 transition-colors">
 <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
 <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
 <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
 </svg>
 <span class="flex-1 tf-text-primary">Voir les détails</span>
 </a>
 </li>
 
 <!-- Modification -->
 <li>
 <a href="/tasks/<%= task.id %>/edit" class="gap-3 py-3 rounded-lg hover:bg-base-200/50 transition-colors">
 <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
 <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
 </svg>
 <span class="flex-1 tf-text-primary">Modifier</span>
 </a>
 </li>
 
 <!-- Séparateur -->
 <% if (task.status.value !== 'DONE') { %>
 <div class="divider my-1"></div>
 
 <!-- Action de complétion -->
 <li>
 <button hx-post="/tasks/<%= task.id %>/complete"
 hx-target="#task-<%= task.id %>"
 hx-swap="outerHTML"
 hx-indicator="#loading-indicator-<%= task.id %>"
 @htmx:after-request="open = false"
 class="w-full gap-3 py-3 rounded-lg hover:bg-success/10 transition-colors">
 <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
 <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
 </svg>
 <span class="flex-1 text-success text-left">Marquer terminée</span>
 <span id="loading-indicator-<%= task.id %>" class="htmx-indicator loading loading-spinner loading-xs"></span>
 </button>
 </li>
 <% } %>
 
 <!-- Séparateur avant action destructive -->
 <div class="divider my-1"></div>
 
 <!-- Action destructive -->
 <li>
 <button hx-delete="/tasks/<%= task.id %>"
 hx-confirm="Êtes-vous sûr de vouloir supprimer cette tâche ?"
 hx-target="#task-<%= task.id %>"
 hx-swap="outerHTML swap:1s"
 @htmx:after-request="open = false"
 class="w-full gap-3 py-3 rounded-lg hover:bg-error/10 transition-colors">
 <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0 text-error" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
 <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
 </svg>
 <span class="flex-1 text-error text-left">Supprimer</span>
 </button>
 </li>
 </ul>
 </div>
 <% } %>
 </div>
 </div>
</div>
