<div class="glass tf-card-padding rounded-2xl">
 <h2 class="text-xl font-bold tf-text-primary mb-6">Filtres</h2>

 <form id="filters-form"
 action="/tasks"
 method="GET"
 hx-get="/tasks"
 hx-target="#task-list-container"
 hx-swap="innerHTML"
 hx-indicator="#filter-indicator"
 hx-push-url="true"
 hx-include="[name]"
 hx-trigger="submit"
 hx-headers='{"Cache-Control": "no-cache"}'
 class="tf-section">

 <!-- Status -->
 <div class="form-control">
 <label class="label mb-2">
 <span class="label-text font-semibold tf-text-primary">Statut</span>
 </label>
 <div class="tf-items">
 <label class="label cursor-pointer justify-start gap-3 py-2 hover:bg-base-200/50 rounded-lg px-2 -mx-2 transition-colors">
 <input
 type="checkbox"
 name="status"
 value="TODO"
 class="checkbox checkbox-sm"
 <%= filters.status && filters.status.includes('TODO') ? 'checked' : '' %>
 />
 <span class="label-text tf-text-primary">À faire</span>
 </label>
 <label class="label cursor-pointer justify-start gap-3 py-2 hover:bg-base-200/50 rounded-lg px-2 -mx-2 transition-colors">
 <input
 type="checkbox"
 name="status"
 value="IN_PROGRESS"
 class="checkbox checkbox-sm"
 <%= filters.status && filters.status.includes('IN_PROGRESS') ? 'checked' : '' %>
 />
 <span class="label-text tf-text-primary">En cours</span>
 </label>
 <label class="label cursor-pointer justify-start gap-3 py-2 hover:bg-base-200/50 rounded-lg px-2 -mx-2 transition-colors">
 <input
 type="checkbox"
 name="status"
 value="DONE"
 class="checkbox checkbox-sm"
 <%= filters.status && filters.status.includes('DONE') ? 'checked' : '' %>
 />
 <span class="label-text tf-text-primary">Terminée</span>
 </label>
 <label class="label cursor-pointer justify-start gap-3 py-2 hover:bg-base-200/50 rounded-lg px-2 -mx-2 transition-colors">
 <input
 type="checkbox"
 name="status"
 value="CANCELLED"
 class="checkbox checkbox-sm"
 <%= filters.status && filters.status.includes('CANCELLED') ? 'checked' : '' %>
 />
 <span class="label-text tf-text-primary">Annulée</span>
 </label>
 </div>
 </div>

 <!-- Priority -->
 <div class="form-control">
 <label class="label mb-2">
 <span class="label-text font-semibold tf-text-primary">Priorité</span>
 </label>
 <div class="tf-items">
 <label class="label cursor-pointer justify-start gap-3 py-2 hover:bg-base-200/50 rounded-lg px-2 -mx-2 transition-colors">
 <input
 type="checkbox"
 name="priority"
 value="URGENT"
 class="checkbox checkbox-sm checkbox-error"
 <%= filters.priority && filters.priority.includes('URGENT') ? 'checked' : '' %>
 />
 <span class="label-text tf-text-primary">Urgente</span>
 </label>
 <label class="label cursor-pointer justify-start gap-3 py-2 hover:bg-base-200/50 rounded-lg px-2 -mx-2 transition-colors">
 <input
 type="checkbox"
 name="priority"
 value="HIGH"
 class="checkbox checkbox-sm checkbox-warning"
 <%= filters.priority && filters.priority.includes('HIGH') ? 'checked' : '' %>
 />
 <span class="label-text tf-text-primary">Haute</span>
 </label>
 <label class="label cursor-pointer justify-start gap-3 py-2 hover:bg-base-200/50 rounded-lg px-2 -mx-2 transition-colors">
 <input
 type="checkbox"
 name="priority"
 value="MEDIUM"
 class="checkbox checkbox-sm checkbox-info"
 <%= filters.priority && filters.priority.includes('MEDIUM') ? 'checked' : '' %>
 />
 <span class="label-text tf-text-primary">Moyenne</span>
 </label>
 <label class="label cursor-pointer justify-start gap-3 py-2 hover:bg-base-200/50 rounded-lg px-2 -mx-2 transition-colors">
 <input
 type="checkbox"
 name="priority"
 value="LOW"
 class="checkbox checkbox-sm"
 <%= filters.priority && filters.priority.includes('LOW') ? 'checked' : '' %>
 />
 <span class="label-text tf-text-primary">Basse</span>
 </label>
 </div>
 </div>

 <!-- Assignee -->
 <% if (users && users.length > 0) { %>
 <div class="form-control">
 <label for="assigneeId" class="label mb-2">
 <span class="label-text font-semibold tf-text-primary">Assignée à</span>
 </label>
 <select id="assigneeId" name="assigneeId" class="select select-bordered select-sm w-full tf-input-padding-sm">
 <option value="">Tous</option>
 <% users.forEach(user => { %>
 <option value="<%= user.id %>" <%= filters.assigneeId === user.id ? 'selected' : '' %>>
 <%= user.name %>
 </option>
 <% }) %>
 </select>
 </div>
 <% } %>

 <!-- Due Date Filter -->
 <div class="form-control">
 <label class="label mb-2">
 <span class="label-text font-semibold tf-text-primary">Échéance</span>
 </label>
 <div class="tf-items">
 <label class="label cursor-pointer justify-start gap-3 py-2 hover:bg-base-200/50 rounded-lg px-2 -mx-2 transition-colors">
 <input
 type="radio"
 name="dueDateFilter"
 value=""
 class="radio radio-sm"
 <%= !filters.dueDateFilter ? 'checked' : '' %>
 />
 <span class="label-text tf-text-primary">Toutes</span>
 </label>
 <label class="label cursor-pointer justify-start gap-3 py-2 hover:bg-base-200/50 rounded-lg px-2 -mx-2 transition-colors">
 <input
 type="radio"
 name="dueDateFilter"
 value="overdue"
 class="radio radio-sm radio-error"
 <%= filters.dueDateFilter === 'overdue' ? 'checked' : '' %>
 />
 <span class="label-text tf-text-primary">En retard</span>
 </label>
 <label class="label cursor-pointer justify-start gap-3 py-2 hover:bg-base-200/50 rounded-lg px-2 -mx-2 transition-colors">
 <input
 type="radio"
 name="dueDateFilter"
 value="today"
 class="radio radio-sm radio-warning"
 <%= filters.dueDateFilter === 'today' ? 'checked' : '' %>
 />
 <span class="label-text tf-text-primary">Aujourd'hui</span>
 </label>
 <label class="label cursor-pointer justify-start gap-3 py-2 hover:bg-base-200/50 rounded-lg px-2 -mx-2 transition-colors">
 <input
 type="radio"
 name="dueDateFilter"
 value="week"
 class="radio radio-sm"
 <%= filters.dueDateFilter === 'week' ? 'checked' : '' %>
 />
 <span class="label-text tf-text-primary">Cette semaine</span>
 </label>
 </div>
 </div>

 <!-- Actions -->
 <div class="flex gap-3">
 <button type="submit" class="btn btn-primary btn-sm flex-1 gap-2">
 <span id="filter-indicator" class="htmx-indicator loading loading-spinner loading-xs"></span>
 Appliquer
 </button>
 <button type="reset"
 id="reset-filters-btn"
 class="btn btn-ghost btn-sm gap-2">
 Réinitialiser
 </button>
 </div>
 </form>
</div>
