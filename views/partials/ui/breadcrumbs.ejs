<%
/**
 * Breadcrumbs Component
 * Navigation breadcrumbs with structured data for SEO
 *
 * Props:
 * - items: Array<{ label, href?, icon?, active? }> - breadcrumb items
 * - containerClass: string (optional) - additional classes
 *
 * Usage:
 * <%- include('../partials/ui/breadcrumbs', {
 *   items: [
 *     { label: 'Home', href: '/' },
 *     { label: 'Tasks', href: '/tasks' },
 *     { label: 'Edit', active: true }
 *   ]
 * }) %>
 */

const items = typeof items !== 'undefined' ? items : [];
const containerClass = typeof containerClass !== 'undefined' ? containerClass : '';
%>

<div class="breadcrumbs text-sm <%= containerClass %>" role="navigation" aria-label="Breadcrumb">
  <ul>
    <% items.forEach(function(item, index) { %>
      <li <% if (item.active) { %>aria-current="page"<% } %>>
        <% if (item.href && !item.active) { %>
          <a href="<%= item.href %>" class="<%= item.active ? 'font-semibold' : '' %>">
            <% if (item.icon) { %><%- item.icon %><% } %>
            <%= item.label %>
          </a>
        <% } else { %>
          <span class="<%= item.active ? 'font-semibold' : '' %>">
            <% if (item.icon) { %><%- item.icon %><% } %>
            <%= item.label %>
          </span>
        <% } %>
      </li>
    <% }) %>
  </ul>
</div>
