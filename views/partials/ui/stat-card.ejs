<%
/**
 * Stat Card Component
 * Dashboard statistic card with icon, number, and label
 *
 * Props:
 *  - title: string - Card title/label
 *  - value: string|number - Main statistic value
 *  - icon: string - SVG icon path (d attribute)
 *  - color: string - Color variant (primary, secondary, accent, success, warning, error, info)
 *  - description: string (optional) - Additional description text
 *
 * Usage:
 *  <%- include('../partials/ui/stat-card', {
 *    title: 'Total Tasks',
 *    value: 42,
 *    icon: 'M9 5H7a2 2 0 00-2 2v12...',
 *    color: 'primary',
 *    description: '+12% from last month'
 *  }) %>
 */

const title = typeof title !== 'undefined' ? title : '';
const value = typeof value !== 'undefined' ? value : 0;
const icon = typeof icon !== 'undefined' ? icon : '';
const color = typeof color !== 'undefined' ? color : 'primary';
const description = typeof description !== 'undefined' ? description : '';
%>

<%- include('./surface', { variant: 'normal', hover: true, extraClass: 'border-l-4 border-' + color }) %>
  <div class="stat">
    <div class="stat-figure text-<%= color %>">
      <svg xmlns="http://www.w3.org/2000/svg" class="inline-block w-8 h-8 stroke-current" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= icon %>" />
      </svg>
    </div>
    <div class="stat-title"><%= title %></div>
    <div class="stat-value text-<%= color %>"><%= value %></div>
    <% if (description) { %>
      <div class="stat-desc"><%= description %></div>
    <% } %>
  </div>
</div>
