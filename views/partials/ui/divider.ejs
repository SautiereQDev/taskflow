<%
/**
 * Divider Component
 * Horizontal or vertical divider with optional text
 *
 * Props:
 * - text: string (optional) - text to display in divider
 * - orientation: string (default: 'horizontal') - 'horizontal' or 'vertical'
 * - variant: string (default: 'neutral') - 'neutral', 'primary', 'secondary', 'accent'
 * - containerClass: string (optional) - additional classes
 *
 * Usage:
 * <%- include('../partials/ui/divider', { text: 'OR' }) %>
 * <%- include('../partials/ui/divider', { orientation: 'vertical' }) %>
 */

const text = typeof text !== 'undefined' ? text : '';
const orientation = typeof orientation !== 'undefined' ? orientation : 'horizontal';
const variant = typeof variant !== 'undefined' ? variant : 'neutral';
const containerClass = typeof containerClass !== 'undefined' ? containerClass : '';

const variantClasses = {
  neutral: 'divider-neutral',
  primary: 'divider-primary',
  secondary: 'divider-secondary',
  accent: 'divider-accent'
};

const classes = [
  'divider',
  orientation === 'vertical' ? 'divider-vertical' : 'divider-horizontal',
  variantClasses[variant] || '',
  containerClass
].filter(Boolean).join(' ');
%>

<div class="<%= classes %>"><% if (text) { %><%= text %><% } %></div>
