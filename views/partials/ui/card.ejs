<!--
  Card Component (DaisyUI)

  Reusable card component with support for variants, slots, and actions.

  Parameters:
  - title (string, optional): Card title
  - body (string, optional): Card body content (use slot instead for complex content)
  - variant (string): Card style - 'default', 'bordered', 'compact', 'glass', 'side'
  - class (string): Additional CSS classes
  - id (string): Card ID attribute
  - clickable (boolean): Add hover effects for clickable cards
  - attrs (object): Additional HTML attributes

  Slots (use EJS body between include tags):
  - Default slot: Card content (between opening and closing tags)
  - If no slot content, uses body parameter

  Example - Basic card with title and body:
  include('./partials/ui/card', { title: 'User Profile', body: 'User information here' })

  Example - Card with slot content:
  const cardContent = `<h3 class="card-title">Custom Content</h3>`
  include('./partials/ui/card', { body: cardContent, variant: 'bordered' })

  Example - Compact card with actions:
  include('./partials/ui/card', {
    title: 'Task #123',
    body: 'Complete the documentation',
    variant: 'compact',
    class: 'bg-base-200'
  })

  Example - Glass card (for hero sections):
  include('./partials/ui/card', {
    title: 'Welcome',
    body: 'Get started with TaskFlow',
    variant: 'glass'
  })

  Example - Clickable card (hover effects):
  include('./partials/ui/card', {
    title: 'Feature',
    body: 'Click to learn more',
    clickable: true,
    attrs: { 'data-feature': 'automation' }
  })
-->
<%
// Default values
const _title = typeof locals.title !== 'undefined' ? locals.title : '';
const _body = typeof locals.body !== 'undefined' ? locals.body : '';
const _variant = typeof locals.variant !== 'undefined' ? locals.variant : 'default';
const _class = typeof locals.class !== 'undefined' ? locals.class : '';
const _id = typeof locals.id !== 'undefined' ? locals.id : '';
const _clickable = typeof locals.clickable !== 'undefined' ? locals.clickable : false;
const _attrs = typeof locals.attrs !== 'undefined' ? locals.attrs : {};

// Build DaisyUI card classes
const classes = [
  'card',
  _variant === 'bordered' ? 'card-bordered' : '',
  _variant === 'compact' ? 'card-compact' : '',
  _variant === 'glass' ? 'glass' : '',
  _variant === 'side' ? 'card-side' : '',
  _variant === 'default' ? 'bg-base-100 shadow-xl' : '',
  _clickable ? 'hover:shadow-2xl transition-shadow cursor-pointer' : '',
  _class
].filter(Boolean).join(' ');

// Build additional attributes string
let attrsString = '';
for (const [key, value] of Object.entries(_attrs)) {
  attrsString += ` ${key}="${value}"`;
}

const idAttr = _id ? ` id="${_id}"` : '';
%>

<div class="<%= classes %>"<%= idAttr %><%= attrsString %>>
  <div class="card-body">
    <% if (_title) { %>
      <h2 class="card-title"><%= _title %></h2>
    <% } %>
    <% if (_body) { %>
      <%- _body %>
    <% } %>
  </div>
</div>
