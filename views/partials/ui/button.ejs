<%
/**
 * Button Component (DaisyUI)
 *
 * Reusable button component with support for variants, sizes, states, and icons.
 *
 * @param {string} text - Button text content (required)
 * @param {string} [variant='primary'] - Button style: 'primary', 'secondary', 'accent', 'success', 'error', 'warning', 'info', 'ghost', 'link', 'neutral'
 * @param {string} [size='md'] - Button size: 'xs', 'sm', 'md', 'lg'
 * @param {string} [type='button'] - Button type: 'button', 'submit', 'reset'
 * @param {boolean} [disabled=false] - Disabled state
 * @param {boolean} [loading=false] - Loading state (shows spinner, disables button)
 * @param {boolean} [outline=false] - Use outline style
 * @param {boolean} [wide=false] - Full width button
 * @param {boolean} [block=false] - Display as block (full width)
 * @param {string} [icon=''] - Icon HTML (SVG or icon class)
 * @param {string} [iconPosition='left'] - Icon position: 'left', 'right'
 * @param {string} [href=''] - If provided, renders as <a> tag instead of <button>
 * @param {string} [class=''] - Additional CSS classes
 * @param {string} [id=''] - Button ID attribute
 * @param {object} [attrs={}] - Additional HTML attributes (e.g., { 'data-action': 'delete', 'hx-post': '/api/tasks' })
 *
 * @example Basic button
 * <%- include('./partials/ui/button', { text: 'Save', variant: 'primary' }) %>
 *
 * @example Button with icon
 * <%- include('./partials/ui/button', {
 *   text: 'Delete',
 *   variant: 'error',
 *   icon: '<svg>...</svg>',
 *   iconPosition: 'right'
 * }) %>
 *
 * @example Submit button with loading state
 * <%- include('./partials/ui/button', {
 *   text: 'Create Task',
 *   type: 'submit',
 *   variant: 'success',
 *   loading: isSubmitting
 * }) %>
 *
 * @example Link button (renders as <a>)
 * <%- include('./partials/ui/button', {
 *   text: 'Go to Dashboard',
 *   variant: 'link',
 *   href: '/dashboard'
 * }) %>
 *
 * @example Button with HTMX attributes
 * <%- include('./partials/ui/button', {
 *   text: 'Load More',
 *   variant: 'ghost',
 *   attrs: {
 *     'hx-get': '/api/tasks?page=2',
 *     'hx-target': '#task-list',
 *     'hx-swap': 'beforeend'
 *   }
 * }) %>
 */

// Default values
const _text = typeof locals.text !== 'undefined' ? locals.text : '';
const _variant = typeof locals.variant !== 'undefined' ? locals.variant : 'primary';
const _size = typeof locals.size !== 'undefined' ? locals.size : 'md';
const _type = typeof locals.type !== 'undefined' ? locals.type : 'button';
const _disabled = typeof locals.disabled !== 'undefined' ? locals.disabled : false;
const _loading = typeof locals.loading !== 'undefined' ? locals.loading : false;
const _outline = typeof locals.outline !== 'undefined' ? locals.outline : false;
const _wide = typeof locals.wide !== 'undefined' ? locals.wide : false;
const _block = typeof locals.block !== 'undefined' ? locals.block : false;
const _icon = typeof locals.icon !== 'undefined' ? locals.icon : '';
const _iconPosition = typeof locals.iconPosition !== 'undefined' ? locals.iconPosition : 'left';
const _href = typeof locals.href !== 'undefined' ? locals.href : '';
const _class = typeof locals.class !== 'undefined' ? locals.class : '';
const _id = typeof locals.id !== 'undefined' ? locals.id : '';
const _attrs = typeof locals.attrs !== 'undefined' ? locals.attrs : {};

// Build DaisyUI button classes
const classes = [
  'btn',
  _variant !== 'neutral' ? `btn-${_variant}` : '',
  _size !== 'md' ? `btn-${_size}` : '',
  _outline ? 'btn-outline' : '',
  _wide ? 'btn-wide' : '',
  _block ? 'btn-block' : '',
  _loading ? 'loading' : '',
  _class
].filter(Boolean).join(' ');

// Render button or link
const isLink = _href !== '';
const tag = isLink ? 'a' : 'button';
const typeAttr = isLink ? '' : ` type="${_type}"`;
const hrefAttr = isLink ? ` href="${_href}"` : '';
const disabledAttr = (_disabled || _loading) && !isLink ? ' disabled' : '';
const idAttr = _id ? ` id="${_id}"` : '';

// Build additional attributes string
let attrsString = '';
for (const [key, value] of Object.entries(_attrs)) {
  attrsString += ` ${key}="${value}"`;
}
%>

<<%= tag %> class="<%= classes %>"<%= typeAttr %><%= hrefAttr %><%= disabledAttr %><%= idAttr %><%= attrsString %>>
  <% if (_loading) { %>
    <span class="loading loading-spinner loading-xs"></span>
  <% } %>
  <% if (_icon && _iconPosition === 'left' && !_loading) { %>
    <%- _icon %>
  <% } %>
  <%= _text %>
  <% if (_icon && _iconPosition === 'right' && !_loading) { %>
    <%- _icon %>
  <% } %>
</<%= tag %>>
