<!--
  Modal Component (DaisyUI + Alpine.js)

  Reusable modal dialog component with Alpine.js integration.

  Parameters:
  - id (string, required): Modal unique ID (required for Alpine.js x-data)
  - title (string): Modal title
  - body (string, required): Modal body content
  - size (string): Modal size - 'default', 'large', 'fullscreen'
  - showClose (boolean): Show close button in header
  - closeOnBackdrop (boolean): Close modal when clicking backdrop
  - confirmText (string): Confirm button text (if provided, shows confirm button)
  - confirmVariant (string): Confirm button variant
  - cancelText (string): Cancel button text (if provided, shows cancel button)
  - onConfirm (string): JavaScript function to call on confirm (e.g., 'submitForm()')
  - onCancel (string): JavaScript function to call on cancel
  - class (string): Additional CSS classes for modal box

  Usage with Alpine.js:
  The modal uses Alpine.js x-show and x-transition for smooth animations.
  Control modal state with Alpine.js: @click="modalOpen = true"

  Example - Basic modal:
  <div x-data="{ modalOpen: false }">
    <button @click="modalOpen = true" class="btn">Open Modal</button>
    include('./partials/ui/modal', {
      id: 'example-modal',
      title: 'Confirm Action',
      body: 'Are you sure you want to continue?',
      confirmText: 'Yes',
      cancelText: 'No'
    })
  </div>

  Example - Large modal with custom action:
  include('./partials/ui/modal', {
    id: 'task-modal',
    title: 'Create Task',
    body: '<form>...</form>',
    size: 'large',
    confirmText: 'Create',
    onConfirm: 'createTask()',
    confirmVariant: 'success'
  })

  Example - Fullscreen modal:
  include('./partials/ui/modal', {
    id: 'preview-modal',
    title: 'Document Preview',
    body: '<iframe src="..."></iframe>',
    size: 'fullscreen',
    showClose: true
  })
-->
<%
// Default values
const _id = typeof locals.id !== 'undefined' ? locals.id : '';
const _title = typeof locals.title !== 'undefined' ? locals.title : '';
const _body = typeof locals.body !== 'undefined' ? locals.body : '';
const _size = typeof locals.size !== 'undefined' ? locals.size : 'default';
const _showClose = typeof locals.showClose !== 'undefined' ? locals.showClose : true;
const _closeOnBackdrop = typeof locals.closeOnBackdrop !== 'undefined' ? locals.closeOnBackdrop : true;
const _confirmText = typeof locals.confirmText !== 'undefined' ? locals.confirmText : '';
const _confirmVariant = typeof locals.confirmVariant !== 'undefined' ? locals.confirmVariant : 'primary';
const _cancelText = typeof locals.cancelText !== 'undefined' ? locals.cancelText : '';
const _onConfirm = typeof locals.onConfirm !== 'undefined' ? locals.onConfirm : '';
const _onCancel = typeof locals.onCancel !== 'undefined' ? locals.onCancel : '';
const _class = typeof locals.class !== 'undefined' ? locals.class : '';

// Validate required params
if (!_id) {
  throw new Error('Modal component requires an "id" parameter');
}

// Build modal box classes
const sizeClasses = {
  default: 'max-w-lg',
  large: 'max-w-3xl',
  fullscreen: 'w-11/12 max-w-5xl h-5/6'
};

const boxClasses = [
  'modal-box',
  sizeClasses[_size] || sizeClasses.default,
  _class
].filter(Boolean).join(' ');
%>

<!-- Modal Backdrop and Container (Alpine.js controlled) -->
<div x-show="modalOpen"
     x-transition:enter="transition ease-out duration-300"
     x-transition:enter-start="opacity-0"
     x-transition:enter-end="opacity-100"
     x-transition:leave="transition ease-in duration-200"
     x-transition:leave-start="opacity-100"
     x-transition:leave-end="opacity-0"
     class="fixed inset-0 z-50 overflow-y-auto"
     aria-labelledby="<%= _id %>-title"
     role="dialog"
     aria-modal="true"
     style="display: none;">

  <!-- Backdrop -->
  <div class="fixed inset-0 bg-black bg-opacity-50 transition-opacity"
       <% if (_closeOnBackdrop) { %>
       @click="modalOpen = false"
       <% } %>
       aria-hidden="true"></div>

  <!-- Modal Box -->
  <div class="flex items-center justify-center min-h-screen px-4 text-center sm:block sm:p-0">
    <!-- Centering trick -->
    <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

    <!-- Modal Content -->
    <div x-show="modalOpen"
         x-transition:enter="transition ease-out duration-300 transform"
         x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
         x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
         x-transition:leave="transition ease-in duration-200 transform"
         x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
         x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
         class="<%= boxClasses %> inline-block align-bottom bg-base-100 rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle"
         @click.away="<%= _closeOnBackdrop ? 'modalOpen = false' : '' %>">

      <!-- Header -->
      <% if (_title || _showClose) { %>
      <div class="flex items-start justify-between p-4 border-b border-base-300">
        <% if (_title) { %>
        <h3 class="text-lg font-semibold" id="<%= _id %>-title">
          <%= _title %>
        </h3>
        <% } %>
        <% if (_showClose) { %>
        <button type="button"
                class="btn btn-sm btn-ghost btn-circle"
                @click="modalOpen = false"
                aria-label="Close modal">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
        <% } %>
      </div>
      <% } %>

      <!-- Body -->
      <div class="p-6">
        <%- _body %>
      </div>

      <!-- Actions -->
      <% if (_confirmText || _cancelText) { %>
      <div class="modal-action p-4 border-t border-base-300">
        <% if (_cancelText) { %>
        <button type="button"
                class="btn btn-ghost"
                @click="<%= _onCancel ? _onCancel + '; ' : '' %>modalOpen = false">
          <%= _cancelText %>
        </button>
        <% } %>
        <% if (_confirmText) { %>
        <button type="button"
                class="btn btn-<%= _confirmVariant %>"
                @click="<%= _onConfirm ? _onConfirm + '; ' : '' %>modalOpen = false">
          <%= _confirmText %>
        </button>
        <% } %>
      </div>
      <% } %>
    </div>
  </div>
</div>
