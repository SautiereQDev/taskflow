<%
/**
 * Loading Spinner Component
 * Animated loading spinner with multiple styles
 *
 * Props:
 * - type: string (default: 'spinner') - 'spinner', 'dots', 'ring', 'ball', 'bars', 'infinity'
 * - size: string (default: 'md') - 'xs', 'sm', 'md', 'lg'
 * - variant: string (default: 'primary') - 'primary', 'secondary', 'accent', 'neutral'
 * - text: string (optional) - loading text to display
 * - containerClass: string (optional)
 *
 * Usage:
 * <%- include('../partials/ui/loading-spinner', { size: 'lg', text: 'Loading...' }) %>
 * <%- include('../partials/ui/loading-spinner', { type: 'dots', variant: 'accent' }) %>
 */

const type = typeof type !== 'undefined' ? type : 'spinner';
const size = typeof size !== 'undefined' ? size : 'md';
const variant = typeof variant !== 'undefined' ? variant : 'primary';
const text = typeof text !== 'undefined' ? text : '';
const containerClass = typeof containerClass !== 'undefined' ? containerClass : '';

const typeClasses = {
  spinner: 'loading-spinner',
  dots: 'loading-dots',
  ring: 'loading-ring',
  ball: 'loading-ball',
  bars: 'loading-bars',
  infinity: 'loading-infinity'
};

const sizeClasses = {
  xs: 'loading-xs',
  sm: 'loading-sm',
  md: 'loading-md',
  lg: 'loading-lg'
};

const variantClasses = {
  primary: 'text-primary',
  secondary: 'text-secondary',
  accent: 'text-accent',
  neutral: 'text-neutral'
};

const classes = [
  'loading',
  typeClasses[type] || 'loading-spinner',
  sizeClasses[size] || 'loading-md',
  variantClasses[variant] || 'text-primary'
].filter(Boolean).join(' ');
%>

<div class="flex items-center gap-2 <%= containerClass %>" role="status" aria-live="polite">
  <span class="<%= classes %>" aria-hidden="true"></span>
  <% if (text) { %>
    <span class="text-sm"><%= text %></span>
  <% } else { %>
    <span class="sr-only">Loading...</span>
  <% } %>
</div>
