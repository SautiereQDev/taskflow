<!--
  Checkbox/Toggle Component
  Reusable checkbox or toggle switch with label, help text, and full DaisyUI styling

  Example basic checkbox:
  include('partials/ui/forms/checkbox', {
    label: 'Remember me',
    name: 'rememberMe'
  })

  Example checkbox with required and error:
  include('partials/ui/forms/checkbox', {
    label: 'I accept the terms',
    name: 'acceptTerms',
    required: true,
    size: 'sm',
    error: errors.acceptTerms
  })

  Example toggle switch (settings):
  include('partials/ui/forms/checkbox', {
    label: 'Email notifications',
    name: 'emailNotifications',
    type: 'toggle',
    checked: user.emailNotifications,
    helpText: 'Receive email updates'
  })

  Example with HTMX (live save):
  include('partials/ui/forms/checkbox', {
    label: 'Dark mode',
    name: 'darkMode',
    type: 'toggle',
    checked: user.preferences.darkMode,
    hxPost: '/api/settings/theme',
    hxTrigger: 'change',
    hxSwap: 'none'
  })

  Parameters:
  - label: Checkbox/toggle label text (required)
  - name: Input name and ID attribute (required)
  - type: Type 'checkbox' or 'toggle' (default: 'checkbox')
  - checked: Initial checked state (default: false)
  - required: Mark field as required (default: false)
  - disabled: Disable checkbox/toggle (default: false)
  - value: Input value attribute (default: 'on')
  - error: Error message to display
  - helpText: Help text below checkbox
  - labelClass: Additional CSS classes for label text
  - size: Size 'xs', 'sm', 'md', 'lg' (default: 'md')
  - variant: Color variant (default: 'primary')
  - containerClass: Additional CSS classes for form-control container
  - inputClass: Additional CSS classes for input element
  - layout: Layout 'inline' or 'stacked' (default: 'inline')
  - justify: Flex justify 'start', 'center', 'end', 'between' (default: 'start')
  - hxPost: HTMX hx-post URL
  - hxGet: HTMX hx-get URL
  - hxTrigger: HTMX hx-trigger event
  - hxTarget: HTMX hx-target selector
  - hxSwap: HTMX hx-swap strategy
  - xModel: Alpine.js x-model binding
  - xOn: Alpine.js x-on event handler
  - ariaLabel: ARIA label for accessibility
  - ariaDescribedby: ARIA describedby attribute
-->

<%
// Required props
const _label = typeof locals.label !== 'undefined' ? locals.label : '';
const _name = typeof locals.name !== 'undefined' ? locals.name : '';

// Type and state
const _type = typeof locals.type !== 'undefined' ? locals.type : 'checkbox';
const _checked = typeof locals.checked !== 'undefined' ? locals.checked : false;
const _required = typeof locals.required !== 'undefined' ? locals.required : false;
const _disabled = typeof locals.disabled !== 'undefined' ? locals.disabled : false;
const _value = typeof locals.value !== 'undefined' ? locals.value : 'on';

// Validation and messages
const _error = typeof locals.error !== 'undefined' ? locals.error : '';
const _helpText = typeof locals.helpText !== 'undefined' ? locals.helpText : '';
const _labelClass = typeof locals.labelClass !== 'undefined' ? locals.labelClass : '';

// Styling
const _size = typeof locals.size !== 'undefined' ? locals.size : 'md';
const _variant = typeof locals.variant !== 'undefined' ? locals.variant : 'primary';
const _containerClass = typeof locals.containerClass !== 'undefined' ? locals.containerClass : '';
const _inputClass = typeof locals.inputClass !== 'undefined' ? locals.inputClass : '';
const _layout = typeof locals.layout !== 'undefined' ? locals.layout : 'inline';
const _justify = typeof locals.justify !== 'undefined' ? locals.justify : 'start';

// HTMX attributes
const _hxPost = typeof locals.hxPost !== 'undefined' ? locals.hxPost : '';
const _hxGet = typeof locals.hxGet !== 'undefined' ? locals.hxGet : '';
const _hxTrigger = typeof locals.hxTrigger !== 'undefined' ? locals.hxTrigger : '';
const _hxTarget = typeof locals.hxTarget !== 'undefined' ? locals.hxTarget : '';
const _hxSwap = typeof locals.hxSwap !== 'undefined' ? locals.hxSwap : '';

// Alpine.js attributes
const _xModel = typeof locals.xModel !== 'undefined' ? locals.xModel : '';
const _xOn = typeof locals.xOn !== 'undefined' ? locals.xOn : '';

// Accessibility
const _ariaLabel = typeof locals.ariaLabel !== 'undefined' ? locals.ariaLabel : '';
const _ariaDescribedby = typeof locals.ariaDescribedby !== 'undefined' ? locals.ariaDescribedby : '';

// Build size classes
const sizeClasses = {
  xs: _type === 'toggle' ? 'toggle-xs' : 'checkbox-xs',
  sm: _type === 'toggle' ? 'toggle-sm' : 'checkbox-sm',
  md: '',
  lg: _type === 'toggle' ? 'toggle-lg' : 'checkbox-lg'
};

// Build variant classes
const variantClasses = {
  primary: _type === 'toggle' ? 'toggle-primary' : 'checkbox-primary',
  secondary: _type === 'toggle' ? 'toggle-secondary' : 'checkbox-secondary',
  accent: _type === 'toggle' ? 'toggle-accent' : 'checkbox-accent',
  success: _type === 'toggle' ? 'toggle-success' : 'checkbox-success',
  warning: _type === 'toggle' ? 'toggle-warning' : 'checkbox-warning',
  error: _type === 'toggle' ? 'toggle-error' : 'checkbox-error',
  info: _type === 'toggle' ? 'toggle-info' : 'checkbox-info'
};

// Build justify classes
const justifyClasses = {
  start: 'justify-start',
  center: 'justify-center',
  end: 'justify-end',
  between: 'justify-between'
};

// Build input classes
const baseClass = _type === 'toggle' ? 'toggle' : 'checkbox';
const checkboxClasses = [
  baseClass,
  sizeClasses[_size] || '',
  variantClasses[_variant] || (_type === 'toggle' ? 'toggle-primary' : 'checkbox-primary'),
  _error ? (_type === 'toggle' ? 'toggle-error' : 'checkbox-error') : '',
  _inputClass
].filter(Boolean).join(' ');

// Generate unique IDs
const inputId = _name;
const helpTextId = _helpText || _error ? `${_name}-help` : '';
const errorId = _error ? `${_name}-error` : '';
%>

<div class="form-control <%= _containerClass %>">
  <label class="label cursor-pointer <%= justifyClasses[_justify] || 'justify-start' %> <%= _layout === 'inline' ? 'tf-gap-sm' : 'flex-col items-start gap-2' %>">
    <!-- Checkbox/Toggle Input -->
    <input
      type="checkbox"
      id="<%= inputId %>"
      name="<%= _name %>"
      value="<%= _value %>"
      class="<%= checkboxClasses %>"
      <% if (_checked) { %>checked<% } %>
      <% if (_required) { %>required<% } %>
      <% if (_disabled) { %>disabled<% } %>
      <% if (_hxPost) { %>hx-post="<%= _hxPost %>"<% } %>
      <% if (_hxGet) { %>hx-get="<%= _hxGet %>"<% } %>
      <% if (_hxTrigger) { %>hx-trigger="<%= _hxTrigger %>"<% } %>
      <% if (_hxTarget) { %>hx-target="<%= _hxTarget %>"<% } %>
      <% if (_hxSwap) { %>hx-swap="<%= _hxSwap %>"<% } %>
      <% if (_xModel) { %>x-model="<%= _xModel %>"<% } %>
      <% if (_xOn) { %>x-on:<%= _xOn %><% } %>
      <% if (_ariaLabel) { %>aria-label="<%= _ariaLabel %>"<% } %>
      <% if (_ariaDescribedby || helpTextId || errorId) { %>
        aria-describedby="<%= _ariaDescribedby || helpTextId || errorId %>"
      <% } %>
    />

    <!-- Label Text -->
    <span class="label-text <%= _labelClass %>">
      <%= _label %>
      <% if (_required && !_disabled) { %>
        <span class="text-error">*</span>
      <% } %>
    </span>
  </label>

  <!-- Help Text / Error Message -->
  <% if (_error) { %>
    <label class="label">
      <span class="label-text-alt text-error" id="<%= errorId %>">
        <%= _error %>
      </span>
    </label>
  <% } else if (_helpText) { %>
    <label class="label">
      <span class="label-text-alt tf-text-muted" id="<%= helpTextId %>">
        <%= _helpText %>
      </span>
    </label>
  <% } %>
</div>
