<%
/**
 * Form Field Component
 * Complete form field with label, input, error message
 *
 * Props:
 *  - label: string - Field label
 *  - name: string - Input name attribute
 *  - type: string - Input type (default: 'text')
 *  - value: string (optional) - Input value
 *  - error: string (optional) - Error message
 *  - required: boolean (default: false)
 *  - placeholder: string (optional)
 *  - helpText: string (optional) - Help text below input
 *
 * Usage:
 *  <%- include('../partials/ui/forms/field', {
 *    label: 'Email',
 *    name: 'email',
 *    type: 'email',
 *    required: true,
 *    error: errors.email
 *  }) %>
 */

const label = typeof label !== 'undefined' ? label : '';
const name = typeof name !== 'undefined' ? name : '';
const type = typeof type !== 'undefined' ? type : 'text';
const value = typeof value !== 'undefined' ? value : '';
const error = typeof error !== 'undefined' ? error : '';
const required = typeof required !== 'undefined' ? required : false;
const placeholder = typeof placeholder !== 'undefined' ? placeholder : '';
const helpText = typeof helpText !== 'undefined' ? helpText : '';
const disabled = typeof disabled !== 'undefined' ? disabled : false;
%>

<div class="form-control w-full">
  <label class="label">
    <span class="label-text font-semibold">
      <%= label %>
      <% if (required) { %>
        <span class="text-error">*</span>
      <% } %>
    </span>
  </label>

  <input
    type="<%= type %>"
    name="<%= name %>"
    id="<%= name %>"
    value="<%= value %>"
    placeholder="<%= placeholder %>"
    class="input-bg-base-200 border border-base-content/10 shadow-md input w-full <%= error ? 'input-error' : '' %>"
    <%= required ? 'required' : '' %>
    <%= disabled ? 'disabled' : '' %>
  />

  <% if (error) { %>
    <label class="label">
      <span class="label-text-alt text-error"><%= error %></span>
    </label>
  <% } else if (helpText) { %>
    <label class="label">
      <span class="label-text-alt opacity-70"><%= helpText %></span>
    </label>
  <% } %>
</div>
