<%
/**
 * Input Field Component
 * Reusable text input component with full validation, character counter, help text, and Alpine.js/HTMX support
 *
 * @component
 * @example
 * <%- include('../../partials/ui/forms/input', {
 *   label: 'Email Address',
 *   name: 'email',
 *   type: 'email',
 *   required: true,
 *   placeholder: 'name@example.com',
 *   helpText: 'We will never share your email',
 *   error: errors.email
 * }) %>
 *
 * @example With character counter (Alpine.js)
 * <%- include('../../partials/ui/forms/input', {
 *   label: 'Task Title',
 *   name: 'title',
 *   value: task.title,
 *   maxlength: 200,
 *   showCounter: true,
 *   counterModel: 'title',
 *   required: true
 * }) %>
 *
 * @example With HTMX validation
 * <%- include('../../partials/ui/forms/input', {
 *   label: 'Username',
 *   name: 'username',
 *   hxPost: '/api/validate-username',
 *   hxTrigger: 'keyup changed delay:500ms',
 *   hxTarget: '#username-validation',
 *   hxSwap: 'innerHTML'
 * }) %>
 *
 * @param {string} label - Field label text
 * @param {string} name - Input name and ID attribute
 * @param {string} [type='text'] - Input type: 'text', 'email', 'password', 'number', 'tel', 'url', 'date', 'datetime-local', 'time', 'search'
 * @param {string} [value=''] - Input value (use for edit forms)
 * @param {string} [placeholder=''] - Placeholder text
 * @param {boolean} [required=false] - Mark field as required
 * @param {boolean} [disabled=false] - Disable input
 * @param {boolean} [readonly=false] - Make input read-only
 * @param {boolean} [autofocus=false] - Auto-focus input on page load
 * @param {string} [autocomplete=''] - HTML autocomplete attribute value
 *
 * @param {string} [error=''] - Error message to display (shows error state)
 * @param {string} [helpText=''] - Help text below input (hidden if error present)
 * @param {string} [labelAlt=''] - Alternative label text (right side, e.g., "Optional")
 *
 * @param {number} [minlength] - Minimum character length
 * @param {number} [maxlength] - Maximum character length
 * @param {number} [min] - Minimum value (for number/date types)
 * @param {number} [max] - Maximum value (for number/date types)
 * @param {number} [step] - Step increment (for number type)
 * @param {string} [pattern] - Regex pattern for validation
 *
 * @param {boolean} [showCounter=false] - Show character counter (requires maxlength and counterModel)
 * @param {string} [counterModel=''] - Alpine.js x-model variable name for counter (e.g., 'title')
 *
 * @param {string} [inputClass=''] - Additional CSS classes for input element
 * @param {string} [containerClass=''] - Additional CSS classes for form-control container
 * @param {string} [size='md'] - Input size: 'xs', 'sm', 'md', 'lg'
 * @param {string} [variant='bordered'] - Input variant: 'bordered', 'ghost', 'primary', 'secondary'
 *
 * @param {string} [hxPost=''] - HTMX hx-post URL
 * @param {string} [hxGet=''] - HTMX hx-get URL
 * @param {string} [hxTrigger=''] - HTMX hx-trigger event
 * @param {string} [hxTarget=''] - HTMX hx-target selector
 * @param {string} [hxSwap=''] - HTMX hx-swap strategy
 * @param {string} [hxIndicator=''] - HTMX loading indicator selector
 *
 * @param {string} [xModel=''] - Alpine.js x-model binding
 * @param {string} [xOn=''] - Alpine.js x-on event handler (e.g., 'input: handleInput($event)')
 *
 * @param {string} [ariaLabel=''] - ARIA label for accessibility
 * @param {string} [ariaDescribedby=''] - ARIA describedby attribute
 */

// Required props
const _label = typeof locals.label !== 'undefined' ? locals.label : '';
const _name = typeof locals.name !== 'undefined' ? locals.name : '';

// Input type and basic attributes
const _type = typeof locals.type !== 'undefined' ? locals.type : 'text';
const _value = typeof locals.value !== 'undefined' ? locals.value : '';
const _placeholder = typeof locals.placeholder !== 'undefined' ? locals.placeholder : '';
const _required = typeof locals.required !== 'undefined' ? locals.required : false;
const _disabled = typeof locals.disabled !== 'undefined' ? locals.disabled : false;
const _readonly = typeof locals.readonly !== 'undefined' ? locals.readonly : false;
const _autofocus = typeof locals.autofocus !== 'undefined' ? locals.autofocus : false;
const _autocomplete = typeof locals.autocomplete !== 'undefined' ? locals.autocomplete : '';

// Validation and messages
const _error = typeof locals.error !== 'undefined' ? locals.error : '';
const _helpText = typeof locals.helpText !== 'undefined' ? locals.helpText : '';
const _labelAlt = typeof locals.labelAlt !== 'undefined' ? locals.labelAlt : '';

// Validation constraints
const _minlength = typeof locals.minlength !== 'undefined' ? locals.minlength : null;
const _maxlength = typeof locals.maxlength !== 'undefined' ? locals.maxlength : null;
const _min = typeof locals.min !== 'undefined' ? locals.min : null;
const _max = typeof locals.max !== 'undefined' ? locals.max : null;
const _step = typeof locals.step !== 'undefined' ? locals.step : null;
const _pattern = typeof locals.pattern !== 'undefined' ? locals.pattern : '';

// Character counter (Alpine.js)
const _showCounter = typeof locals.showCounter !== 'undefined' ? locals.showCounter : false;
const _counterModel = typeof locals.counterModel !== 'undefined' ? locals.counterModel : '';

// Styling
const _inputClass = typeof locals.inputClass !== 'undefined' ? locals.inputClass : '';
const _containerClass = typeof locals.containerClass !== 'undefined' ? locals.containerClass : '';
const _size = typeof locals.size !== 'undefined' ? locals.size : 'md';
const _variant = typeof locals.variant !== 'undefined' ? locals.variant : 'bordered';

// HTMX attributes
const _hxPost = typeof locals.hxPost !== 'undefined' ? locals.hxPost : '';
const _hxGet = typeof locals.hxGet !== 'undefined' ? locals.hxGet : '';
const _hxTrigger = typeof locals.hxTrigger !== 'undefined' ? locals.hxTrigger : '';
const _hxTarget = typeof locals.hxTarget !== 'undefined' ? locals.hxTarget : '';
const _hxSwap = typeof locals.hxSwap !== 'undefined' ? locals.hxSwap : '';
const _hxIndicator = typeof locals.hxIndicator !== 'undefined' ? locals.hxIndicator : '';

// Alpine.js attributes
const _xModel = typeof locals.xModel !== 'undefined' ? locals.xModel : '';
const _xOn = typeof locals.xOn !== 'undefined' ? locals.xOn : '';

// Accessibility
const _ariaLabel = typeof locals.ariaLabel !== 'undefined' ? locals.ariaLabel : '';
const _ariaDescribedby = typeof locals.ariaDescribedby !== 'undefined' ? locals.ariaDescribedby : '';

// Build input classes
const sizeClasses = {
  xs: 'input-xs',
  sm: 'input-sm',
  md: '',
  lg: 'input-lg'
};

const variantClasses = {
  bordered: 'input-bordered',
  ghost: 'input-ghost',
  primary: 'input-primary',
  secondary: 'input-secondary'
};

const inputClasses = [
  'input',
  'w-full',
  'tf-input-padding',
  sizeClasses[_size] || '',
  variantClasses[_variant] || 'input-bordered',
  _error ? 'input-error' : '',
  _inputClass
].filter(Boolean).join(' ');

// Generate unique IDs
const inputId = _name;
const helpTextId = _helpText || _error ? `${_name}-help` : '';
const errorId = _error ? `${_name}-error` : '';
%>

<div class="form-control w-full <%= _containerClass %>">
  <!-- Label -->
  <label class="label" for="<%= inputId %>">
    <span class="label-text font-semibold tf-text-primary">
      <%= _label %>
      <% if (_required) { %>
        <span class="text-error">*</span>
      <% } %>
    </span>
    <% if (_labelAlt || (_showCounter && _counterModel && _maxlength)) { %>
      <span class="label-text-alt tf-text-muted">
        <% if (_showCounter && _counterModel && _maxlength) { %>
          <span x-text="`${<%= _counterModel %>.length}/<%= _maxlength %>`">0/<%= _maxlength %></span>
        <% } else if (_labelAlt) { %>
          <%= _labelAlt %>
        <% } %>
      </span>
    <% } %>
  </label>

  <!-- Input -->
  <input
    type="<%= _type %>"
    id="<%= inputId %>"
    name="<%= _name %>"
    <% if (_value) { %>value="<%= _value %>"<% } %>
    <% if (_placeholder) { %>placeholder="<%= _placeholder %>"<% } %>
    class="<%= inputClasses %>"
    <% if (_required) { %>required<% } %>
    <% if (_disabled) { %>disabled<% } %>
    <% if (_readonly) { %>readonly<% } %>
    <% if (_autofocus) { %>autofocus<% } %>
    <% if (_autocomplete) { %>autocomplete="<%= _autocomplete %>"<% } %>
    <% if (_minlength) { %>minlength="<%= _minlength %>"<% } %>
    <% if (_maxlength) { %>maxlength="<%= _maxlength %>"<% } %>
    <% if (_min !== null) { %>min="<%= _min %>"<% } %>
    <% if (_max !== null) { %>max="<%= _max %>"<% } %>
    <% if (_step !== null) { %>step="<%= _step %>"<% } %>
    <% if (_pattern) { %>pattern="<%= _pattern %>"<% } %>
    <% if (_hxPost) { %>hx-post="<%= _hxPost %>"<% } %>
    <% if (_hxGet) { %>hx-get="<%= _hxGet %>"<% } %>
    <% if (_hxTrigger) { %>hx-trigger="<%= _hxTrigger %>"<% } %>
    <% if (_hxTarget) { %>hx-target="<%= _hxTarget %>"<% } %>
    <% if (_hxSwap) { %>hx-swap="<%= _hxSwap %>"<% } %>
    <% if (_hxIndicator) { %>hx-indicator="<%= _hxIndicator %>"<% } %>
    <% if (_xModel) { %>x-model="<%= _xModel %>"<% } %>
    <% if (_xOn) { %>x-on:<%= _xOn %><% } %>
    <% if (_ariaLabel) { %>aria-label="<%= _ariaLabel %>"<% } %>
    <% if (_ariaDescribedby || helpTextId || errorId) { %>
      aria-describedby="<%= _ariaDescribedby || helpTextId || errorId %>"
    <% } %>
  />

  <!-- Help Text / Error Message -->
  <% if (_error) { %>
    <label class="label">
      <span class="label-text-alt text-error" id="<%= errorId %>">
        <%= _error %>
      </span>
    </label>
  <% } else if (_helpText) { %>
    <label class="label">
      <span class="label-text-alt tf-text-muted" id="<%= helpTextId %>">
        <%= _helpText %>
      </span>
    </label>
  <% } %>
</div>
