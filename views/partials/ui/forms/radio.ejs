<!--
  Radio Button Component
  Single radio button with label and DaisyUI styling

  Example - Basic radio:
  include('../../partials/ui/forms/radio', {
    label: 'Option A',
    name: 'choice',
    value: 'a',
    checked: true
  })

  Example - Radio with help text:
  include('../../partials/ui/forms/radio', {
    label: 'Premium Plan',
    name: 'plan',
    value: 'premium',
    helpText: '$29/month - Unlimited access',
    size: 'lg'
  })

  Example - With Alpine.js binding:
  include('../../partials/ui/forms/radio', {
    label: 'Dark Theme',
    name: 'theme',
    value: 'dark',
    xModel: 'selectedTheme',
    checked: theme === 'dark'
  })

  Parameters:
  - label (string): Radio button label text
  - name (string): Input name attribute (shared across radio group)
  - value (string): Input value attribute (unique per radio)
  - checked (boolean): Initial checked state
  - required (boolean): Mark field as required
  - disabled (boolean): Disable radio button
  - error (string): Error message to display
  - helpText (string): Help text below radio
  - labelClass (string): Additional CSS classes for label text
  - size (string): Size - 'xs', 'sm', 'md', 'lg'
  - variant (string): Color variant - 'primary', 'secondary', 'accent', 'success', 'warning', 'error', 'info'
  - containerClass (string): Additional CSS classes for form-control container
  - inputClass (string): Additional CSS classes for input element
  - layout (string): Layout - 'inline' (label right) or 'stacked' (label below)
  - justify (string): Flex justify - 'start', 'center', 'end', 'between'
  - hxPost (string): HTMX hx-post URL
  - hxGet (string): HTMX hx-get URL
  - hxTrigger (string): HTMX hx-trigger event
  - hxTarget (string): HTMX hx-target selector
  - hxSwap (string): HTMX hx-swap strategy
  - xModel (string): Alpine.js x-model binding
  - xOn (string): Alpine.js x-on event handler
  - ariaLabel (string): ARIA label for accessibility
  - ariaDescribedby (string): ARIA describedby attribute
-->
<%
// Required props
const _label = typeof locals.label !== 'undefined' ? locals.label : '';
const _name = typeof locals.name !== 'undefined' ? locals.name : '';
const _value = typeof locals.value !== 'undefined' ? locals.value : '';

// State
const _checked = typeof locals.checked !== 'undefined' ? locals.checked : false;
const _required = typeof locals.required !== 'undefined' ? locals.required : false;
const _disabled = typeof locals.disabled !== 'undefined' ? locals.disabled : false;

// Validation and messages
const _error = typeof locals.error !== 'undefined' ? locals.error : '';
const _helpText = typeof locals.helpText !== 'undefined' ? locals.helpText : '';
const _labelClass = typeof locals.labelClass !== 'undefined' ? locals.labelClass : '';

// Styling
const _size = typeof locals.size !== 'undefined' ? locals.size : 'md';
const _variant = typeof locals.variant !== 'undefined' ? locals.variant : 'primary';
const _containerClass = typeof locals.containerClass !== 'undefined' ? locals.containerClass : '';
const _inputClass = typeof locals.inputClass !== 'undefined' ? locals.inputClass : '';
const _layout = typeof locals.layout !== 'undefined' ? locals.layout : 'inline';
const _justify = typeof locals.justify !== 'undefined' ? locals.justify : 'start';

// HTMX attributes
const _hxPost = typeof locals.hxPost !== 'undefined' ? locals.hxPost : '';
const _hxGet = typeof locals.hxGet !== 'undefined' ? locals.hxGet : '';
const _hxTrigger = typeof locals.hxTrigger !== 'undefined' ? locals.hxTrigger : '';
const _hxTarget = typeof locals.hxTarget !== 'undefined' ? locals.hxTarget : '';
const _hxSwap = typeof locals.hxSwap !== 'undefined' ? locals.hxSwap : '';

// Alpine.js attributes
const _xModel = typeof locals.xModel !== 'undefined' ? locals.xModel : '';
const _xOn = typeof locals.xOn !== 'undefined' ? locals.xOn : '';

// Accessibility
const _ariaLabel = typeof locals.ariaLabel !== 'undefined' ? locals.ariaLabel : '';
const _ariaDescribedby = typeof locals.ariaDescribedby !== 'undefined' ? locals.ariaDescribedby : '';

// Build size classes
const sizeClasses = {
  xs: 'radio-xs',
  sm: 'radio-sm',
  md: '',
  lg: 'radio-lg'
};

// Build variant classes
const variantClasses = {
  primary: 'radio-primary',
  secondary: 'radio-secondary',
  accent: 'radio-accent',
  success: 'radio-success',
  warning: 'radio-warning',
  error: 'radio-error',
  info: 'radio-info'
};

// Build justify classes
const justifyClasses = {
  start: 'justify-start',
  center: 'justify-center',
  end: 'justify-end',
  between: 'justify-between'
};

// Build input classes
const radioClasses = [
  'radio',
  sizeClasses[_size] || '',
  variantClasses[_variant] || 'radio-primary',
  _error ? 'radio-error' : '',
  _inputClass
].filter(Boolean).join(' ');

// Generate unique ID
const inputId = `${_name}-${_value}`;
const helpTextId = _helpText || _error ? `${inputId}-help` : '';
const errorId = _error ? `${inputId}-error` : '';
%>

<div class="form-control <%= _containerClass %>">
  <label class="label cursor-pointer <%= justifyClasses[_justify] || 'justify-start' %> <%= _layout === 'inline' ? 'tf-gap-sm' : 'flex-col items-start gap-2' %>">
    <!-- Radio Input -->
    <input
      type="radio"
      id="<%= inputId %>"
      name="<%= _name %>"
      value="<%= _value %>"
      class="<%= radioClasses %>"
      <% if (_checked) { %>checked<% } %>
      <% if (_required) { %>required<% } %>
      <% if (_disabled) { %>disabled<% } %>
      <% if (_hxPost) { %>hx-post="<%= _hxPost %>"<% } %>
      <% if (_hxGet) { %>hx-get="<%= _hxGet %>"<% } %>
      <% if (_hxTrigger) { %>hx-trigger="<%= _hxTrigger %>"<% } %>
      <% if (_hxTarget) { %>hx-target="<%= _hxTarget %>"<% } %>
      <% if (_hxSwap) { %>hx-swap="<%= _hxSwap %>"<% } %>
      <% if (_xModel) { %>x-model="<%= _xModel %>"<% } %>
      <% if (_xOn) { %>x-on:<%= _xOn %><% } %>
      <% if (_ariaLabel) { %>aria-label="<%= _ariaLabel %>"<% } %>
      <% if (_ariaDescribedby || helpTextId || errorId) { %>
        aria-describedby="<%= _ariaDescribedby || helpTextId || errorId %>"
      <% } %>
    />

    <!-- Label Text -->
    <span class="label-text <%= _labelClass %>">
      <%= _label %>
      <% if (_required && !_disabled) { %>
        <span class="text-error">*</span>
      <% } %>
    </span>
  </label>

  <!-- Help Text / Error Message -->
  <% if (_error) { %>
    <label class="label">
      <span class="label-text-alt text-error" id="<%= errorId %>">
        <%= _error %>
      </span>
    </label>
  <% } else if (_helpText) { %>
    <label class="label">
      <span class="label-text-alt tf-text-muted" id="<%= helpTextId %>">
        <%= _helpText %>
      </span>
    </label>
  <% } %>
</div>
