<%
/**
 * Radio Button Component
 * Single radio button with label and DaisyUI styling
 *
 * @component
 * @example Basic radio
 * <%- include('../../partials/ui/forms/radio', {
 *   label: 'Option A',
 *   name: 'choice',
 *   value: 'a',
 *   checked: true
 * }) %>
 *
 * @example Radio with help text
 * <%- include('../../partials/ui/forms/radio', {
 *   label: 'Premium Plan',
 *   name: 'plan',
 *   value: 'premium',
 *   helpText: '$29/month - Unlimited access',
 *   size: 'lg'
 * }) %>
 *
 * @example With Alpine.js binding
 * <%- include('../../partials/ui/forms/radio', {
 *   label: 'Dark Theme',
 *   name: 'theme',
 *   value: 'dark',
 *   xModel: 'selectedTheme',
 *   checked: theme === 'dark'
 * }) %>
 *
 * @param {string} label - Radio button label text
 * @param {string} name - Input name attribute (shared across radio group)
 * @param {string} value - Input value attribute (unique per radio)
 * @param {boolean} [checked=false] - Initial checked state
 * @param {boolean} [required=false] - Mark field as required
 * @param {boolean} [disabled=false] - Disable radio button
 *
 * @param {string} [error=''] - Error message to display
 * @param {string} [helpText=''] - Help text below radio
 * @param {string} [labelClass=''] - Additional CSS classes for label text
 *
 * @param {string} [size='md'] - Size: 'xs', 'sm', 'md', 'lg'
 * @param {string} [variant='primary'] - Color variant: 'primary', 'secondary', 'accent', 'success', 'warning', 'error', 'info'
 *
 * @param {string} [containerClass=''] - Additional CSS classes for form-control container
 * @param {string} [inputClass=''] - Additional CSS classes for input element
 * @param {string} [layout='inline'] - Layout: 'inline' (label right) or 'stacked' (label below)
 * @param {string} [justify='start'] - Flex justify: 'start', 'center', 'end', 'between'
 *
 * @param {string} [hxPost=''] - HTMX hx-post URL
 * @param {string} [hxGet=''] - HTMX hx-get URL
 * @param {string} [hxTrigger=''] - HTMX hx-trigger event
 * @param {string} [hxTarget=''] - HTMX hx-target selector
 * @param {string} [hxSwap=''] - HTMX hx-swap strategy
 *
 * @param {string} [xModel=''] - Alpine.js x-model binding
 * @param {string} [xOn=''] - Alpine.js x-on event handler
 *
 * @param {string} [ariaLabel=''] - ARIA label for accessibility
 * @param {string} [ariaDescribedby=''] - ARIA describedby attribute
 */

// Required props
const label = typeof label !== 'undefined' ? label : '';
const name = typeof name !== 'undefined' ? name : '';
const value = typeof value !== 'undefined' ? value : '';

// State
const checked = typeof checked !== 'undefined' ? checked : false;
const required = typeof required !== 'undefined' ? required : false;
const disabled = typeof disabled !== 'undefined' ? disabled : false;

// Validation and messages
const error = typeof error !== 'undefined' ? error : '';
const helpText = typeof helpText !== 'undefined' ? helpText : '';
const labelClass = typeof labelClass !== 'undefined' ? labelClass : '';

// Styling
const size = typeof size !== 'undefined' ? size : 'md';
const variant = typeof variant !== 'undefined' ? variant : 'primary';
const containerClass = typeof containerClass !== 'undefined' ? containerClass : '';
const inputClass = typeof inputClass !== 'undefined' ? inputClass : '';
const layout = typeof layout !== 'undefined' ? layout : 'inline';
const justify = typeof justify !== 'undefined' ? justify : 'start';

// HTMX attributes
const hxPost = typeof hxPost !== 'undefined' ? hxPost : '';
const hxGet = typeof hxGet !== 'undefined' ? hxGet : '';
const hxTrigger = typeof hxTrigger !== 'undefined' ? hxTrigger : '';
const hxTarget = typeof hxTarget !== 'undefined' ? hxTarget : '';
const hxSwap = typeof hxSwap !== 'undefined' ? hxSwap : '';

// Alpine.js attributes
const xModel = typeof xModel !== 'undefined' ? xModel : '';
const xOn = typeof xOn !== 'undefined' ? xOn : '';

// Accessibility
const ariaLabel = typeof ariaLabel !== 'undefined' ? ariaLabel : '';
const ariaDescribedby = typeof ariaDescribedby !== 'undefined' ? ariaDescribedby : '';

// Build size classes
const sizeClasses = {
  xs: 'radio-xs',
  sm: 'radio-sm',
  md: '',
  lg: 'radio-lg'
};

// Build variant classes
const variantClasses = {
  primary: 'radio-primary',
  secondary: 'radio-secondary',
  accent: 'radio-accent',
  success: 'radio-success',
  warning: 'radio-warning',
  error: 'radio-error',
  info: 'radio-info'
};

// Build justify classes
const justifyClasses = {
  start: 'justify-start',
  center: 'justify-center',
  end: 'justify-end',
  between: 'justify-between'
};

// Build input classes
const radioClasses = [
  'radio',
  sizeClasses[size] || '',
  variantClasses[variant] || 'radio-primary',
  error ? 'radio-error' : '',
  inputClass
].filter(Boolean).join(' ');

// Generate unique ID
const inputId = `${name}-${value}`;
const helpTextId = helpText || error ? `${inputId}-help` : '';
const errorId = error ? `${inputId}-error` : '';
%>

<div class="form-control <%= containerClass %>">
  <label class="label cursor-pointer <%= justifyClasses[justify] || 'justify-start' %> <%= layout === 'inline' ? 'tf-gap-sm' : 'flex-col items-start gap-2' %>">
    <!-- Radio Input -->
    <input
      type="radio"
      id="<%= inputId %>"
      name="<%= name %>"
      value="<%= value %>"
      class="<%= radioClasses %>"
      <% if (checked) { %>checked<% } %>
      <% if (required) { %>required<% } %>
      <% if (disabled) { %>disabled<% } %>
      <% if (hxPost) { %>hx-post="<%= hxPost %>"<% } %>
      <% if (hxGet) { %>hx-get="<%= hxGet %>"<% } %>
      <% if (hxTrigger) { %>hx-trigger="<%= hxTrigger %>"<% } %>
      <% if (hxTarget) { %>hx-target="<%= hxTarget %>"<% } %>
      <% if (hxSwap) { %>hx-swap="<%= hxSwap %>"<% } %>
      <% if (xModel) { %>x-model="<%= xModel %>"<% } %>
      <% if (xOn) { %>x-on:<%= xOn %><% } %>
      <% if (ariaLabel) { %>aria-label="<%= ariaLabel %>"<% } %>
      <% if (ariaDescribedby || helpTextId || errorId) { %>
        aria-describedby="<%= ariaDescribedby || helpTextId || errorId %>"
      <% } %>
    />

    <!-- Label Text -->
    <span class="label-text <%= labelClass %>">
      <%= label %>
      <% if (required && !disabled) { %>
        <span class="text-error">*</span>
      <% } %>
    </span>
  </label>

  <!-- Help Text / Error Message -->
  <% if (error) { %>
    <label class="label">
      <span class="label-text-alt text-error" id="<%= errorId %>">
        <%= error %>
      </span>
    </label>
  <% } else if (helpText) { %>
    <label class="label">
      <span class="label-text-alt tf-text-muted" id="<%= helpTextId %>">
        <%= helpText %>
      </span>
    </label>
  <% } %>
</div>
