<%
/**
 * Textarea Field Component
 * Multi-line text input with character counter support
 *
 * Props:
 * - label: string - Field label
 * - name: string - Textarea name attribute
 * - value: string (optional) - Textarea value
 * - error: string (optional) - Error message
 * - helpText: string (optional) - Help text below textarea
 * - required: boolean (default: false)
 * - disabled: boolean (default: false)
 * - readonly: boolean (default: false)
 * - placeholder: string (optional)
 * - rows: number (default: 4)
 * - minlength: number (optional)
 * - maxlength: number (optional)
 * - showCounter: boolean (default: false) - Show character counter
 * - counterModel: string (optional) - Alpine x-model variable name for counter
 * - xModel: string (optional) - Alpine x-model binding
 * - xOn: string (optional) - Alpine x-on event handler
 * - containerClass: string (optional) - Additional container classes
 * - textareaClass: string (optional) - Additional textarea classes
 *
 * Usage:
 * <%- include('../partials/ui/forms/textarea', {
 * label: 'Description',
 * name: 'description',
 * rows: 6,
 * value: task.description,
 * maxlength: 2000,
 * showCounter: true,
 * counterModel: 'description',
 * xModel: 'description'
 * }) %>
 */

const label = typeof label !== 'undefined' ? label : '';
const name = typeof name !== 'undefined' ? name : '';
const value = typeof value !== 'undefined' ? value : '';
const error = typeof error !== 'undefined' ? error : '';
const helpText = typeof helpText !== 'undefined' ? helpText : '';
const required = typeof required !== 'undefined' ? required : false;
const disabled = typeof disabled !== 'undefined' ? disabled : false;
const readonly = typeof readonly !== 'undefined' ? readonly : false;
const placeholder = typeof placeholder !== 'undefined' ? placeholder : '';
const rows = typeof rows !== 'undefined' ? rows : 4;
const minlength = typeof minlength !== 'undefined' ? minlength : null;
const maxlength = typeof maxlength !== 'undefined' ? maxlength : null;
const showCounter = typeof showCounter !== 'undefined' ? showCounter : false;
const counterModel = typeof counterModel !== 'undefined' ? counterModel : '';
const xModel = typeof xModel !== 'undefined' ? xModel : '';
const xOn = typeof xOn !== 'undefined' ? xOn : '';
const containerClass = typeof containerClass !== 'undefined' ? containerClass : '';
const textareaClass = typeof textareaClass !== 'undefined' ? textareaClass : '';

// Build textarea attributes
const textareaAttrs = [];
if (required) textareaAttrs.push('required');
if (disabled) textareaAttrs.push('disabled');
if (readonly) textareaAttrs.push('readonly');
if (minlength !== null) textareaAttrs.push(`minlength="${minlength}"`);
if (maxlength !== null) textareaAttrs.push(`maxlength="${maxlength}"`);
if (xModel) textareaAttrs.push(`x-model="${xModel}"`);
if (xOn) textareaAttrs.push(`${xOn}`);

// Build CSS classes
const textareaCssClasses = [
 'textarea',
 'textarea-bordered',
 'w-full',
 error ? 'textarea-error' : '',
 textareaClass
].filter(Boolean).join(' ');
%>

<div class="form-control w-full <%= containerClass %>">
 <label class="label" for="<%= name %>">
 <span class="label-text font-semibold tf-text-primary">
 <%= label %>
 <% if (required) { %>
 <span class="text-error">*</span>
 <% } %>
 </span>
 <% if (showCounter && counterModel && maxlength !== null) { %>
 <span class="label-text-alt tf-text-muted" x-text="`${<%= counterModel %>.length}/<%= maxlength %>`">
 0/<%= maxlength %>
 </span>
 <% } %>
 </label>

 <textarea
 name="<%= name %>"
 id="<%= name %>"
 rows="<%= rows %>"
 placeholder="<%= placeholder %>"
 class="<%= textareaCssClasses %>"
 <%- textareaAttrs.join(' ') %>
 ><%= value %></textarea>

 <% if (error || helpText) { %>
 <label class="label">
 <% if (error) { %>
 <span class="label-text-alt text-error"><%= error %></span>
 <% } else if (helpText) { %>
 <span class="label-text-alt tf-text-muted"><%= helpText %></span>
 <% } %>
 </label>
 <% } %>
</div>
