<%
/**
 * File Input Component
 * File upload with drag-and-drop, preview, and progressive enhancement
 *
 * Props:
 * - name: string - input name attribute
 * - label: string (optional) - field label
 * - accept: string (optional) - accepted file types (e.g., 'image/*,.pdf')
 * - multiple: boolean (default: false) - allow multiple files
 * - maxSize: number (optional) - max file size in bytes (e.g., 5242880 for 5MB)
 * - required: boolean (default: false)
 * - disabled: boolean (default: false)
 * - error: string (optional) - error message
 * - helpText: string (optional) - help text
 * - containerClass: string (optional)
 * - hxPost, hxGet, hxTrigger, hxTarget, hxSwap: HTMX attributes
 *
 * Usage example:
 * <%- include('../../partials/ui/forms/file-input', {
 *   name: 'avatar',
 *   label: 'Profile Picture',
 *   accept: 'image/*',
 *   maxSize: 5242880,
 *   helpText: 'PNG, JPG up to 5MB'
 * }) %>
 */

const name = typeof name !== 'undefined' ? name : '';
const label = typeof label !== 'undefined' ? label : '';
const accept = typeof accept !== 'undefined' ? accept : '';
const multiple = typeof multiple !== 'undefined' ? multiple : false;
const maxSize = typeof maxSize !== 'undefined' ? maxSize : null;
const required = typeof required !== 'undefined' ? required : false;
const disabled = typeof disabled !== 'undefined' ? disabled : false;
const error = typeof error !== 'undefined' ? error : '';
const helpText = typeof helpText !== 'undefined' ? helpText : '';
const containerClass = typeof containerClass !== 'undefined' ? containerClass : '';

const hxPost = typeof hxPost !== 'undefined' ? hxPost : '';
const hxGet = typeof hxGet !== 'undefined' ? hxGet : '';
const hxTrigger = typeof hxTrigger !== 'undefined' ? hxTrigger : '';
const hxTarget = typeof hxTarget !== 'undefined' ? hxTarget : '';
const hxSwap = typeof hxSwap !== 'undefined' ? hxSwap : '';

const inputId = name;
const helpTextId = helpText || error ? `${name}-help` : '';
const errorId = error ? `${name}-error` : '';
%>

<div class="form-control <%= containerClass %>"
     x-data="{
       files: [],
       isDragging: false,
       handleFiles(fileList) {
         this.files = Array.from(fileList).map(f => ({
           name: f.name,
           size: f.size,
           type: f.type,
           url: f.type.startsWith('image/') ? URL.createObjectURL(f) : null
         }));
       },
       removeFile(index) {
         this.files.splice(index, 1);
         if (this.files.length === 0) {
           this.$refs.fileInput.value = '';
         }
       }
     }">

  <% if (label) { %>
  <label class="label" for="<%= inputId %>">
    <span class="label-text font-semibold tf-text-primary">
      <%= label %>
      <% if (required) { %>
        <span class="text-error">*</span>
      <% } %>
    </span>
  </label>
  <% } %>

  <!-- Drag-and-drop area -->
  <div class="relative border-2 border-dashed rounded-lg transition-colors"
       :class="isDragging ? 'border-primary bg-primary/5' : 'border-base-content/20 bg-base-200'"
       @dragover.prevent="isDragging = true"
       @dragleave.prevent="isDragging = false"
       @drop.prevent="isDragging = false; handleFiles($event.dataTransfer.files); $refs.fileInput.files = $event.dataTransfer.files">

    <input
      type="file"
      id="<%= inputId %>"
      name="<%= name %>"
      x-ref="fileInput"
      class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
      <% if (accept) { %>accept="<%= accept %>"<% } %>
      <% if (multiple) { %>multiple<% } %>
      <% if (required) { %>required<% } %>
      <% if (disabled) { %>disabled<% } %>
      <% if (hxPost) { %>hx-post="<%= hxPost %>"<% } %>
      <% if (hxGet) { %>hx-get="<%= hxGet %>"<% } %>
      <% if (hxTrigger) { %>hx-trigger="<%= hxTrigger %>"<% } %>
      <% if (hxTarget) { %>hx-target="<%= hxTarget %>"<% } %>
      <% if (hxSwap) { %>hx-swap="<%= hxSwap %>"<% } %>
      @change="handleFiles($event.target.files)"
      <% if (helpTextId || errorId) { %>
        aria-describedby="<%= helpTextId || errorId %>"
      <% } %>
    />

    <!-- Placeholder content -->
    <div class="p-8 text-center" x-show="files.length === 0">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto mb-4 text-base-content/50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
      </svg>
      <p class="text-sm text-base-content/70 mb-1">
        <span class="font-semibold text-primary">Click to upload</span> or drag and drop
      </p>
      <% if (helpText && !error) { %>
        <p class="text-xs text-base-content/50"><%= helpText %></p>
      <% } %>
    </div>

    <!-- File preview -->
    <div class="p-4 space-y-2" x-show="files.length > 0">
      <template x-for="(file, index) in files" :key="index">
        <div class="flex items-center gap-3 bg-base-100 rounded-lg p-3 border border-base-content/10">
          <!-- Image preview or file icon -->
          <div class="flex-shrink-0">
            <template x-if="file.url">
              <img :src="file.url" :alt="file.name" class="w-12 h-12 object-cover rounded" />
            </template>
            <template x-if="!file.url">
              <div class="w-12 h-12 bg-base-200 rounded flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-base-content/50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
            </template>
          </div>

          <!-- File info -->
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium truncate" x-text="file.name"></p>
            <p class="text-xs text-base-content/50" x-text="(file.size / 1024).toFixed(1) + ' KB'"></p>
          </div>

          <!-- Remove button -->
          <button
            type="button"
            class="btn btn-ghost btn-sm btn-circle"
            @click="removeFile(index)"
            aria-label="Remove file">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </template>
    </div>
  </div>

  <!-- Error or help text -->
  <% if (error) { %>
    <label class="label">
      <span class="label-text-alt text-error" id="<%= errorId %>">
        <%= error %>
      </span>
    </label>
  <% } else if (helpText) { %>
    <label class="label">
      <span class="label-text-alt tf-text-muted" id="<%= helpTextId %>">
        <%= helpText %>
      </span>
    </label>
  <% } %>
</div>
