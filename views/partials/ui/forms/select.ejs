<%
/**
 * Select Field Component
 * Dropdown select field with options
 *
 * Props:
 * - label: string - Field label
 * - name: string - Select name attribute
 * - options: array - Options array [{ value, label, icon? }] OR raw HTML string
 * - value: string (optional) - Selected value
 * - error: string (optional) - Error message
 * - helpText: string (optional) - Help text below select
 * - required: boolean (default: false)
 * - disabled: boolean (default: false)
 * - placeholder: string (optional) - Placeholder option text
 * - showPlaceholder: boolean (default: true) - Show placeholder option
 * - size: string (default: 'md') - Size: xs, sm, md, lg
 * - variant: string (default: 'bordered') - Variant: bordered, ghost
 * - containerClass: string (optional) - Additional container classes
 * - selectClass: string (optional) - Additional select classes
 * - customOptionsHtml: string (optional) - Raw HTML for custom options (overrides options array)
 *
 * Usage:
 * <%- include('../partials/ui/forms/select', {
 * label: 'Status',
 * name: 'status',
 * options: [{ value: 'TODO', label: 'À faire', icon: '📝' }, ...],
 * value: task.status,
 * required: true
 * }) %>
 */

const label = typeof label !== 'undefined' ? label : '';
const name = typeof name !== 'undefined' ? name : '';
const options = typeof options !== 'undefined' ? options : [];
const value = typeof value !== 'undefined' ? value : '';
const error = typeof error !== 'undefined' ? error : '';
const helpText = typeof helpText !== 'undefined' ? helpText : '';
const required = typeof required !== 'undefined' ? required : false;
const disabled = typeof disabled !== 'undefined' ? disabled : false;
const placeholder = typeof placeholder !== 'undefined' ? placeholder : '';
const showPlaceholder = typeof showPlaceholder !== 'undefined' ? showPlaceholder : true;
const size = typeof size !== 'undefined' ? size : 'md';
const variant = typeof variant !== 'undefined' ? variant : 'bordered';
const containerClass = typeof containerClass !== 'undefined' ? containerClass : '';
const selectClass = typeof selectClass !== 'undefined' ? selectClass : '';
const customOptionsHtml = typeof customOptionsHtml !== 'undefined' ? customOptionsHtml : '';

// Build select CSS classes
const sizeClasses = {
 xs: 'select-xs',
 sm: 'select-sm',
 md: 'select-md',
 lg: 'select-lg'
};

const variantClasses = {
 bordered: 'select-bordered',
 ghost: 'select-ghost'
};

const selectCssClasses = [
 'select',
 'w-full',
 'tf-input-padding',
 sizeClasses[size] || '',
 variantClasses[variant] || '',
 error ? 'select-error' : '',
 selectClass
].filter(Boolean).join(' ');
%>

<div class="form-control w-full <%= containerClass %>">
 <label class="label" for="<%= name %>">
 <span class="label-text font-semibold tf-text-primary">
 <%= label %>
 <% if (required) { %>
 <span class="text-error">*</span>
 <% } %>
 </span>
 </label>

 <select
 name="<%= name %>"
 id="<%= name %>"
 class="<%= selectCssClasses %>"
 <%= required ? 'required' : '' %>
 <%= disabled ? 'disabled' : '' %>
 >
 <% if (showPlaceholder && placeholder) { %>
 <option value="" disabled <%= !value ? 'selected' : '' %>><%= placeholder %></option>
 <% } %>

 <% if (customOptionsHtml) { %>
 <%- customOptionsHtml %>
 <% } else { %>
 <% options.forEach(opt => { %>
 <option value="<%= opt.value %>" <%= value === opt.value ? 'selected' : '' %>>
 <%= opt.icon ? opt.icon + ' ' : '' %><%= opt.label %>
 </option>
 <% }) %>
 <% } %>
 </select>

 <% if (error || helpText) { %>
 <label class="label">
 <% if (error) { %>
 <span class="label-text-alt text-error"><%= error %></span>
 <% } else if (helpText) { %>
 <span class="label-text-alt tf-text-muted"><%= helpText %></span>
 <% } %>
 </label>
 <% } %>
</div>
