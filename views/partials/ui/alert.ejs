<%
/**
 * Alert Component (DaisyUI)
 *
 * Reusable alert component with support for variants, icons, and dismissible state.
 *
 * @param {string} message - Alert message content (required)
 * @param {string} [variant='info'] - Alert style: 'success', 'error', 'warning', 'info'
 * @param {boolean} [dismissible=false] - Show close button to dismiss alert
 * @param {boolean} [showIcon=true] - Show icon based on variant
 * @param {string} [icon=''] - Custom icon HTML (overrides default variant icon)
 * @param {string} [class=''] - Additional CSS classes
 * @param {string} [id=''] - Alert ID attribute
 * @param {object} [attrs={}] - Additional HTML attributes
 *
 * @example Success alert
 * <%- include('./partials/ui/alert', { message: 'Profile updated successfully!', variant: 'success' }) %>
 *
 * @example Error alert with custom message
 * <%- include('./partials/ui/alert', {
 *   message: 'Invalid credentials. Please try again.',
 *   variant: 'error'
 * }) %>
 *
 * @example Warning alert dismissible
 * <%- include('./partials/ui/alert', {
 *   message: 'Your session will expire in 5 minutes',
 *   variant: 'warning',
 *   dismissible: true
 * }) %>
 *
 * @example Info alert without icon
 * <%- include('./partials/ui/alert', {
 *   message: 'Please verify your email address',
 *   variant: 'info',
 *   showIcon: false
 * }) %>
 *
 * @example Alert with custom icon
 * <%- include('./partials/ui/alert', {
 *   message: 'Custom notification',
 *   icon: '<svg class="h-6 w-6">...</svg>'
 * }) %>
 */

// Default values
const alertMessage = typeof message !== 'undefined' ? message : '';
const alertVariant = typeof variant !== 'undefined' ? variant : 'info';
const alertDismissible = typeof dismissible !== 'undefined' ? dismissible : false;
const alertShowIcon = typeof showIcon !== 'undefined' ? showIcon : true;
const alertIcon = typeof icon !== 'undefined' ? icon : '';
const alertClass = typeof class !== 'undefined' ? class : '';
const alertId = typeof id !== 'undefined' ? id : '';
const alertAttrs = typeof attrs !== 'undefined' ? attrs : {};

// Build DaisyUI alert classes
const classes = [
  'alert',
  `alert-${alertVariant}`,
  'mb-4',
  alertClass
].filter(Boolean).join(' ');

// Default icons for each variant
const defaultIcons = {
  success: '<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>',
  error: '<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>',
  warning: '<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>',
  info: '<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>'
};

const displayIcon = alertIcon || (alertShowIcon && defaultIcons[alertVariant]) || '';

// Build additional attributes string
let attrsString = '';
for (const [key, value] of Object.entries(alertAttrs)) {
  attrsString += ` ${key}="${value}"`;
}

const idAttr = alertId ? ` id="${alertId}"` : '';
const roleAttr = ' role="alert"';
%>

<div class="<%= classes %>"<%= idAttr %><%= roleAttr %><%= attrsString %>>
  <% if (displayIcon) { %>
    <%- displayIcon %>
  <% } %>
  <span><%= alertMessage %></span>
  <% if (alertDismissible) { %>
    <button class="btn btn-sm btn-ghost btn-circle" onclick="this.closest('.alert').remove()" aria-label="Close alert">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  <% } %>
</div>
