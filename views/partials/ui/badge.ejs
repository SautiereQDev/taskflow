<%
/**
 * Badge Component
 * Displays colored badges for status, priority, roles, etc.
 *
 * Props:
 *  - text: string - Badge text content
 *  - variant: string - DaisyUI badge variant (badge-success, badge-error, etc.)
 *  - size: 'sm' | 'md' | 'lg' (default: 'md')
 *  - outline: boolean - outline style (default: false)
 *
 * Usage: include('../partials/ui/badge', { text: 'Urgent', variant: 'badge-error', size: 'lg' })
 */

const badgeText = typeof text !== 'undefined' ? text : '';
const badgeVariant = typeof variant !== 'undefined' ? variant : 'badge-ghost';
const badgeSize = typeof size !== 'undefined' ? size : 'md';
const badgeOutline = typeof outline !== 'undefined' ? outline : false;

const sizeClass = badgeSize === 'sm' ? 'badge-sm' : badgeSize === 'lg' ? 'badge-lg' : '';
const outlineClass = badgeOutline ? 'badge-outline' : '';
%>

<span class="badge <%= badgeVariant %> <%= sizeClass %> <%= outlineClass %>">
  <%= badgeText %>
</span>
