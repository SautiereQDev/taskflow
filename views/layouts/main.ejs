<!DOCTYPE html>
<html lang="<%= locale || 'fr' %>" data-theme="taskflowLight">
<head>
  <%- include('../partials/head', { title: typeof title !== 'undefined' ? title : 'TaskFlow' }) %>
</head>
<body class="min-h-screen bg-base-100 font-sans antialiased transition-colors duration-300">
  <div class="tf-app-shell">
    <%- include('../partials/header') %>

    <main class="tf-main tf-stack">
      <%- include('../partials/flash-messages') %>
      <%- body %>
    </main>

    <%- include('../partials/footer') %>
  </div>

  <!-- Toast Notifications (Alpine.js) -->
  <%- include('../partials/toast-notifications') %>

  <!-- HTMX 1.9.10 - Dynamic content updates -->
  <script src="https://unpkg.com/htmx.org@1.9.10" integrity="sha384-D1Kt99CQMDuVetoL1lrYwg5t+9QdHe7NLX/SoJYkXDFfX37iInKRy5xLSi8nO7UC" crossorigin="anonymous"></script>

  <!-- Alpine.js 3.x - Interactive components -->
  <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/persist@3.x.x/dist/cdn.min.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

  <!-- Theme initialization (runs before Alpine) -->
  <script src="/js/theme-init.js"></script>

  <!-- Alpine.js components (theme, modal, toast, etc.) -->
  <script src="/js/alpine-components.js"></script>
</body>
</html>
