<!DOCTYPE html>
<html lang="<%= locale || 'fr' %>" data-theme="light">
<head>
 <%- include('../partials/head', { title: typeof title !== 'undefined' ? title : 'TaskFlow' }) %>
</head>
<body class="min-h-screen bg-base-100 font-sans antialiased transition-colors duration-300">
 <!-- Skip to main content link for accessibility -->
 <a href="#main-content" class="skip-link">
 <%= typeof __=== 'function' ? __('a11y.skipToContent') : 'Aller au contenu principal' %>
 </a>

 <div class="tf-app-shell">
 <%- include('../partials/header') %>

 <main id="main-content" class="tf-main tf-stack py-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full" tabindex="-1">
 <%- include('../partials/flash-messages') %>
 <%- body %>
 </main>

 <%- include('../partials/footer') %>
 </div>

 <!-- Toast Notifications (Alpine.js) -->
 <%- include('../partials/toast-notifications') %>

 <!-- HTMX 2.0.0 - Dynamic content updates with improved history management -->
 <script src="https://unpkg.com/htmx.org@2.0.0/dist/htmx.min.js" crossorigin="anonymous"></script>

 <!-- HTMX Extensions (HTMX 2.x compatible versions) -->
 <script src="https://unpkg.com/htmx-ext-loading-states@2.0.0/loading-states.js"></script>

 <!-- HTMX Custom Events & URL Handling (HTMX 2.0) -->
 <script src="/js/htmx-events.js"></script>
 <script src="/js/htmx-filters-url.js"></script>

 <!-- Alpine.js 3.15.1 - Interactive components with plugins -->
 <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/persist@3.15.1/dist/cdn.min.js"></script>
 <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/intersect@3.15.1/dist/cdn.min.js"></script>
 <script defer src="https://cdn.jsdelivr.net/npm/@alpinejs/focus@3.15.1/dist/cdn.min.js"></script>
 <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.15.1/dist/cdn.min.js"></script>

 <!-- Theme initialization (runs before Alpine) -->
 <script src="/js/theme-init.js"></script>

 <!-- Alpine.js components (theme, modal, toast, etc.) -->
 <script src="/js/alpine-components.js"></script>
</body>
</html>
