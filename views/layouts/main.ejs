<!DOCTYPE html>
<html lang="<%= locale || 'fr' %>" data-theme="light">
<head>
 <%- include('../partials/head', { title: typeof title !== 'undefined' ? title : 'TaskFlow' }) %>
</head>
<body class="min-h-screen bg-base-100 font-sans antialiased transition-colors duration-300">
 <!-- Skip to main content link for accessibility -->
 <a href="#main-content" class="skip-link">
 <%= typeof __=== 'function' ? __('a11y.skipToContent') : 'Aller au contenu principal' %>
 </a>

 <div class="tf-app-shell">
 <%- include('../partials/header') %>

 <main id="main-content" class="tf-main tf-stack py-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full" tabindex="-1">
 <%- include('../partials/flash-messages') %>
 <%- body %>
 </main>

 <%- include('../partials/footer') %>
 </div>

 <!-- Toast Notifications (Alpine.js) -->
 <%- include('../partials/toast-notifications') %>

 <!-- HTMX 2.0.7 Bundle - Local bundle with loading-states extension -->
 <!-- No CDN required! -->
 <script nonce="<%= cspNonce %>" src="/js/htmx-bundle.js"></script>

 <!-- HTMX Custom Events & URL Handling (HTMX 2.0) -->
 <script nonce="<%= cspNonce %>" src="/js/htmx-events.js"></script>
 <script nonce="<%= cspNonce %>" src="/js/htmx-filters-url.js"></script>
 <script nonce="<%= cspNonce %>" src="/js/task-card-click.js"></script>

 <!-- Theme initialization (runs BEFORE Alpine) -->
 <script nonce="<%= cspNonce %>" src="/js/theme-init.js"></script>

 <!-- Alpine.js 3.15.1 CSP Build - Bundled with persist, intersect, focus plugins -->
 <!-- No 'unsafe-eval' required! -->
 <script nonce="<%= cspNonce %>" defer src="/js/alpine-csp.js"></script>

 <!-- Alpine.js components (theme, modal, toast, etc.) -->
 <script nonce="<%= cspNonce %>" defer src="/js/alpine-components.js"></script>
</body>
</html>
