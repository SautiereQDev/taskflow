@layout('layouts/base')
@section('body')
  <section aria-labelledby="login-title" class="login-card">
    <h2 id="login-title">{{ i18n.formatMessage('auth.login.title') }}</h2>
    <p>{{ i18n.formatMessage('auth.login.subtitle') }}</p>

    <form method="POST" action="/login" class="grid">
      @csrf()

      <label>
        {{ i18n.formatMessage('auth.login.email') }}
        <input
          type="email"
          name="email"
          value="{{ form?.email || '' }}"
          required
          autocomplete="email"
        />
        @if(errors?.email)
          <small class="error">{{ errors.email }}</small>
        @endif
      </label>

      <label>
        {{ i18n.formatMessage('auth.login.password') }}
        <input type="password" name="password" required autocomplete="current-password" />
        @if(errors?.password)
          <small class="error">{{ errors.password }}</small>
        @endif
      </label>

      <label class="remember">
        <input type="checkbox" name="remember" />
        {{ i18n.formatMessage('auth.login.remember') }}
      </label>

      <button type="submit">{{ i18n.formatMessage('auth.login.submit') }}</button>
    </form>
  </section>
@endsection
