@layout('layouts/base')
@section('body')
  <style>
    .dashboard-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-block-end: 2rem;
    }

    .status-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1rem;
    }

    .status-chip {
      padding: 0.15rem 0.65rem;
      border-radius: 999px;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .tasks-list {
      list-style: none;
      padding-left: 0;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .tasks-list article {
      border: 1px solid var(--pico-muted-border-color);
      border-radius: 0.75rem;
      padding: 1rem;
    }

    .overview-section {
      margin-block-start: 2rem;
    }

    .tasks-list header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .metrics-value {
      font-size: 2.5rem;
      font-weight: 600;
      margin: 0;
    }
  </style>

  <section class="hero">
    <div>
      <h2>{{ i18n.formatMessage('home.greeting', { name: auth.user?.name || '' }) }}</h2>
      <p>{{ i18n.formatMessage('home.subtitle') }}</p>
    </div>
  </section>

  <section class="dashboard-grid" aria-label="{{ i18n.formatMessage('home.statsTitle') }}">
    <article>
      <h3>{{ i18n.formatMessage('home.metrics.total.title') }}</h3>
      <p class="metrics-value">{{ summary.total }}</p>
      <small>{{ i18n.formatMessage('home.metrics.total.description') }}</small>
    </article>
    <article>
      <h3>{{ i18n.formatMessage('home.metrics.overdue.title') }}</h3>
      <p class="metrics-value">{{ summary.overdue }}</p>
      <small>{{ i18n.formatMessage('home.metrics.overdue.description') }}</small>
    </article>
    <article>
      <h3>{{ i18n.formatMessage('home.metrics.upcoming.title') }}</h3>
      <p class="metrics-value">{{ summary.upcoming }}</p>
      <small>{{ i18n.formatMessage('home.metrics.upcoming.description') }}</small>
    </article>
    <article>
      <h3>{{ i18n.formatMessage('home.metrics.nextDue.title') }}</h3>
      <p class="metrics-value">
        @if(summary.nextDueDate)
          {{ summary.nextDueDate.setLocale(locale).toFormat('dd LLL') }}
        @else
          {{ i18n.formatMessage('home.metrics.nextDue.empty') }}
        @endif
      </p>
      <small>{{ i18n.formatMessage('home.metrics.nextDue.description') }}</small>
    </article>
  </section>

  <section class="overview-section" aria-label="{{ i18n.formatMessage('home.statusSplit') }}">
    <h3>{{ i18n.formatMessage('home.statusSplit') }}</h3>
    <div class="status-grid">
      @each(statusSummary in summary.statuses)
        <article>
          <header>
            <span class="status-chip status-{{ statusSummary.status }}">
              {{ statusLabels[statusSummary.status] || statusSummary.status }}
            </span>
          </header>
          <p class="metrics-value">{{ statusSummary.count }}</p>
        </article>
      @endeach
    </div>
  </section>

  <section class="overview-section" aria-label="{{ i18n.formatMessage('home.lists.title') }}">
    <div class="grid">
      <article>
        <header>
          <h3>{{ i18n.formatMessage('home.lists.assigned.title') }}</h3>
          <small>{{ i18n.formatMessage('home.lists.assigned.subtitle') }}</small>
        </header>
        @if(sections.assigned.length)
          <ul class="tasks-list">
            @each(task in sections.assigned)
              <li>
                <article>
                  <header>
                    <strong>{{ task.title }}</strong>
                    <span class="status-chip">{{ statusLabels[task.status] }}</span>
                  </header>
                  <p>{{ task.description || i18n.formatMessage('tasks.show.noDescription') }}</p>
                  <footer>
                    <small>
                      @if(task.dueDate)
                        {{ i18n.formatMessage('home.lists.dueDate', {
                          date: task.dueDate.setLocale(locale).toFormat('dd LLL yyyy'),
                        }) }}
                      @else
                        {{ i18n.formatMessage('home.lists.dueDate', { date: i18n.formatMessage('home.lists.none') }) }}
                      @endif
                      •
                      {{ i18n.formatMessage('home.lists.priority', {
                        label: priorityLabels[task.priority],
                      }) }}
                    </small>
                  </footer>
                </article>
              </li>
            @endeach
          </ul>
        @else
          <p>{{ i18n.formatMessage('home.lists.assigned.empty') }}</p>
        @endif
      </article>

      <article>
        <header>
          <h3>{{ i18n.formatMessage('home.lists.created.title') }}</h3>
          <small>{{ i18n.formatMessage('home.lists.created.subtitle') }}</small>
        </header>
        @if(sections.created.length)
          <ul class="tasks-list">
            @each(task in sections.created)
              <li>
                <article>
                  <header>
                    <strong>{{ task.title }}</strong>
                    <span class="status-chip">{{ statusLabels[task.status] }}</span>
                  </header>
                  <p>
                    {{ i18n.formatMessage('tasks.show.assignee') }} :
                    {{ task.assignee?.name || i18n.formatMessage('tasks.show.unassigned') }}
                  </p>
                  <footer>
                    <small>
                      {{ i18n.formatMessage('home.lists.updatedAt', {
                        date: task.updatedAt.setLocale(locale).toFormat('dd LLL HH:mm'),
                      }) }}
                    </small>
                  </footer>
                </article>
              </li>
            @endeach
          </ul>
        @else
          <p>{{ i18n.formatMessage('home.lists.created.empty') }}</p>
        @endif
      </article>
    </div>
  </section>

  <section class="overview-section" aria-label="Alertes">
    <div class="grid">
      <article>
        <header>
          <h3>{{ i18n.formatMessage('home.lists.overdue.title') }}</h3>
          <small>{{ i18n.formatMessage('home.lists.overdue.subtitle') }}</small>
        </header>
        @if(sections.overdue.length)
          <ul class="tasks-list">
            @each(task in sections.overdue)
              <li>
                <article>
                  <header>
                    <strong>{{ task.title }}</strong>
                    <span class="status-chip">{{ i18n.formatMessage('home.lists.overdue.chip') }}</span>
                  </header>
                  <p>
                    {{ task.assignee?.name || i18n.formatMessage('tasks.show.unassigned') }} •
                    {{ i18n.formatMessage('home.lists.dueDate', {
                      date: task.dueDate?.setLocale(locale).toFormat('dd LLL yyyy') || i18n.formatMessage('home.lists.none'),
                    }) }}
                  </p>
                </article>
              </li>
            @endeach
          </ul>
        @else
          <p>{{ i18n.formatMessage('home.lists.overdue.empty') }}</p>
        @endif
      </article>

      <article>
        <header>
          <h3>{{ i18n.formatMessage('home.lists.recent.title') }}</h3>
          <small>{{ i18n.formatMessage('home.lists.recent.subtitle') }}</small>
        </header>
        @if(sections.recent.length)
          <ul class="tasks-list">
            @each(task in sections.recent)
              <li>
                <article>
                  <header>
                    <strong>{{ task.title }}</strong>
                    <span class="status-chip">{{ statusLabels[task.status] }}</span>
                  </header>
                  <p>
                    {{ i18n.formatMessage('home.lists.updatedAt', {
                      date: task.updatedAt.setLocale(locale).toFormat('dd LLL yyyy • HH:mm'),
                    }) }}
                  </p>
                </article>
              </li>
            @endeach
          </ul>
        @else
          <p>{{ i18n.formatMessage('home.lists.recent.empty') }}</p>
        @endif
      </article>
    </div>
  </section>
@endsection
