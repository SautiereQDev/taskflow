@layout('layouts/base')
@section('body')
  <style>
    .page-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-block-end: 1.5rem;
    }

    .filters-grid {
      display: grid;
      gap: 1rem;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }

    .form-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      margin-block-start: 0.5rem;
    }

    .tasks-table {
      width: 100%;
      border-collapse: collapse;
    }

    .tasks-table th,
    .tasks-table td {
      padding: 0.65rem;
      border-bottom: 1px solid var(--pico-muted-border-color);
      text-align: left;
      vertical-align: top;
    }

    .task-badge {
      display: inline-flex;
      padding: 0.15rem 0.6rem;
      border-radius: 999px;
      font-size: 0.85rem;
      background: var(--pico-muted-border-color);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .pagination-controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-block-start: 1.25rem;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .pagination-controls .actions {
      display: flex;
      gap: 0.5rem;
    }

    .pagination-controls a[aria-disabled='true'] {
      pointer-events: none;
      opacity: 0.5;
    }
  </style>

  <section class="page-header">
    <div>
      <h2>{{ i18n.formatMessage('tasks.titles.list') }}</h2>
      <p>{{ i18n.formatMessage('tasks.list.subtitle') }}</p>
    </div>
    <div>
      <a role="button" class="secondary" href="{{ route('tasks.create') }}">
        {{ i18n.formatMessage('tasks.list.new') }}
      </a>
      <br />
      <small>{{ i18n.formatMessage('tasks.list.total', { count: meta.total }) }}</small>
    </div>
  </section>

  <form method="GET" aria-label="{{ i18n.formatMessage('tasks.list.subtitle') }}">
    <div class="filters-grid">
      <label>
        <span>{{ i18n.formatMessage('tasks.list.filters.status') }}</span>
        <select name="status">
          <option value="">{{ i18n.formatMessage('tasks.list.filters.all') }}</option>
          @each((tuple) in statusOptions)
            <option value="{{ tuple[0] }}" @if(filters.status === tuple[0]) selected @endif>
              {{ tuple[1] }}
            </option>
          @endeach
        </select>
      </label>

      <label>
        <span>{{ i18n.formatMessage('tasks.list.filters.priority') }}</span>
        <select name="priority">
          <option value="">{{ i18n.formatMessage('tasks.list.filters.allPriority') }}</option>
          @each((tuple) in priorityOptions)
            <option value="{{ tuple[0] }}" @if(filters.priority === tuple[0]) selected @endif>
              {{ tuple[1] }}
            </option>
          @endeach
        </select>
      </label>

      <label>
        <span>{{ i18n.formatMessage('tasks.list.filters.search') }}</span>
        <input
          type="search"
          name="search"
          minlength="2"
          value="{{ filters.search || '' }}"
          placeholder="{{ i18n.formatMessage('tasks.list.filters.searchPlaceholder') }}"
        />
      </label>

      <label>
        <span>{{ i18n.formatMessage('tasks.list.filters.after') }}</span>
        <input type="date" name="dueAfter" value="{{ filters.dueAfter ? filters.dueAfter.toISODate() : '' }}" />
      </label>

      <label>
        <span>{{ i18n.formatMessage('tasks.list.filters.before') }}</span>
        <input type="date" name="dueBefore" value="{{ filters.dueBefore ? filters.dueBefore.toISODate() : '' }}" />
      </label>

      <label>
        <span>{{ i18n.formatMessage('tasks.list.filters.perPage') }}</span>
        <input type="number" name="perPage" min="1" max="50" value="{{ filters.perPage || 10 }}" />
      </label>
    </div>

    <div class="form-actions">
      <button type="submit">{{ i18n.formatMessage('tasks.list.filters.apply') }}</button>
      <a href="{{ route('tasks.index') }}" role="button" class="secondary outline">
        {{ i18n.formatMessage('tasks.list.filters.reset') }}
      </a>
    </div>
  </form>

  <section aria-live="polite">
    @if(tasks.length)
      <div class="overflow-auto">
        <table class="tasks-table">
          <thead>
            <tr>
              <th>{{ i18n.formatMessage('tasks.list.table.title') }}</th>
              <th>{{ i18n.formatMessage('tasks.list.table.status') }}</th>
              <th>{{ i18n.formatMessage('tasks.list.table.priority') }}</th>
              <th>{{ i18n.formatMessage('tasks.list.table.assignee') }}</th>
              <th>{{ i18n.formatMessage('tasks.list.table.dueDate') }}</th>
              <th>{{ i18n.formatMessage('tasks.list.table.updatedAt') }}</th>
              <th>{{ i18n.formatMessage('tasks.list.table.actions') }}</th>
            </tr>
          </thead>
          <tbody>
            @each(task in tasks)
              <tr>
                <td>
                  <strong>
                    <a href="{{ route('tasks.show', { id: task.id }) }}">{{ task.title }}</a>
                  </strong>
                  <p>{{ task.description || i18n.formatMessage('tasks.list.table.emptyDescription') }}</p>
                </td>
                <td>
                  <span class="task-badge">{{ statusLabels[task.status] || task.status }}</span>
                </td>
                <td>{{ priorityLabels[task.priority] || task.priority }}</td>
                <td>{{ task.assignee?.name || i18n.formatMessage('tasks.list.table.unassigned') }}</td>
                <td>
                  @if(task.dueDate)
                    {{ task.dueDate.setLocale(locale).toFormat('dd LLL yyyy') }}
                  @else
                    {{ i18n.formatMessage('generic.dash') }}
                  @endif
                </td>
                <td>{{ task.updatedAt.setLocale(locale).toFormat('dd LLL yyyy • HH:mm') }}</td>
                <td>
                  <a
                    role="button"
                    class="secondary outline"
                    href="{{ route('tasks.edit', { id: task.id }) }}"
                  >
                    {{ i18n.formatMessage('tasks.list.table.edit') }}
                  </a>
                </td>
              </tr>
            @endeach
          </tbody>
        </table>
      </div>

      <div class="pagination-controls">
        <span>
          {{ i18n.formatMessage('tasks.list.pagination.page', {
            current: meta.currentPage,
            total: meta.lastPage,
          }) }}
        </span>
        <div class="actions">
          @if(paginationLinks.prev)
            <a role="button" href="?{{ paginationLinks.prev }}">
              {{ i18n.formatMessage('tasks.list.pagination.prev') }}
            </a>
          @else
            <a role="button" aria-disabled="true">
              {{ i18n.formatMessage('tasks.list.pagination.prev') }}
            </a>
          @endif

          @if(paginationLinks.next)
            <a role="button" href="?{{ paginationLinks.next }}">
              {{ i18n.formatMessage('tasks.list.pagination.next') }}
            </a>
          @else
            <a role="button" aria-disabled="true">
              {{ i18n.formatMessage('tasks.list.pagination.next') }}
            </a>
          @endif
        </div>
      </div>
    @else
      <article class="status">
        <h3>{{ i18n.formatMessage('tasks.list.empty.title') }}</h3>
        <p>{{ i18n.formatMessage('tasks.list.empty.description') }}</p>
      </article>
    @endif
  </section>
@endsection
