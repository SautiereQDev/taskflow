      <h4>{{ i18n.formatMessage('tasks.show.assignee') }}</h4>
      <strong>{{ task.assignee?.name || task.assignee?.email || i18n.formatMessage('tasks.show.unassigned') }}</strong>
    </article>

    <article class="detail-card">
      <h4>{{ i18n.formatMessage('tasks.show.dueDate') }}</h4>
      <strong>
