          date: task.createdAt.setLocale(locale).toFormat('dd LLL yyyy • HH:mm'),
        }) }} —
        {{ i18n.formatMessage('tasks.show.updatedAt', {
          date: task.updatedAt.setLocale(locale).toFormat('dd LLL yyyy • HH:mm'),
        }) }}
      </small>
    </div>
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: flex-end;">
      <a role="button" class="secondary outline" href="{{ route('tasks.index') }}">
        {{ i18n.formatMessage('tasks.show.back') }}
      </a>
      <a role="button" href="{{ route('tasks.edit', { id: task.id }) }}">
        {{ i18n.formatMessage('tasks.show.edit') }}
      </a>
    </div>
  </section>

  <section class="details-grid">
    <article class="detail-card">
      <h4>{{ i18n.formatMessage('tasks.show.status') }}</h4>
