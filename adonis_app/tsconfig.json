{
  "extends": "@adonisjs/tsconfig/tsconfig.app.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./build",
    "baseUrl": "./",
    "paths": {
      "#types/*": [
        "./app/types/*"
      ],
      "#factories/*": [
        "./database/factories/*"
      ],
      "#services/*": [
        "./app/services/*"
      ],
      "#view_models/*": [
        "./app/view_models/*"
      ]
    }
  }
}