# Environment Configuration
NODE_ENV=development

# Server Configuration
PORT=3000
HOST=localhost

# Database Configuration (Docker Postgres dev)
# Correspond à docker-compose.yml (service db, port 5433 exposé)
DATABASE_URL="postgresql://taskflow:taskflow_dev_password@localhost:5433/taskflow_dev?schema=public"

# Application Configuration
APP_NAME="TaskFlow"
APP_URL="http://localhost:3000"
APP_VERSION="2.0.0"

# Logging
LOG_LEVEL=info

# OpenTelemetry Configuration
# Set to 'true' to enable distributed tracing
OTEL_ENABLED=false
# OTLP HTTP endpoint for traces and metrics
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics

# Session Configuration
# Changez ce secret en prod
SESSION_SECRET="change-me-in-production"
SESSION_MAX_AGE=86400000

# Security Configuration (Production)
ENABLE_HSTS=false
ALLOWED_ORIGINS=http://localhost:3000

# Seeding optionnel au démarrage Docker (géré côté docker-compose)
# SEED_DATABASE="false"


