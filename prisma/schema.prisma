// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, citext]
}

// ============================================================================
// ENUMS
// ============================================================================

/// User role in the system
enum UserRole {
  ADMIN   // Full system access
  MANAGER // Can manage tasks and users
  MEMBER  // Basic task management

  @@map("user_role")
}

/// Task status in the workflow
enum TaskStatus {
  TODO        // Not started
  IN_PROGRESS // Currently being worked on
  DONE        // Completed
  CANCELLED   // Cancelled/Abandoned

  @@map("task_status")
}

/// Task priority level
enum TaskPriority {
  LOW    // Low priority
  MEDIUM // Normal priority
  HIGH   // High priority
  URGENT // Urgent - needs immediate attention

  @@map("task_priority")
}

// ============================================================================
// MODELS
// ============================================================================

/// User account with authentication and profile
model User {
  id        String   @id @default(cuid())
  email     String   @unique @db.Citext
  name      String   @db.VarChar(100)
  password  String   @db.VarChar(255)
  role      UserRole @default(MEMBER)
  locale    String   @default("fr") @db.VarChar(5)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Relations
  tasksCreated  Task[] @relation("TaskCreator")
  tasksAssigned Task[] @relation("TaskAssignee")

  // Indexes
  @@index([email])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

/// Task with assignment and tracking
model Task {
  id          String       @id @default(cuid())
  title       String       @db.VarChar(200)
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @map("due_date") @db.Timestamptz(3)
  completedAt DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Foreign keys
  creatorId  String  @map("creator_id")
  assigneeId String? @map("assignee_id")

  // Relations
  creator  User  @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Indexes for performance
  @@index([status])
  @@index([priority])
  @@index([creatorId])
  @@index([assigneeId])
  @@index([dueDate])
  @@index([completedAt])
  @@index([createdAt], map: "tasks_created_at_asc_idx")
  @@index([status, priority]) // Composite index for common queries
  @@index([assigneeId, status]) // Composite index for user task lists
  @@index([createdAt(sort: Desc)], map: "tasks_created_at_desc_idx") // Optimized for recent tasks queries
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin) // Full-text search on title
  @@map("tasks")
}

/// Session storage for express-session with connect-pg-simple
model Session {
  sid    String   @id @db.VarChar(255)
  sess   Json     @db.JsonB
  expire DateTime @db.Timestamptz(6)

  @@index([expire])
  @@map("sessions")
}

