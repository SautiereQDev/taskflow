{
  "name": "team-task-manager",
  "version": "1.0.0",
  "description": "Application de gestion de tâches d'équipe avec Express.js, TypeScript, Prisma et EJS",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently \"npm run css:watch\" \"npm run frontend:watch\" \"tsx watch --env-file=.env src/server.ts\"",
    "dev:docker": "concurrently \"npm run css:watch\" \"npm run frontend:watch\" \"tsx watch src/server.ts\"",
    "build": "npm run css:build && npm run frontend:build && tsc && tsc-alias && node scripts/add-js-extensions.mjs && node scripts/copy-static-assets.mjs",
    "start": "node dist/server.js",
    "css:build": "node scripts/build-css.mjs",
    "css:watch": "postcss public/css/tailwind.css -o public/css/output.css --watch",
    "frontend:build": "node scripts/build-frontend.mjs",
    "frontend:watch": "node scripts/build-frontend.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:db:start": "bash scripts/test-db.sh start",
    "test:db:stop": "bash scripts/test-db.sh stop",
    "test:db:reset": "bash scripts/test-db.sh reset",
    "test:db:clean": "bash scripts/test-db.sh clean",
    "test:integration": "npm run test:db:start && vitest run && npm run test:db:stop",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:browser": "docker compose -f docker-compose.e2e.yml up --build --abort-on-container-exit --exit-code-from e2e",
    "test:e2e:browser:down": "docker compose -f docker-compose.e2e.yml down -v",
    "verify": "bash scripts/verify-frontend.sh",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "changelog:first": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "node --experimental-strip-types prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "prepare": "[ -n \"$CI\" ] || husky || true"
  },
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "ejs",
    "task-management",
    "team-collaboration"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@alpinejs/csp": "^3.15.1",
    "@alpinejs/focus": "^3.15.1",
    "@alpinejs/intersect": "^3.15.1",
    "@alpinejs/persist": "^3.15.1",
    "@messageformat/core": "^3.4.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.51.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.54.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.54.2",
    "@opentelemetry/sdk-node": "^0.54.2",
    "@prisma/client": "^6.18.0",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/connect-flash": "^0.0.40",
    "@types/cookie-parser": "^1.4.9",
    "@types/express-session": "^1.18.2",
    "@types/pg": "^8.15.5",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "connect-flash": "^0.1.1",
    "connect-pg-simple": "^9.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.2.0",
    "express-session": "^1.18.2",
    "express-validator": "^7.3.0",
    "helmet": "^8.1.0",
    "htmx-ext-loading-states": "^2.0.2",
    "htmx.org": "^2.0.7",
    "i18n": "^0.15.2",
    "i18next": "^25.6.0",
    "i18next-fs-backend": "^2.6.0",
    "i18next-http-middleware": "^3.8.1",
    "intl-messageformat": "^10.7.18",
    "path": "^0.12.7",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.8.0",
    "uuid": "^13.0.0",
    "winston": "^3.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.14",
    "@tailwindcss/typography": "^0.5.19",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.5",
    "@types/express-ejs-layouts": "^2.5.4",
    "@types/i18n": "^0.13.12",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.10.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "conventional-changelog-cli": "^5.0.0",
    "daisyui": "^5.4.5",
    "esbuild": "^0.27.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "happy-dom": "^20.0.10",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^27.0.0",
    "lint-staged": "^15.2.10",
    "pino-pretty": "^11.3.0",
    "playwright": "^1.56.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "prettier": "^3.3.3",
    "prisma": "^6.18.0",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.18",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24.9.0",
    "npm": ">=10.0.0"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
